    "Normally glucose is colored red only when over or under your notification limits for high/low" : {
      "comment" : "UI/UX option",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عادة يكون الجلوكوز أحمر فقط عند تجاوز أو تحت حدود الإشعارات الخاصة بك مرتفع/منخفض"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Normalt er glukose kun farvet rødt, når over eller under din anmeldelse grænser for høj/lav"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Normalerweise ist die Glukose nur rot wenn sie über oder unter Ihren Benachrichtigungsgrenzen für hoch/niedrig ist"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Normally glucose is colored red only when over or under your notification limits for high/low"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Normalmente la glucosa es de color rojo sólo cuando está por encima o debajo de sus límites de notificación para alto/bajo"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Normalement, le glucose est coloré en rouge uniquement lorsque la limite de notification est supérieure ou inférieure à la limite de notification"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Normalmente il glucosio è colorato rosso solo quando sopra o sotto i limiti di notifica per alto/basso"
          }
        },
        "nb-NO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Normalt er glukose farget kun rødt når det er over eller under varslingsgrensene for høy/lav"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Normaal gesproken wordt glucose alleen rood gekleurd als je de notificatiegrens hebt overschreden voor hoog/laag"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zwykle glukoza jest kolorowana tylko wtedy, gdy przekracza lub poniżej limitu powiadomień dla wysokich/niskiego"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Normalmente a glicose é colorida somente quando terminar ou abaixo dos seus limites de notificação para alta/baixa"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Обычно глюкоза окрашивается в красный цвет только в том случае, если значение превышено или выходит за пределы ваших лимитов уведомлений о высоком / низком уровне"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Normally glucose is colored red only when over or under your notification limits for high/low"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Normalt färgas nuvarande blodsocker med rött endast ifall detta är under eller över dina inställningar för ett lågt eller högt blodsocker i dina notisinställningar"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Normally glucose is colored red only when over or under your notification limits for high/low"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Зазвичай рівень глюкози забарвлюється в червоний колір лише тоді, коли рівень сповіщень перевищує або перебуває нижче для високого/низького рівня"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thông thường glucose chỉ có màu đỏ khi vượt quá hoặc dưới giới hạn thông báo của bạn về mức cao"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通常只有在高/低时血糖才会有红色或低于您通知的极限时"
          }
        }
      }
    },
