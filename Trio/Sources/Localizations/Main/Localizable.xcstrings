            "value" : "Denna justerade ISF är tillfällig, och kommer att justeras med nästa loop-cykel, och bör inte användas direkt som ditt profil ISF-värde."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "This adjusted ISF is temporary, will change with the next loop cycle, and should not be directly used as your profile ISF value."
          }
        },
        "uk" : {
