    "This enables supermicrobolus (SMB) while carbs on board (COB) are positive." : {
      "comment" : "Enable SMB With COB\"",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "وهذا يمكّن الميكروبات الكبرى (SMB) في حين أن الكارتونات على متن السفينة هي عناصر إيجابية."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dette muliggør supermikrobolus (SMB), mens kulhydrater om bord (COB) er positive."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dies ermöglicht Supermicrobolus (SMB), während Kohlenhydrate an Bord (COB) positiv sind."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This enables supermicrobolus (SMB) while carbs on board (COB) are positive."
          }
        },
        "es" : {
