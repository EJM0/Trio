    "Set the color scheme for glucose readings on the main glucose graph, live activities, and bolus calculator. Descriptions for each option found below." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعيين مخطط الألوان لقراءات الجلوكوز على الرسم البياني الرئيسي، الأنشطة الحية، وحاسبة بولز. وصف لكل خيار يوجد أدناه."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indstil farvesammensætning for glucose aflæsninger på de vigtigste glukose graf, levende aktiviteter, og bolus regnemaskine. Beskrivelser for hver indstilling fundet nedenfor."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Legen Sie das Farbschema für Glukosemessungen auf dem Glukosegraphen fest, Live-Aktivitäten und bolusberechner. Beschreibungen für jede unten stehende Option."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Establezca el esquema de color para lecturas de glucosa en la gráfica principal de glucosa, actividades en vivo y calculadora de bolos. Descripciones para cada opción que se encuentra a continuación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Définissez le schéma de couleur pour les lectures de glucose sur le graphique principal, les activités en direct et la calculatrice de bolus. Descriptions pour chaque option trouvée ci-dessous."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impostare lo schema di colori per le letture di glucosio sul grafico principale del glucosio, le attività live e la calcolatrice del bolo."
          }
        },
        "nb-NO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Still inn fargeskjemaet for glukosemålinger i hovedfarge, live-aktiviteter og boluskalkulator. Beskrivelser for hvert alternativ som vises nedenfor."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stel het kleurenschema in voor de glucosewaardes op de hoofdgrafiek, live activiteiten en bolus calculator. Omschrijvingen voor elke optie hieronder."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ustaw schemat kolorów dla odczytów glukozy na głównym wykresie glukozy, aktywności na żywo i kalkulatorze bolusa. Opisy dla każdej opcji znajdującej się poniżej."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Defina o esquema de cores para leituras de glicose no gráfico principal de glicose, atividades ao vivo e calculadora de bolus. Descrições para cada opção encontrada abaixo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
