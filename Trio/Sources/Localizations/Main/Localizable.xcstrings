    "Autosens will begin learning sensitivity anew from the time of the rewind, which may take up to 6 hours." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيبدأ المحترفون في تعلم الحساسية من جديد منذ وقت إعادة الرياح، وهو ما قد يستغرق 6 ساعات."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autosens vil begynde at lære følsomhed på ny fra genvindingstidspunktet, hvilket kan tage op til 6 timer."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autosens beginnt die Sensibilität neu zu erlernen von der Zeit des Rückwindes, die bis zu 6 Stunden dauern kann."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los autosens comenzarán a aprender la sensibilidad desde el momento del revento, que puede tardar hasta 6 horas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’Autosens reprendra l’apprentissage de la sensibilité à partir du moment où le retour se produira, ce qui peut prendre jusqu’à 6 heures."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autosens inizierà nuovamente l'apprendimento della sensibilità dal momento del riavvolgimento, che può richiedere fino a 6 ore."
          }
        },
        "nb-NO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autosens vil begynne å beregne insulinsensitivitet på nytt etter omstart av pumpe, noe som kan ta opptil 6 timer."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autosens zullen opnieuw de gevoeligheid leren vanaf de terugspoeling, die tot 6 uur kan duren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autosens zacznie ponownie uczyć się od czasu wznoszenia, co może trwać do 6 godzin."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autosens começará de novo a aprender a sensibilidade a partir do tempo do vento, que pode levar até 6 horas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Автосмены начнут заново изучать чувствительность с момента перемотки, что может занять до 6 часов."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Autosens will begin learning sensitivity anew from the time of the rewind, which may take up to 6 hours."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autosens kommer att börja lära sig känslighet på nytt från tiden för vinden, vilket kan ta upp till 6 timmar."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Autosens will begin learning sensitivity anew from the time of the rewind, which may take up to 6 hours."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Авторани почнуть вивчати чутливість до навчання, з часу вітру, що може зайняти до 6 годин."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Autosens will begin learning sensitivity anew from the time of the rewind, which may take up to 6 hours."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自动学习将从回风开始重新开始学习，回风可能需要6个小时。"
          }
        }
      }
