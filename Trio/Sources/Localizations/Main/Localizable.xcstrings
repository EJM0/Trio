    "Maximum allowed positive percent change in glucose level to permit SMBs. If the difference in glucose is greater than this, Trio will disable SMBs." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الحد الأقصى المسموح به للتغيير الإيجابي في مستوى الجلوكوز للسماح لشركات SMBs. إذا كان الفرق في الجلوكوز أكبر من هذا، تريو سيقوم بتعطيل شركات SMBs."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maksimalt tilladt positiv procentvis ændring i glukoseniveau for at tillade SMB'er. Hvis forskellen i glukose er større end dette, Trio vil deaktivere SMB'er."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maximal erlaubte Änderung des Glukosespiegels, um KMU zu erlauben. Wenn der Unterschied bei Glukose größer ist, wird Trio KMU deaktivieren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Máximo de cambio positivo permitido en el nivel de glucosa para permitir SMBs. Si la diferencia en glucosa es mayor que ésta, Trio desactivará SMBs."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le pourcentage maximal autorisé de changement positif du taux de glucose pour permettre les SMB. Si la différence de glucose est supérieure à cela, Trio désactivera les SMB."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La percentuale massima consentita di variazione positiva del livello di glucosio per consentire SMB. Se la differenza di glucosio è maggiore, Trio disabiliterà gli SMB."
          }
        },
        "nb-NO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maksimalt tillatt positiv prosentendring i glukosenivået for å tillate SMB. Hvis forskjellen i glukose er større enn dette, vil Trio deaktivere SMBer."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maximaal toegestane positieve procent verandering in glucosewaarde om SMBs toe te staan. Als het verschil in glucose groter is dan dan, zal Trio SMB uitschakelen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maksymalna dozwolona dodatnia procentowa zmiana poziomu glukozy, aby umożliwić SMB. Jeśli różnica w glukozie jest większa niż ta, Trio wyłączy SMB."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Máximo permitido porcentagem positiva de alteração no nível de glicose para permitir SMBs. Se a diferença na glicose for maior do que isso, Trio desativará SMBs."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Максимально допустимое положительное изменение уровня глюкозы для разрешения СМБ. Если разница в глюкозе больше, чем это, трио отключит СМБ."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Maximum allowed positive percent change in glucose level to permit SMBs. If the difference in glucose is greater than this, Trio will disable SMBs."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maximalt tillåten positiv procentuell förändring av glukosnivån för att tillåta SMB. Om skillnaden i glukos är större än så kommer Trio att inaktivera SMB:er."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Maximum allowed positive percent change in glucose level to permit SMBs. If the difference in glucose is greater than this, Trio will disable SMBs."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Максимально допустима відсоткова зміна рівня глюкози дозволяє SMB. Якщо різниця у глюкозі більша, ніж ця, то трійка відключить SMB."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Maximum allowed positive percent change in glucose level to permit SMBs. If the difference in glucose is greater than this, Trio will disable SMBs."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "允许血糖水平最大允许的增量百分比变化允许SMB。如果血糖的差异大于此值，Trio将禁用血糖。"
          }
        }
      }
    },
