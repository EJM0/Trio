    "This limits the automatic adjustment of the temporary basal rate to this percentage of the current hourly profile basal rate at the time of the loop cycle." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ويحد هذا من التسوية التلقائية للمعدل الأساسي المؤقت إلى هذه النسبة المئوية من المعدل الأساسي الحالي للساعة في وقت دورة الدورات."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dette begrænser den automatiske justering af den midlertidige basale sats til denne procentdel af den aktuelle timeprofil basal rate på tidspunktet for loop cyklus."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dies beschränkt die automatische Anpassung der temporären Basisrate auf diesen Prozentsatz der aktuellen Stundenprofil-Basalrate zum Zeitpunkt des Loop-Zyklus."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto limita el ajuste automático de la tasa basal temporal a este porcentaje de la tasa basal del perfil por hora actual en el momento del ciclo del ciclo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cela limite l'ajustement automatique du débit basal temporaire à ce pourcentage du taux de basal du profil horaire actuel au moment du cycle de boucle."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo limita l'adeguamento automatico del tasso basale temporaneo a questa percentuale del tasso basale del profilo orario corrente al momento del ciclo del ciclo."
          }
        },
        "nb-NO" : {
          "stringUnit" : {
            "state" : "translated",
