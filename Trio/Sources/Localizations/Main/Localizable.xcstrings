        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trio umożliwia tworzenie automatyzacji przy użyciu skrótów iOS. Przejdź do aplikacji Skróty, aby tworzyć nowe automatyzacje."
