        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "По умолчанию значение false. При значении true, временная цель > 105 мг/дл регулирует sensitivityRatio для exercise_mode. Синноним для high_temptarget_raises_sensitivity"
          }
        },
        "sk" : {
          "stringUnit" : {
