        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Використовує IOB, COB, UAM і ZT рядки з OpenAPS. Ця опція надає більш детальний вигляд прогнозу алгоритму, але може бути більш заплутаним для деяких користувачів."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "new",
