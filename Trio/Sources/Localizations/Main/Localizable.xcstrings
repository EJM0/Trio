    },
    "If you attempt to request a bolus larger than this, the bolus will not be accepted." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "If you attempt to request a bolus larger than this, the bolus will not be accepted."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvis du forsøger at anmode om en bolus større end dette, vil bolus ikke blive accepteret."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn Sie versuchen, einen Bolus größer als diese anzufordern, wird der Bolus nicht akzeptiert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si usted intenta solicitar un bolo más grande que esto, el bolo no será aceptado."
