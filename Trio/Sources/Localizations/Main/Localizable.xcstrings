          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Om du har en \"Rekommenderad bolusprocent\" på 80%, och en \"Fet måltid bolusprocent\" på 70%, Din rekommenderade bolus kommer att multipliceras med: (80 × 70) <unk> 100 = 56%."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "new",
