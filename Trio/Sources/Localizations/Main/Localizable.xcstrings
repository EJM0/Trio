    "Running Trio in closed loop mode requires an active CGM sensor session and a connected pump. This enables automated insulin delivery." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تشغيل ثلاثي في وضع الحلقة المغلقة يتطلب دورة استشعار CGM نشطة ومضخات متصلة. وهذا يمكّن من إيصال الأنسولين آليا."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Running Trio i lukket loop mode kræver en aktiv CGM sensor session og en tilsluttet pumpe. Dette muliggør automatisk insulinlevering."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Trio läuft im geschlossenen Schleifenmodus erfordert eine aktive CGM-Sensor-Session und eine angeschlossene Pumpe. Dies ermöglicht eine automatisierte Insulinlieferung."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El funcionamiento de Trio en modo de ciclo cerrado requiere una sesión activa del sensor CGM y una bomba conectada. Esto permite la entrega automática de insulina."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exécuter Trio en mode boucle fermée nécessite une session active de capteur MGC et une pompe connectée. Cela permet une livraison automatique d'insuline."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'esecuzione del Trio in modalità loop chiuso richiede una sessione attiva di sensori CGM e una pompa collegata. Ciò consente la somministrazione automatica di insulina."
          }
        },
        "nb-NO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kjører Trio i lukket sløyfe modus krever en aktiv CGM-sensor økt og en pumpe koblet til. Dette muliggjør automatisert insulintilførsel."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trio uitvoeren in closed loop modus vereist een actieve CGM sensor sessie en een aangesloten pomp. Dit activeert automatische insuline levering."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uruchamianie trio w trybie zamkniętej pętli wymaga aktywnej sesji czujnika CGM i podłączonej pompy. Umożliwia to automatyczne dostarczanie insuliny."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Executar Trio em modo de loop fechado requer uma sessão de sensor CGM ativa e uma bomba conectada. Isso permite a entrega de insulina automatizada."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Запуск трио в замкнутом режиме требует активного сенсора CGM и подключенного насоса. Это позволяет автоматизировать передачу инсулина."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Running Trio in closed loop mode requires an active CGM sensor session and a connected pump. This enables automated insulin delivery."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Att köra Trio i sluten loop-läge kräver en aktiv CGM-sensor och en ansluten pump. Detta möjliggör automatisk leverans av insulin."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Running Trio in closed loop mode requires an active CGM sensor session and a connected pump. This enables automated insulin delivery."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Запуск Trio в закритому режимі циклу вимагає активної сесії CGM датчика та під'єднаного насосу. Це вмикає автоматизовану доставку інсуліну."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Running Trio in closed loop mode requires an active CGM sensor session and a connected pump. This enables automated insulin delivery."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在封闭循环模式下运行三角龙需要一个活跃的 CGM 传感器会话和连接的泵。这使得自动绝缘投射能够进行。"
          }
        }
      }
    },
