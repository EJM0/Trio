    "Swipe left to delete a single entry. Tap on it, to edit its time or rate." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اسحب لليسار لحذف إدخال واحد. اضغط عليه، لتحرير وقته أو معدله."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stryg til venstre for at slette en enkelt post. Tryk på den, for at redigere dens tid eller hastighed."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wischen Sie nach links, um einen einzelnen Eintrag zu löschen. Tippen Sie darauf, um seine Zeit oder Rate zu bearbeiten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deslice a la izquierda para eliminar una sola entrada. Pulse en ella, para editar su tiempo o calificación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Glissez vers la gauche pour supprimer une seule entrée. Appuyez dessus, pour modifier son temps ou son taux."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scorri verso sinistra per eliminare una singola voce. Toccarla, per modificarne il tempo o la velocità."
          }
        },
        "nb-NO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sveip til venstre for å slette et enkelt element. Trykk på det for å redigere tid eller rate."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veeg naar links om een enkele invoer te verwijderen. Tik erop om de tijd of koers te wijzigen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przesuń palcem w lewo, aby usunąć pojedynczy wpis. Dotknij go, aby edytować jego czas lub cenę."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deslize para a esquerda para excluir uma única entrada. Toque nela, para editar seu tempo ou tarifa."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Проведите влево, чтобы удалить одну запись. Нажмите на нее, чтобы изменить время или скорость."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Swipe left to delete a single entry. Tap on it, to edit its time or rate."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Svep åt vänster för att ta bort en enda post. Tryck på den för att redigera dess tid eller hastighet."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Swipe left to delete a single entry. Tap on it, to edit its time or rate."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Проведіть пальцем ліворуч, щоб видалити один запис. Натисніть на нього, щоб змінити його час чи частоту."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Swipe left to delete a single entry. Tap on it, to edit its time or rate."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "向左滑动以删除一个条目。点击它来编辑它的时间或速率。"
