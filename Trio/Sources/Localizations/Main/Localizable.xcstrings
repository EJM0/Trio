    "Battery is running low %@, consider charging your %@ device as soon as possible" : {
      "comment" : "Battery is running low %@, consider charging your %@ device as soon as possible",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "البطارية قيد التشغيل منخفض %@، فكر في شحن جهازك %@ في أقرب وقت ممكن"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lavt batteriniveau %@, lad venligst din %@ enhed snarest muligt"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Batteriestand ist niedrig %@, lade dein %@ Gerät so schnell wie möglich auf"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Battery is running low %@, consider charging your %@ device as soon as possible"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La batería está funcionando baja %@, considera cargar tu dispositivo %@ lo antes posible"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La batterie est faible %@, pensez à charger votre appareil %@ dès que possible"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Batteria scarsa %@, considera di caricare il tuo dispositivo %@ il prima possibile"
          }
        },
        "nb-NO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Batterinivået er lavt %@, vurder å lade %@ enheten din så snart som mulig"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Batterijniveau is laag %@, laad je %@ apparaat zo snel mogelijk op"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bateria jest uruchomiona %@, rozważ naładowanie swojego urządzenia %@ tak szybko jak to możliwe"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A bateria está acabando com %@, considere carregar o seu dispositivo %@ o mais rápido possível"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Батарея работает на низком уровне %@, попробуйте зарядить устройство %@ как можно скорее"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Batéria sa vybíja %@, zvážte čo najskoršie nabitie zariadenia %@"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Batterinivå är låg %@, överväg att ladda din %@ enhet så snart som möjligt"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Battery is running low %@, consider charging your %@ device as soon as possible"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Рівень заряду батареї низький %@, зарядіть ваш %@ пристрій найшвидше"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pin sắp hết %@, hãy cân nhắc việc sạc thiết bị %@ của bạn càng sớm càng tốt"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
