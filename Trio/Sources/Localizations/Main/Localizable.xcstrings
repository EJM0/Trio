          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isto pode ser um problema intermitente, mas verifique se seu transmissor está firmemente protegido sobre seu sensor"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
