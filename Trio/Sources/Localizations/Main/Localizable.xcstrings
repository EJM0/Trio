    "Target Glucose covered for 24 hours. You cannot add more rates. Please remove or adjust existing rates to make space." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تم تغطية جلوكوز الهدف لمدة 24 ساعة. لا يمكنك إضافة المزيد من الأسعار. يرجى إزالة أو ضبط الأسعار الحالية لجعل المساحة."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mål glukose dækket i 24 timer. Du kan ikke tilføje flere satser. Fjern eller juster de eksisterende satser, for at gøre plads."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ziel Glucose für 24 Stunden bedeckt. Sie können nicht mehr Raten hinzufügen. Bitte entfernen Sie oder passen Sie die vorhandenen Raten an, um Platz zu schaffen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Glucosa objetivo cubierta durante 24 horas. No puede añadir más tasas. Por favor, elimine o ajuste las tarifas existentes para hacer espacio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cible Glycémie couverte pendant 24 heures. Vous ne pouvez pas ajouter plus de taux. Veuillez supprimer ou ajuster les taux existants pour faire de l'espace."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Glucosio obiettivo coperto per 24 ore. Non è possibile aggiungere più tasse. Si prega di rimuovere o modificare le tariffe esistenti per fare spazio."
          }
        },
        "nb-NO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Målet glukose dekket i 24 timer. Du kan ikke legge til flere priser. Vennligst fjern eller juster eksisterende priser for å lage plass."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Doel glucose gedekt voor 24 uur. U kunt niet meer tarieven toevoegen. Verwijder of pas bestaande tarieven aan om ruimte te maken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Docelowa glikemia pokryta przez 24 godziny. Nie można dodać więcej stawek. Proszę usunąć lub dostosować istniejące stawki, aby zrobić miejsce."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Glicémia alvo coberta por 24 horas. Você não pode adicionar mais taxas. Por favor, remova ou ajuste as taxas existentes para liberar espaço."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Целевая глюкоза, покрытая 24 часа. Вы не можете добавить больше тарифов. Пожалуйста, удалите или измените существующие тарифы, чтобы освободить место."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Target Glucose covered for 24 hours. You cannot add more rates. Please remove or adjust existing rates to make space."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Målglukos täcks i 24 timmar. Du kan inte lägga till fler priser. Ta bort eller justera befintliga priser för att göra utrymme."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Target Glucose covered for 24 hours. You cannot add more rates. Please remove or adjust existing rates to make space."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Цільовий глюкоз вкритий протягом 24 годин. Ви не можете додати більше ставок. Будь ласка, видаліть або налаштуйте існуючі ставки, щоб створити місце."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Target Glucose covered for 24 hours. You cannot add more rates. Please remove or adjust existing rates to make space."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "目标Glucose 覆盖了24小时。您不能添加更多的费率。请删除或调整现有费率以腾出空间。"
          }
        }
      }
    },
