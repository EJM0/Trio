    "Note: This setting is only utilized if the settings \"Low Temp Target Lowers Sensitivity\" OR \"High Temp Target Raises Sensitivity\" are enabled." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Note: This setting is only utilized if the settings \"Low Temp Target Lowers Sensitivity\" OR \"High Temp Target Raises Sensitivity\" are enabled."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bemærk: Denne indstilling bruges kun, hvis indstillingerne \"Lav Temp Mål Sænker Følsomhed\" ELLER \"Høj Temp Mål Hæver Følsomhed\" er aktiveret."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hinweis: This setting is only utilized if the settings \"Low Temp Target Swers Sensitivity\" OR \"High Temp Target Raises Sensitivity\" are enabled."
