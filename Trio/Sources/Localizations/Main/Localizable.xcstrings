          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "2. Bläddra ner eller skriv \"Hälsa\" i inställningarnas sökfält och välj \"Hälsa\" appen."
          }
        },
        "tr" : {
          "stringUnit" : {
