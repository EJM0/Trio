    "Dynamically adjust insulin sensitivity using Dynamic Ratio rather than Autosens Ratio." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Dynamically adjust insulin sensitivity using Dynamic Ratio rather than Autosens Ratio."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Justér insulinfølsomheden dynamisk ved hjælp af Dynamisk Ratio frem for Autosens Ratio."
