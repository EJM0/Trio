    "Max IOB" : {
      "comment" : "Max IOB",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Max IOB"
          }
        },
        "da" : {
          "stringUnit" : {
