        }
      }
    },
    "If you have a \"Recommended Bolus Percentage\" of 80%, and a \"Fatty Meal Bolus Percentage\" of 70%, your recommended bolus will be multiplied by: (80 × 70) ÷ 100 = 56%." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "If you have a \"Recommended Bolus Percentage\" of 80%, and a \"Fatty Meal Bolus Percentage\" of 70%, your recommended bolus will be multiplied by: (80 × 70) ÷ 100 = 56%."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvis du har en \"Anbefalet Bolus procent\" på 80%, og en \"Fedt Måltid Bolus procent\" på 70%, din anbefalede bolus vil blive ganget med: (80 × 70) - 100 = 56%."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn du einen \"Empfohlenen Bolus Prozent\" von 80 % und einen \"Fatty Meal Bolus Prozent\" von 70 % hast, Ihr empfohlener Bolus wird multipliziert von: (80 × 70) <unk> 100 = 56%."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si tiene un \"Porcentaje de Bolo Recomendado\" del 80%, y un \"Porcentaje de Bolo de Comida Grasa\" del 70%, su bolo recomendado será multiplicado por: (80 × 70) ► 100 = 56%."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si vous avez un \"Pourcentage de Bolus Recommandé\" de 80%, et un \"Pourcentage de Bolus Repas\" de 70%, votre bolus recommandé sera multiplié par: (80 × 70) ÷ 100 = 56%."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "If you have a \"Recommended Bolus Percentage\" of 80%, and a \"Fatty Meal Bolus Percentage\" of 70%, your recommended bolus will be multiplied by: (80 × 70) ÷ 100 = 56%."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se hai una \"percentuale di bolo consigliata\" dell'80%, e una \"percentuale di bolo di pasto grasso\" del 70%, il bolo consigliato sarà moltiplicato per (80 × 70) ÷ 100 = 56%."
          }
        },
        "nb-NO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvis du har en \"anbefalt bolus-prosent\" på 80 % og et \"Fatty Meal Bolus Case på 70 %, din anbefalte bolusdose multipliseres med: (80 × 70) ÷ 100 = 56 %."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als je een \"Aanbevolen Bolus Percentage\" van 80 procent hebt en een \"Fatty Meal Bolus Percentage\" van 70%, je aanbevolen bolus wordt vermenigvuldigd met: (80 x 70) ~100 = 56%."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeśli masz \"Procent zalecanego bolusa\" 80%, a \"Procent bolusa tłuszczowego\" 70%, zalecany bolus zostanie pomnożony przez (80 × 70) ~100 = 56%."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se você tem uma \"porcentagem de Bolus Recomendado\" de 80%, e uma \"porcentagem de Bolus Fatty refeição\" de 70%, o bólus recomendado será multiplicado por: (80 × 70), 100 = 56%."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Om du har en \"Rekommenderad bolusprocent\" på 80%, och en \"Fet måltid bolusprocent\" på 70%, kommer din rekommenderade bolus att multipliceras enligt: (80 × 70) ÷ 100 = 56%."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "If you have a \"Recommended Bolus Percentage\" of 80%, and a \"Fatty Meal Bolus Percentage\" of 70%, your recommended bolus will be multiplied by: (80 × 70) ÷ 100 = 56%."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Якщо ви маєте \"Рекомендований відсоток Болуса\" у 80%, і \"Жирний Мел Болс\" від 70%, ваш рекомендований bolus буде множений: (80 × 70) ÷ 100 = 56%."
          }
        },
