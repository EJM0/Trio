            "value" : "Это ограничивает автоматическую настройку временной базисной скорости до этого процента от текущей базисной скорости почасового профиля на момент цикла цикла."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "This limits the automatic adjustment of the temporary basal rate to this percentage of the current hourly profile basal rate at the time of the loop cycle."
          }
        },
