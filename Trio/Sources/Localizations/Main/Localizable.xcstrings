          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deaktivieren dieser Einstellung erlaubt immer noch andere Befehle, wie Temp-Ziele, Carbs hinzufügen und Start/End-Überschreibungen"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deshabilitar esta opción permitirá otros comandos, como Objetivos Temporales, Añadir Carbohidratos y Soberanos de Inicio / Final"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Désactiver ce paramètre permettra toujours d'autres commandes, comme les cibles temporaires, l'ajout de glucides et les remplacements de démarrage/fin"
