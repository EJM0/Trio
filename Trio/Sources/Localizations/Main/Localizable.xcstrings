    "When using the Sigmoid Formula, the weighted Total Daily Dose has a much lower impact on the dynamic adjustments to sensitivity." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "وعند استخدام صيغة سيغمود، يكون لمجموع الجرعة اليومية المرجحة تأثير أقل بكثير على التعديلات الديناميكية في الحساسية."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ved brug af Sigmoid Formel har den vægtede totale daglige dosis en meget lavere indvirkning på de dynamiske justeringer af følsomheden."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bei der Sigmoid-Formel hat der gewichtete Total Daily Dose einen viel geringeren Einfluss auf die dynamischen Anpassungen der Empfindlichkeit."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al usar la Fórmula Sigmoide, la Dosis Diaria Total ponderada tiene un impacto mucho menor en los ajustes dinámicos a la sensibilidad."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En utilisant la formule Sigmoïde, la dose quotidienne pondérée a un impact beaucoup plus faible sur les ajustements dynamiques à la sensibilité."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando si utilizza la formula Sigmoid, la dose giornaliera totale ponderata ha un impatto molto inferiore sugli aggiustamenti dinamici della sensibilità."
          }
        },
        "nb-NO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når signmoid formulering benyttes har den veide totale daglige dosen en mye lavere virkning på de dynamiske justeringene i følsomheten."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bij gebruik van de Sigmoid Formule heeft de gewogen Totale Dagelijkse Dose een veel lagere impact op de dynamische aanpassingen van de gevoeligheid."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "W przypadku stosowania wzoru na Sigmoid ważona całkowita dawka dobowa ma znacznie mniejszy wpływ na dynamiczne dostosowanie wrażliwości."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ao usar a Fórmula de Sigmoid, a Dose Total Diária ponderada tem um impacto muito menor nos ajustes dinâmicos à sensibilidade."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "При использовании формулы Sigmoid общая взвешенная ежедневная доза оказывает значительно меньшее влияние на динамические настройки чувствительности."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "When using the Sigmoid Formula, the weighted Total Daily Dose has a much lower impact on the dynamic adjustments to sensitivity."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "När du använder Sigmoid formeln, har den viktade dagliga doften en mycket lägre inverkan på de dynamiska justeringar av känslighet."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "When using the Sigmoid Formula, the weighted Total Daily Dose has a much lower impact on the dynamic adjustments to sensitivity."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "При використанні формули сигмоїди, зважена Загальна доза має значно менший вплив на динамічні корективи до чутливості."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "When using the Sigmoid Formula, the weighted Total Daily Dose has a much lower impact on the dynamic adjustments to sensitivity."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用Sigmoid 公式时，加权总每日总消耗量对敏感性动态调整的影响要小得多。"
          }
        }
      }
    },
