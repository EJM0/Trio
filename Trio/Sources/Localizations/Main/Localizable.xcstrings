    "Enabling this feature causes Trio to automatically raise the targeted glucose if it detects an increase in insulin sensitivity from your baseline." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Enabling this feature causes Trio to automatically raise the targeted glucose if it detects an increase in insulin sensitivity from your baseline."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktivering af denne funktion får Trio til automatisk at øge den målrettede glukose, hvis den registrerer en øget insulinfølsomhed fra din baseline."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktivieren dieser Funktion bewirkt, dass Trio automatisch die gezielte Glukose erhöht, wenn es eine erhöhte Insulinempfindlichkeit von deiner Grundlinie feststellt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activar esta función hace que Trio aumente automáticamente la glucosa objetivo si detecta un aumento de la sensibilidad de insulina de su línea base."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'activation de cette fonctionnalité permet à Trio d'augmenter automatiquement le glucose ciblé s'il détecte une augmentation de la sensibilité à l'insuline de votre ligne de base."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Enabling this feature causes Trio to automatically raise the targeted glucose if it detects an increase in insulin sensitivity from your baseline."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abilitando questa funzionalità, Trio aumenta automaticamente il glucosio mirato se rileva un aumento della sensibilità all’insulina dal basale."
          }
        },
        "nb-NO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktivering av denne funksjonen fører til at Trio automatisk øker blodsukkermål hvis det oppdages en økning i insulinsensitivitet fra normalen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inschakelen van deze functie zorgt ervoor dat Trio de gewenste glucose automatisch verhoogt als het een toename van insulinegevoeligheid van je basislijn detecteert."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Włączenie tej funkcji powoduje, że Trio automatycznie podnosi docelową glukozę, jeśli wykryje wzrost wrażliwości na insulinę w stosunku do wartości wyjściowych."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ativar este recurso faz com que Trio aumente automaticamente a glicose direcionada se detectar um aumento na sensibilidade de insulina da sua base."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Att aktivera denna funktion gör att Trio automatiskt höjer glukos-målvärdet om den upptäcker en ökad insulinkänsligheten."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Enabling this feature causes Trio to automatically raise the targeted glucose if it detects an increase in insulin sensitivity from your baseline."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Увімкнення цієї функції викликає «Тріо» автоматично піднімати цільову глюкозу, якщо виявляє підвищення чутливості інсуліну з вашого базового рівня."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Enabling this feature causes Trio to automatically raise the targeted glucose if it detects an increase in insulin sensitivity from your baseline."
          }
