    "Tip: It is better to use a Custom Peak Time than to adjust Duration of Insulin Action (DIA)." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نصيحة: من الأفضل استخدام وقت الذروة المخصص بدلاً من تعديل مدة عمل الإنسولين (DIA)."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tip: Det er bedre at bruge en brugerdefineret spidstid end at justere varigheden af insulin handling (DIA)."
