    "Loop will not automatically adjust your insulin delivery until the temporary basal rate finishes or is canceled." : {
      "comment" : "Description text on manual temp basal action sheet",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حلقة لن تضبط تلقائياً تسليم الأنسولين الخاص بك حتى ينتهي المعدل الأساسي المؤقت أو يتم إلغاؤه."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Loop vil ikke automatisk justere din insulinlevering, før den midlertidige basal sats er færdig eller er annulleret."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Loop passt deine Insulinabgabe nicht automatisch an, bis die temporäre Basalrate beendet oder abgebrochen wird."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Loop will not automatically adjust your insulin delivery until the temporary basal rate finishes or is canceled."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bucle no ajustará automáticamente su entrega insulina hasta que la tasa basal temporal termine o sea cancelada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La boucle n'ajuste pas automatiquement la distribution d'insuline tant que le débit de basal temporaire n'est pas terminé ou est annulé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Loop non regolerà automaticamente l'erogazione d'insulina fino a quando l'impostazione della basale temporanea non sarà terminata o cancellata."
          }
        },
        "nb-NO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appen vil ikke automatisk justere insulintilførselen før den manuelle basalraten er fullført eller kansellert."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trio zal niet automatisch veranderingen aanbrengen in de hoeveelheid insuline die je krijgt, totdat de tijdelijke basaalstand is gestopt of geannuleerd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pętla nie dostosuje automatycznie dawki insuliny, dopóki tymczasowa dawka bazowa nie skończy się lub nie zostanie anulowana."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O loop não ajustará automaticamente sua entrega de insulina até que a taxa temporária de basal termine ou seja cancelada."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Петля не будет автоматически изменять подачу инсулина, пока Временная Базальная Скорость не завершится, либо не будет отменена пользователем."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trio vám automaticky neupraví dávkovanie inzulínu, kým sa dočasná bazálna rýchlosť neskončí alebo nezruší."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trio kommer inte automatiskt att justera dina insulindoser förrän den temporära basalen är färdig eller har avbrytits."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Loop will not automatically adjust your insulin delivery until the temporary basal rate finishes or is canceled."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Петля не автоматично змінюватиме подачу інсуліну, поки Тимчасова Базальна Швидкість не завершиться, або не буде скасована користувачем."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Loop sẽ không tự động điều chỉnh liều insulin đến khi liều nền tạm thời thực hiện xong hoặc bị hủy bỏ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "循环不会自动调整您的绝缘送货，直到临时基本速率结束或取消。"
          }
        }
      }
    },
    "looping" : {
      "comment" : "Looping in progress",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "دوران"
          }
        },
