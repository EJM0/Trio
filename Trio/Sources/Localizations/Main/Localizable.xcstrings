    "This is useful if you use CarPlay or a variety of other external services that limit the view of most apps, but allow the calendar app." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "This is useful if you use CarPlay or a variety of other external services that limit the view of most apps, but allow the calendar app."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dette er nyttigt, hvis du bruger CarPlay eller en række andre eksterne tjenester, der begrænser visningen af de fleste apps, men tillad kalenderappen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dies ist nützlich, wenn Sie CarPlay oder eine Reihe anderer externer Dienste verwenden, die die Ansicht der meisten Apps einschränken, aber erlauben Sie die Kalender-App."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto es útil si utiliza CarPlay o una variedad de otros servicios externos que limitan la vista de la mayoría de las aplicaciones, pero permitir la aplicación de calendario."
          }
        },
        "fr" : {
          "stringUnit" : {
