    "Sensor might have temporarily stopped, fallen off or is too cold or too warm" : {
      "comment" : "ensor might have temporarily stopped, fallen off or is too cold or too warm",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قد يكون المستشعر قد توقف مؤقتا، أو سقط أو كان بارد جدا أو دافئا جدا"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sensoren er muligvis midlertidigt stoppet, faldet af eller er for kold eller for varm"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Möglicherweise ist der Sensor vorübergehend gestoppt, hat sich gelöst, ist zu kalt oder zu warm"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sensor might have temporarily stopped, fallen off or is too cold or too warm"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El sensor podría haberse detenido temporalmente, caído o es demasiado frío o demasiado caliente"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le capteur peut avoir été temporairement arrêté, tombé ou trop froid ou trop chaud"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il sensore potrebbe essersi interrotto temporaneamente, caduto o troppo freddo o troppo caldo"
          }
        },
        "nb-NO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sensoren kan ha stoppet midlertidig, falt av eller er for kald eller for varm"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mogelijk is de sensor tijdelijk gestopt, losgeraakt of te koud of te warm"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Czujnik mógł tymczasowo zatrzymać, odpaść lub być zbyt zimny lub zbyt ciepły"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sensor pode ter parado temporariamente, caído ou está muito frio ou quente"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сенсор временно остановлен, отсоединён или температура за рамками допустимой"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Senzor sa mohol dočasne zastaviť, spadnúť, alebo je príliš studený alebo príliš teplý"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sensorn kan tillfälligt ha stoppats, fallit av eller är för kall eller för varm"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Sensor might have temporarily stopped, fallen off or is too cold or too warm"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сенсор може бути тимчасово зупинений, падіння або занадто холодно або тепло."
          }
        },
        "vi" : {
          "stringUnit" : {
