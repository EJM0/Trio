          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sensoren er muligvis midlertidigt stoppet, faldet af eller er for kold eller for varm"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Möglicherweise ist der Sensor vorübergehend gestoppt, hat sich gelöst, ist zu kalt oder zu warm"
