    "Decreasing this setting may result in fewer FPU entries with larger carb values." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "وقد يؤدي تخفيض هذا الإعداد إلى انخفاض عدد المدخلات من وحدات البترول ذات قيم كربونية أكبر."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reduktion af denne indstilling kan resultere i færre FPU poster med større carb værdier."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Verringerung dieser Einstellung kann zu weniger FPU-Einträgen mit größeren Karbon-Werten führen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disminuir este ajuste puede resultar en menos entradas de FPU con valores de glúcido más grandes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diminuer ce paramètre peut entraîner moins d'entrées FPU avec de plus grandes valeurs de glucides."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diminuendo questa impostazione si possono ottenere meno FPU con valori di carb più grandi."
          }
        },
        "nb-NO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Å redusere denne innstillingen kan resultere i færre FPU enheter med større verdier for karbohydrat."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vermindering van deze instelling kan resulteren in minder FPU ingangen met grotere koolhydratenwaarden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zmniejszenie tego ustawienia może skutkować mniejszą liczbą wpisów FPU z większymi wartościami węglowodanów."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diminuir esta configuração pode resultar em menos entradas FPU com valores de carb maiores."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Уменьшение этой настройки может привести к меньшему количеству FPU записей с большими значениями карбов."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Decreasing this setting may result in fewer FPU entries with larger carb values."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minskning av denna inställning kan resultera i färre FPU-poster med större kolhydratvärden."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Decreasing this setting may result in fewer FPU entries with larger carb values."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Зменшення цього параметра може призвести до зниження FPU записів з більшими значеннями для carb."
          }
