    "Insulin Peak Time defines when insulin is most effective in lowering glucose, set in minutes after dosing." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحدد وقت ذروة الإنسولين متى يكون الأنسولين أكثر فعالية في خفض الجلوكوز، المحدد بدقائق بعد الجرعة."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Insulins spidstidspunkt definerer, hvornår insulin er mest effektivt til at sænke glukosen, indstillet på få minutter efter indgift."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Insulin Peak Time legt fest, wann Insulin am effektivsten bei der Senkung der Glukose ist, die in Minuten nach der Dosierung eingestellt wurde."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El tiempo pico de la insulina define cuando la insulina es más eficaz en la reducción de la glucosa, fijada en minutos después de la dosis."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le temps maximal d'insuline définit quand l'insuline est la plus efficace dans la réduction du glucose, définie en quelques minutes après le dosage."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tempo di picco dell'insulina definisce quando l'insulina è più efficace nell'abbassare il glucosio, impostato in minuti dopo la somministrazione."
          }
        },
        "nb-NO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Insulin Peak tid definerer når insulin er mest effektivt når insulinet senker glukose, satt i minutter etter dosering."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Insulin Peak Time bepaalt wanneer insuline het meest effectief is om glucose te verlagen, ingesteld in minuten na dosing."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Insulina szczytowy czas określa, kiedy insulina jest najbardziej skuteczna w zmniejszaniu stężenia glukozy, ustawiona w kilka minut po podaniu."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Tempo Pico da Insulina define quando a insulina é mais eficaz na redução de glicose, definida em minutos após a dosagem."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Время пика инсулин определяет, когда инсулин наиболее эффективен в снижении глюкозы, устанавливается в минутах после дозирования."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Insulin Peak Time defines when insulin is most effective in lowering glucose, set in minutes after dosing."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Insulin Peak Time definierar när insulin är mest effektivt för att sänka glukos, som sätts i minuter efter dosering."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Insulin Peak Time defines when insulin is most effective in lowering glucose, set in minutes after dosing."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Інсуліновий пік визначає, коли інсулін є найбільш ефективним у зниженні глюкози, тобто через кілька хвилин після дозу."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Insulin Peak Time defines when insulin is most effective in lowering glucose, set in minutes after dosing."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "硫磷峰时间定义了绝缘在降低葡萄糖方面最有效的时间，在剂量后以分钟为单位。"
          }
        }
      }
    },
