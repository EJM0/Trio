    "These two settings determine the range outside of which you will be notified via push notifications." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحدد هذان الإعدادان النطاق الذي سيتم إعلامك عنه عن طريق دفع الإشعارات."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disse to indstillinger afgør området udenfor hvilket du vil blive underrettet via push-notifikationer."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese beiden Einstellungen bestimmen den Bereich, außerhalb dessen Sie über Push-Benachrichtigungen benachrichtigt werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estos dos ajustes determinan el rango fuera del cual se te notificará a través de notificaciones push."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ces deux paramètres déterminent la plage en dehors de laquelle vous serez notifié via les notifications push."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Queste due impostazioni determinano l'intervallo al di fuori del quale verrai avvisato tramite notifiche push."
          }
        },
        "nb-NO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disse to innstillingene bestemmer området utenfor som du vil bli varslet via push-varsler."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze twee instellingen bepalen het bereik buiten waarvan u een melding krijgt via push-meldingen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Te dwa ustawienia określają zakres, poza którym będziesz powiadamiany za pomocą powiadomień push."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estas duas configurações determinam o intervalo fora do qual você será notificado através de notificações push."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
