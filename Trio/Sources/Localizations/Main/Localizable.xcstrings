          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Detta gör att Trio kan läsa från och skriva till Apple Hälsa."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "This allows Trio to read from and write to Apple Health."
          }
        },
        "uk" : {
          "stringUnit" : {
