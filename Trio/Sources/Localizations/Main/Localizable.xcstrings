    "Carb Ratios cover 24 hours. You cannot add more rates. Please remove or adjust existing rates to make space." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نسبة كارب تغطي 24 ساعة. لا يمكنك إضافة المزيد من الأسعار. يرجى إزالة أو تعديل الأسعار الحالية لجعل المساحة."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Carb Ratios dækker 24 timer. Du kan ikke tilføje flere priser. Fjern eller juster eksisterende priser for at gøre plads."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Carb Ratios decken 24 Stunden ab. Sie können nicht mehr Tarife hinzufügen. Bitte entferne oder ändere die bestehenden Tarife, um Platz zu schaffen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los índices de carbohidratos cubren 24 horas. No puedes añadir más tarifas. Por favor, elimina o ajusta las tarifas existentes para hacer espacio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les taux de glucides couvrent 24 heures. Vous ne pouvez pas ajouter plus de taux. Veuillez supprimer ou ajuster les taux existants pour faire de l'espace."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I rapporti Carb coprono 24 ore. Non è possibile aggiungere più tasse. Si prega di rimuovere o modificare le tariffe esistenti per fare spazio."
          }
        },
        "nb-NO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Karbo Ratios dekker 24 timer. Du kan ikke legge til flere priser. Vennligst fjern eller juster eksisterende priser for å lage plass."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koolhydraten verhoudingen beslaan 24 uur. U kunt niet meer tarieven toevoegen. Verwijder of pas bestaande tarieven aan om ruimte te maken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Współczynniki węglowodanów obejmują 24 godziny. Nie można dodać więcej stawek. Proszę usunąć lub dostosować istniejące stawki, aby zrobić miejsce."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Taxa de Carb cobre 24 horas. Você não pode adicionar mais taxas. Por favor, remova ou ajuste as taxas existentes para liberar espaço."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Соотношение карбов охватывает 24 часа. Вы не можете добавить больше тарифов. Пожалуйста, удалите или измените существующие тарифы, чтобы освободить место."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Carb Ratios cover 24 hours. You cannot add more rates. Please remove or adjust existing rates to make space."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Carb Ratios täcker 24 timmar. Du kan inte lägga till fler priser. Ta bort eller justera befintliga priser för att göra utrymme."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Carb Ratios cover 24 hours. You cannot add more rates. Please remove or adjust existing rates to make space."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Коефіцієнт Карба охоплює 24 години. Ви не можете додати більше ставок. Будь ласка, видаліть або відрегулюйте тарифи, щоб створити місце."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Carb Ratios cover 24 hours. You cannot add more rates. Please remove or adjust existing rates to make space."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "卡布比率覆盖24小时。您不能添加更多费率。请删除或调整现有费率以腾出空间。"
          }
        }
      }
    },
