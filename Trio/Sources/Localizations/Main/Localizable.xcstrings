    "ISF/CR" : {
      "comment" : "Option for both ISF and CR"
    },
    "It allows you to refer to live information at a glance and perform quick actions in your diabetes management." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "It allows you to refer to live information at a glance and perform quick actions in your diabetes management."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det giver dig mulighed for at henvise til levende information på et overblik og udføre hurtige handlinger i din diabetes management."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es erlaubt Ihnen, auf einen Blick auf die Live-Informationen zu verweisen und schnelle Aktionen in Ihrem Diabetes Management durchzuführen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le permite referirse a la información en vivo de un vistazo y realizar acciones rápidas en el manejo de su diabetes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il vous permet de consulter l'information en direct en un coup d'œil et d'effectuer des actions rapides dans la gestion de votre diabète."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "It allows you to refer to live information at a glance and perform quick actions in your diabetes management."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ti permette di fare riferimento alle informazioni dal vivo a colpo d'occhio ed eseguire azioni rapide nella gestione del diabete."
          }
        },
        "nb-NO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den lar deg se oppdatert informasjon ved et øyekast og gjøre raske vurderinger av din diabetesbehandling."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het stelt u in staat om live informatie te raadplegen en snelle acties uit te voeren in uw diabetesbeheer."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pozwala to na zapoznanie się z informacjami na żywo i na szybką reakcję w leczeniu cukrzycy."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ele permite que você se refira a informações ao vivo rapidamente e execute ações rápidas no seu gerenciamento de diabetes."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det gör att du kan se aktuell information på ett ögonblick och utföra snabba åtgärder i din diabetesbehandling."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "It allows you to refer to live information at a glance and perform quick actions in your diabetes management."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вона дозволяє посилатися на пряму інформацію уважно, здійснюючи швидкі дії з управління діабетами."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "It allows you to refer to live information at a glance and perform quick actions in your diabetes management."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "它可以讓你一目了然地參考即時資訊，並在糖尿病管理中執行快速操作。"
          }
        }
      }
    },
    "It is not recommended to set Autosens Max above 150% to maintain safe insulin dosing." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "It is not recommended to set Autosens Max above 150% to maintain safe insulin dosing."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det anbefales ikke at indstille Autosens Max over 150% for at opretholde sikker insulindosering."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es wird nicht empfohlen, Autosens Max über 150% zu setzen, um eine sichere Insulindosierung aufrechtzuerhalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se recomienda establecer Autosens Max por encima del 150% para mantener la dosis segura de insulina."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il n'est pas recommandé de définir Autosens Max au-dessus de 150% pour maintenir la dose d'insuline sûre."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "It is not recommended to set Autosens Max above 150% to maintain safe insulin dosing."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non è raccomandato impostare Autosens Max al di sopra del 150% per mantenere la dose sicura di insulina."
          }
        },
        "nb-NO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det anbefales ikke å stille inn Autosens maks. over 150 % for å opprettholde sikker insulindosering."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het wordt niet aanbevolen om Autosens Max in te stellen boven de 150% om veilige insuline dosing te behouden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie zaleca się ustawiania preparatu Autosens Max powyżej 150%, aby utrzymać bezpieczne dawkowanie insuliny."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não é recomendado definir o Autosens Máximo acima de 150% para manter a dosagem segura de insulina."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det rekommenderas inte att ställa in Autosens Max över 150% för att upprätthålla en säker insulindosering."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "It is not recommended to set Autosens Max above 150% to maintain safe insulin dosing."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не рекомендується встановлювати Автовизначення Макс. 150%, щоб підтримувати безпечне дози інсулінів."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "It is not recommended to set Autosens Max above 150% to maintain safe insulin dosing."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不建議將自動敏感度最大值設置在150%以上，以保持安全的胰島素劑量。"
          }
        }
      }
    },
    "It is one factor used in combination with the Fat and Protein Delay, Spread Interval, and Fat and Protein Factor to create the FPU entries." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "It is one factor used in combination with the Fat and Protein Delay, Spread Interval, and Fat and Protein Factor to create the FPU entries."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det er en faktor, der anvendes i kombination med fedt- og proteindelay-proteindelay, spread Interval, og fedt- og proteinfaktor til at skabe FPU-poster."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es ist ein Faktor, der in Kombination mit dem Fat and Protein Delay, Spread Interval und Fat and Protein Factor verwendet wird, um die FPU Einträge zu erstellen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es un factor utilizado en combinación con el retraso en grasas y proteínas, intervalo de propagación y factor de grasa y proteínas para crear las entradas de FPU."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il s'agit d'un facteur utilisé en combinaison avec le Délai de graisses et de protéines, l'intervalle de propagation et le Facteur de graisses et de protéines pour créer les entrées FPU."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "It is one factor used in combination with the Fat and Protein Delay, Spread Interval, and Fat and Protein Factor to create the FPU entries."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "È un fattore usato in combinazione con il Fat and Protein Delay, Intervallo di diffusione e Fat e Protein Factor per creare le voci FPU."
          }
        },
        "nb-NO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det er en faktor som brukes i kombinasjon med fett- og proteinforsinkelse, spredningsintervallet og fett- og proteinfaktor for å skape FPU-registreringene."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het is een factor die gebruikt wordt in combinatie met de Fat en Protein Delay, Spread Interval, Fat en Protein Factor om de FPU items te maken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jest to jeden z czynników stosowanych w połączeniu z tłuszczami i białkami, przedziałem ufności oraz czynnikiem tłuszczowym i białkowym do tworzenia wpisów FPU."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "É um factor utilizado em combinação com o Gordura e proteínas Delay, o Intervalo de Spread e o Fator de Gorduras e Proteínas para criar as entradas do FPU."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det är en faktor som används i kombination med fett och protein fördröjning, spridningsintervall, och fett- och protein-faktor för att skapa FPU poster."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "It is one factor used in combination with the Fat and Protein Delay, Spread Interval, and Fat and Protein Factor to create the FPU entries."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Це один фактор, який використовується у поєднанні з затримкою жиру та Білу, Інтервал поширення і жир і фактор білків для створення записів FPU."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "It is one factor used in combination with the Fat and Protein Delay, Spread Interval, and Fat and Protein Factor to create the FPU entries."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "它是與脂肪和蛋白質延遲、分散間隔和脂肪及蛋白質因子一起使用的一個因素，以創建FPU條目。"
          }
        }
      }
    },
    "It looks at the last 8-24 hours of data, excluding meal-related changes, and adjusts insulin settings like basal rates and targets when needed to match your sensitivity or resistance to insulin." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "It looks at the last 8-24 hours of data, excluding meal-related changes, and adjusts insulin settings like basal rates and targets when needed to match your sensitivity or resistance to insulin."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det ser på de sidste 8-24 timers data, bortset fra måltidsrelaterede ændringer, og justerer insulinindstillinger som basalsatser og mål efter behov for at matche din følsomhed eller resistens over for insulin."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es schaut sich die letzten 8-24 Stunden an Daten an, ohne Änderungen im Zusammenhang mit Mahlzeiten und passt Insulineinstellungen wie Basalwerte und Ziele an, um Ihre Empfindlichkeit oder Widerstandsfähigkeit gegen Insulin anzupassen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Echa un vistazo a las últimas 8-24 horas de datos, excluyendo los cambios relacionados con la comida y ajusta los ajustes de insulina como las tasas basales y los objetivos cuando sea necesario para ajustarse a su sensibilidad o resistencia a la insulina."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il examine les dernières 8-24 heures de données, en excluant les modifications relatives aux repas, et ajuste les paramètres d'insuline comme les taux de basal et les cibles si nécessaire pour correspondre à votre sensibilité ou votre résistance à l'insuline."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "It looks at the last 8-24 hours of data, excluding meal-related changes, and adjusts insulin settings like basal rates and targets when needed to match your sensitivity or resistance to insulin."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prende in esame le ultime 8-24 ore di dati, esclusi i cambiamenti legati ai pasti, e regola le impostazioni dell’insulina come velocità basali e bersagli quando necessario per abbinare la sua sensibilità o resistenza all’insulina."
          }
        },
        "nb-NO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den tar for seg de siste 8-24 timene med data, unntatt måltidsrelaterte endringer, og justerer innstillinger som basaldose og målinnstillinger for å tilpasse til din insulinfølsomhet eller insulinresistens."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het kijkt naar de laatste 8-24 uur aan gegevens, met uitzondering van de maaltijdgerelateerde wijzigingen. en past insuline instellingen aan zoals basaalstanden en doelen wanneer nodig om jouw gevoeligheid of weerstand te laten overeenkomen met jouw insuline."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "W sprawozdaniu uwzględniono ostatnie 8-24 godziny danych, z wyłączeniem zmian związanych z posiłkiem, i dostosowuje ustawienia insuliny, takie jak dawki bazowe i docelowe dawki insuliny, gdy jest to konieczne w celu dostosowania wrażliwości lub oporności na insulinę."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Analisa as últimas 8-24 horas dos dados, excluindo alterações relacionadas com refeições e ajusta as configurações de insulina, como taxas basais e alvos, quando necessário para atender à sua sensibilidade ou resistência à insulina."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Man tittar på de senaste 8-24 timmarna av data, exklusive måltidsrelaterade förändringar, och justerar insulininställningar som basal och glukosmål när det behövs för att matcha din känslighet eller resistens mot insulin."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "It looks at the last 8-24 hours of data, excluding meal-related changes, and adjusts insulin settings like basal rates and targets when needed to match your sensitivity or resistance to insulin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вона дивиться на останні 8-24 години даних, за винятком змін, пов’язаних з їжею, і налаштовує налаштування інсуліну, такі як базові показники і цілі, якщо потрібно встановити відповідність вашої чутливості або опору інсуліну."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "It looks at the last 8-24 hours of data, excluding meal-related changes, and adjusts insulin settings like basal rates and targets when needed to match your sensitivity or resistance to insulin."
          }
