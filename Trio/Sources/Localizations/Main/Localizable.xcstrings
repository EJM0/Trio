          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "These two settings determine the range outside of which you will be notified via push notifications."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dessa två inställningar bestämmer intervallet utanför vilket du kommer att meddelas via push-meddelanden."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "new",
