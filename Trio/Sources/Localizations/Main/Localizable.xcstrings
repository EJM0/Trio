    "Decrease sensitivity when glucose is below target if a manual Temp Target < %@ %@ is set." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Decrease sensitivity when glucose is below target if a manual Temp Target < %1$@ %2$@ is set."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Formindsk følsomhed, når glucose er under målet, hvis et manuelt temp mål < %1$@ %2$@ er indstillet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verringert die Empfindlichkeit, wenn die Glukose unterhalb des Ziels liegt, wenn ein  Temporäres Ziel < %1$@ %2$@ gesetzt ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Decrease sensitivity when glucose is below target if a manual Temp Target < %1$@ %2$@ is set."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disminuye la sensibilidad cuando la glucosa está por debajo del objetivo si se establece un objetivo temporal manual < %1$@ %2$@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diminuer la sensibilité lorsque le glucose est en dessous de la cible si une cible manuel de température < %1$@ %2$@ est définie."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Decrease sensitivity when glucose is below target if a manual Temp Target < %1$@ %2$@ is set."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diminuisce la sensibilità quando il glucosio è al di sotto del bersaglio se è impostato un obiettivo Temp manuale < %1$@ %2$@."
          }
        },
        "nb-NO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reduser følsomheten når blodsukker er under målet hvis et manuelt mål < %1$@ %2$@ er satt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verlaag de gevoeligheid wanneer glucose onder het streefdoel ligt als er een handmatige tijdelijke streefdoel < %1$@ %2$@ is ingesteld."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zmniejsz czułość, gdy poziom glukozy jest poniżej celu jeśli ustawiony jest ręczny cel tymczasowy < %1$@ %2$@"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diminuir a sensibilidade quando a glicose estiver abaixo do alvo se um Alvo Temp manual < %1$@ %2$@ estiver definido."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minska insulinkänsligheten när glukos är under målvärdet om ett tillfälligt mål < %1$@ %2$@ är aktivt."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Decrease sensitivity when glucose is below target if a manual Temp Target < %1$@ %2$@ is set."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Зменшити чутливість, коли встановлено глюкозу, якщо встановлено ручний об'єкт < %1$@ %2$@."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Decrease sensitivity when glucose is below target if a manual Temp Target < %1$@ %2$@ is set."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果手動臨時目標設定低於 %1$@ %2$@，則在血糖低於目標時降低敏感度。"
          }
        }
      }
    },
    "Decreasing this setting may result in fewer FPU entries with larger carb values." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Decreasing this setting may result in fewer FPU entries with larger carb values."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reduktion af denne indstilling kan resultere i færre FPU poster med større carb værdier."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Verringerung dieser Einstellung kann dazu führen, dass es weniger FPU-Einträge mit größeren Kohlenhydratwerten gibt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disminuir este ajuste puede resultar en menos entradas de FPU con valores de glúcido más grandes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diminuer ce paramètre peut entraîner moins d'entrées FPU avec de plus grandes valeurs de glucides."
          }
        },
        "he" : {
