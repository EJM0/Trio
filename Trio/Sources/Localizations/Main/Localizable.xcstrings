    "This will cause a sound to be triggered by Trio notifications for Carbs Required, and Glucose Low/High Alarms." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيؤدي هذا إلى تشغيل الصوت بواسطة إشعارات ثلاثية للكربونات المطلوبة، والإنذار المنخفض أو العالي جلوكوس."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dette vil få en lyd til at blive udløst af Trio meddelelser for kulhydrater krævet, og Glucose Lav/høje alarmer."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dies wird dazu führen, dass ein Ton durch Trio-Benachrichtigungen für Carbs Required, und Glucose Low/High Alarms ausgelöst wird."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto causará que un sonido sea activado por las notificaciones Trio para Carbs Requeridos, y Glucose Low/High Alarms."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cela provoquera le déclenchement d'un son par les notifications de Trio pour les Glucides Nécessaires, et les Alarmes Glycémie Basses ou Hautes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo farà sì che un suono venga attivato dalle notifiche Trio per Carbs Required, e Glucosio Low/High Alarms."
          }
        },
        "nb-NO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dette vil forårsake at en lyd utløses av Trio varsler for Karbo krevde og glukose lave/høye varsler."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dit zorgt ervoor dat geluid wordt geactiveerd door Trio meldingen voor koolhydraten Vereist, en Glucose Low/Hoge Alarms."
          }
        },
        "pl" : {
