    "\n\nTap 'Add' to continue with selected amount." : {
      "comment" : "Alert to confirm bolus amount to add",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "\n\nTap 'Add' to continue with selected amount."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n\nTryk 'Tilføj' for at fortsætte med den valgte mængde."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n\nTippen Sie auf 'Hinzufügen', um mit dem ausgewählten Betrag fortzufahren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n\nTap 'Add' to continue with selected amount."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "\n\nTap 'Add' to continue with selected amount."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n\nAppuyez sur 'Ajouter' pour continuer avec le montant sélectionné."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n\nTocca 'Aggiungi' per continuare con la quantità selezionata."
          }
        },
        "nb-NO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n\nTrykk \"Legg til\" for å fortsette med valgt mengde."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n\nTik op 'Toevoegen' om door te gaan met het geselecteerde aantal."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n\nNaciśnij przycisk 'Dodaj', aby kontynuować z wybraną kwotą."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "\n\nTap 'Add' to continue with selected amount."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n\nНажмите \"Добавить\", чтобы продолжить с выбранным значением."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n\nKlepnutím na \"Pridať\" pokračujte s vybranou sumou."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n\nTryck 'Lägg till' för att fylla i bolusmängd."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "\n\nTap 'Add' to continue with selected amount."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n\nНатисніть «Додати», щоб продовжити з вибраним значенням."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n\nNhấn 'Thêm' để tiếp tục với số lượng đã chọn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n\n点击\"添加\"以继续选定金额。"
          }
        }
      }
    },
    "\nAmount is more than your Max Bolus setting! \nAre you sure you want to add " : {
      "comment" : "Alert when adding large amount without bolusing",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "\nAmount is more than your Max Bolus setting! \nAre you sure you want to add "
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nDette er mere insulin end din \"max dosis\" indstilling!\nEr du sikker på at du vil tilføje "
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nEingegebener Bolus ist größer als Max Bolus Einstellung! Sind Sie sicher, dass er hinzugefügt werden soll "
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nAmount is more than your Max Bolus setting! \nAre you sure you want to add "
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "\nAmount is more than your Max Bolus setting! \nAre you sure you want to add "
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nLe montant est supérieur à votre paramètre de Bolus Max ! \nÊtes-vous sûr de vouloir ajouter "
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nLa quantità è superiore all'impostazione del bolo massimo! \nSei sicuro di voler aggiungere?"
          }
        },
        "nb-NO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nMengden er høyere enn din Maks bolus-innstilling! \nEr du sikker på at du vil legge til "
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nDeze hoeveelheid is meer dan je instelling van je maximale bolus! \nWeet je zeker dat je deze hoeveelheid wilt toedienen? \nDeze hoeveelheid is meer dan je instelling van je maximale bolus! \nWaarschuw bij toedienen van een hoge hoeveelheid zonder te bolussen "
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nKwota jest większa niż Twoje ustawienie Max bolus! \nCzy na pewno chcesz dodać "
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nValor é maior do que a configuração de seu Bólus Máximo! \nTem certeza que deseja adicionar "
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nКоличество превышает максимальную дозу болюса! \nВы уверены, что хотите добавить "
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nDávka prekračuje vaše nastavenie Max Bolus!\nSte si istí, že chcete dávku pridať "
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nDetta är mer insulin än din maxdos-inställning! \nÄr du säker på att du vill lägga till "
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "\nAmount is more than your Max Bolus setting! \nAre you sure you want to add "
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nКількість перевищує ваш максимальний болюс! \nВи впевнені, що хочете додати"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nLiều tiêm nhiều hơn liều Max Bolus! \nBạn có chắc chắn muốn thêm "
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n金额超过了您的最大块设置！ \n您确定要添加。 "
          }
        }
      }
    },
    "\nInvalid Nightcsout Basal Settings. \n\nImport aborted. Please check your Nightscout Profile Basal Settings!" : {
      "comment" : "Import ErrorImport Error",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "\nInvalid Nightcsout Basal Settings. \n\nImport aborted. Please check your Nightscout Profile Basal Settings!"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nUgyldig Nightcsout Basal Indstillinger. \n\nImport afbrudt. Tjek venligst dine Nightscout Profil Basal Indstillinger!"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nUngültige Nightcsout Basal-Einstellungen. \n\nImport abgebrochen. Bitte überprüfen Sie Ihre Nightscout Profil Basal-Einstellungen!"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nInvalid Nightcsout Basal Settings. \n\nImport aborted. Please check your Nightscout Profile Basal Settings!"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nConfiguración basal de Nightcsout no válida. \n\nImportación cancelada. Por favor comprueba tu configuración basal de perfil de Nightscout!"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nParamètres de base Nightcsout non valides. \n\nL'importation a été interrompue. Veuillez vérifier les paramètres de base de votre profil Nightscout !"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nImpostazioni Basali Nightscout non valide. \n\nImportazione annullata. Si prega di controllare le impostazioni Basali del profilo Nightscout!"
          }
        },
        "nb-NO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nUgyldig basalprofil fra Nightscout. \n\nImport avbrutt. Sjekk basalprofil i Nightscout!"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nOngeldige Nightscout basaal instellingen. \n\nImport afgebroken. Check je Nightscout Profiel basaal instellingen!"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nNieprawidłowe ustawienia bazy Nightcsout. \n\nImportowanie przerwane. Sprawdź ustawienia bazy profilu Nightscout!"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nConfigurações de Basal do Nightcsout inválidas. \n\nImportação abortada. Por favor, verifique suas configurações do perfil do Nightscout!"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nНедопустимые настройки базы в Nightcsout. \n\nИмпорт прерван. Пожалуйста, проверьте настройки профиля в Nightscout!"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nNeplatné základné nastavenia Nightcsout. \n\nImport bol prerušený. Skontrolujte základné nastavenia svojho profilu Nightscout!"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nDu har ogiltiga basalinställningar i Nightscouts profilinställningar. \n\nImport avbruten. Du behöver kontrollera dina Nightcoutinställningar."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "\nInvalid Nightcsout Basal Settings. \n\nImport aborted. Please check your Nightscout Profile Basal Settings!"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nНедійсні базальні налаштування Nightcsout. \n\nІмпорт перервано. Будь ласка, перевірте базальні налаштування свого профілю Nightscout!"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nCác cấu hình liều nền trên Nightscout không hợp lệ.\n\n Việc cập nhật bị bỏ. Đề nghị bạn kiểm tra cấu hình liều nền trên Nightscout!"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "\nInvalid Nightcsout Basal Settings. \n\nImport aborted. Please check your Nightscout Profile Basal Settings!"
          }
        }
      }
    },
    "\nMismatching glucose units in Nightscout and Pump Settings. Import settings aborted." : {
      "comment" : "Import ErrorImport Error",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "\nMismatching glucose units in Nightscout and Pump Settings. Import settings aborted."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nUoverensstemmende glukose enheder i Nightscout og Pumpe Indstillinger. Import af indstillinger afbrudt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nFalsch übereinstimmende Glukoseeinheiten in Nightscout und Pump-Einstellungen. Import abgebrochen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nMismatching glucose units in Nightscout and Pump Settings. Import settings aborted."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unidades de glucosa no coincidentes \nen Nightscout y Configuración de la Bomba. Ajustes de importación cancelados."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nLes unités de glucose ne correspondent pas dans les réglages de Nightscout et de la pompe. L'importation des paramètres a été interrompue."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nUnità di glicemie non corrispondenti nelle impostazioni di Nightscout e della Pompa. Importa impostazioni interrotte."
          }
        },
        "nb-NO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nBlodsukkerenhet i Nightscout samsvarer ikke med blodsukkerenhet i pumpeinnstillinger. Import av innstillinger er avbrutt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nMismatch van glucoseeenheden in Nightscout en pomp instellingen. Importeer instellingen is afgebroken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nNiepasujące jednostki glukozy w Ustawieniach Nightscout i Pompy. Importowanie ustawień przerwane."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nUnidades de glicose não coincidem nas configurações do Nightscout e da bomba. Importar configurações foi interrompido."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nНесоответствие единиц измерения глюкозы в настройках Nightscout и помпы. Импорт настроек прерван."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nNekompatibilné jednotky glukózy v Nightscoute a nastaveniach pumpy. Import nastavení bol zrušený."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nDu har olika inställningar för blodsockernehet i Nightscout och iAPS. Import därför avbruten."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "\nMismatching glucose units in Nightscout and Pump Settings. Import settings aborted."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nНевідповідність одиниць глюкози в налаштуваннях Nightscout та Помпи. Імпорт налаштувань скасовано."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n Sai khác đơn vị Glucose giữa Nightscout và Bơm. Cập nhật cấu hình bị bỏ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n在 Nightscout 和 Pump 设置中不匹配血糖单位。导入设置中止。"
          }
        }
      }
    },
    "\nNow please verify all of your new settings thoroughly: \n\n • DIA (Pump settings)\n • Basal Profile\n • Insulin Sensitivities\n • Carb Ratios\n • Glucose Targets\n\n in Trio Settings -> Configuration.\n\nBad or invalid profile settings could have disastrous effects." : {
      "comment" : "Imported Profiles Alert",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nالآن يرجى التحقق من جميع إعداداتك الجديدة بشكل شامل: \n\n • DIA (إعدادات المضغوط)\n • الملف الشخصي الأساسي\n • حساسيات السلسلة\n • نسب كارب\n • أهداف جلوكوز\n\n في الإعدادات الثلاثية -> التكوين.\n\nإعدادات الملف الشخصي سيئة أو غير صالحة يمكن أن يكون لها تأثيرات كارثية."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nKontroller nu alle dine nye indstillinger grundigt:\n\n* Basal Indstillinger\n * Kulhydratratios\n * Glukose Mål\n * Insulin Følsomhed\n * VIA\n\n i Trio Indstillinger > Konfiguration.\n\nDårlige eller ugyldige profilindstillinger kan have katastrofale effekter."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nBitte überprüfen Sie jetzt alle Ihre neuen Einstellungen gründlich:\n\n* Basaleinstellungen\n * Carb Ratios\n * Glukose-Ziele\n * Insulinempfindlichkeiten\n * DIA\n\n in Trio-Einstellungen > Konfiguration.\n\nSchlechte oder ungültige Profileinstellungen können abscheuliche Effekte haben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nNow please verify all of your new settings thoroughly: \n\n • DIA (Pump settings)\n • Basal Profile\n • Insulin Sensitivities\n • Carb Ratios\n • Glucose Targets\n\n in Trio Settings -> Configuration.\n\nBad or invalid profile settings could have disastrous effects."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "\nNow please verify all of your new settings thoroughly: \n\n • DIA (Pump settings)\n • Basal Profile\n • Insulin Sensitivities\n • Carb Ratios\n • Glucose Targets\n\n in Trio Settings -> Configuration.\n\nBad or invalid profile settings could have disastrous effects."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nVeuillez maintenant vérifier soigneusement tous vos nouveaux paramètres:\n\n* Paramètres basaux\n * Ratios glucidiques\n * Objectifs glycémiques\n * Sensibilité à l'insuline\n * DIA\n\n dans Trio Paramètres > Configuration.\n\nDes paramètres de profil incorrects ou invalides peuvent avoir des effets désastreux."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nOra verifica attentamente tutte le nuove impostazioni:\n\n* Impostazioni basali\n * Rapporti carboidrati\n * Obiettivi glucosio\n * Sensibilità insulinica\n * DIA\n\n in Impostazioni Trio > Configurazione.\n\nImpostazioni del profilo errate o non valide potrebbero avere effetti disastrosi."
          }
        },
        "nb-NO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nGå nøye gjennom de nye innstillingene:\n\n • DIA (pumpeinnstillinger)\n • Basalprofil\n • Insulinfølsomhet\n • Karbohydratforhold\n • Blodsukkermål\n\n i Trio-innstillinger.\n\nFeil eller ugyldige profilinnstillinger kan få katastrofale konsekvenser."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nCheck nu al je nieuwe instellingen:\n\n* Basaal instellingen\n * Koolhydraat ratio's\n * Doel glucose waarde\n * Insuline sensitiviteit\n * DIA\n\n in Trio instellingen > Configuratie.\n\nSlechte of ongeldige profielinstellingen kunnen  desastreuze effecten hebben!"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nTeraz sprawdź dokładnie wszystkie swoje nowe ustawienia: \n\n • DIA (ustawienia pompy)\n • Profil Basal\n • Wrażliwość na insulinę\n • Współczynnik węglowodanów\n • Cele glikemii\n\n w Ustawieniach Trio -> Konfiguracja.\n\nBłędne lub nieprawidłowe ustawienia profilu mogą mieć katastrofalne skutki."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "\nNow please verify all of your new settings thoroughly: \n\n • DIA (Pump settings)\n • Basal Profile\n • Insulin Sensitivities\n • Carb Ratios\n • Glucose Targets\n\n in Trio Settings -> Configuration.\n\nBad or invalid profile settings could have disastrous effects."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nПожалуйста, проверьте все ваши новые настройки:\n\n* Настройки базала\n * Углеводные коэффициенты\n * Целевой диапазон\n * Чувствительность к инсулину\n\n в настройках Trio Настройки > Конфигурация.\n\nНекорректные настройки профиля могут привести к катастрофическим последствиям."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nTeraz dôkladne skontrolujte všetky nové nastavenia:\n\n* Bazálne nastavenia\n * Pomery uhľohydrátov\n * Cieľové hodnoty glukózy\n * Citlivosť na inzulín\n * DIA\n\n v Trio Nastavenia > Konfigurácia.\n\nZlé alebo neplatné nastavenia profilu by mohli mať škodlivé účinky."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nKontrollera nu alla dina nya pumpinställningar noga:\n\n* Basalinställningar\n * Insulinkvoter\n * Målvärden\n * Insulinkänslighet\n\n i Inställningar > Konfiguration.\n\nDåliga eller ogiltiga pumpinställningar kan gå katastrofala följder."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "\nNow please verify all of your new settings thoroughly: \n\n • DIA (Pump settings)\n • Basal Profile\n • Insulin Sensitivities\n • Carb Ratios\n • Glucose Targets\n\n in Trio Settings -> Configuration.\n\nBad or invalid profile settings could have disastrous effects."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nТепер уважно перевірте всі ваші нові налаштування:\n\n* Базальні параметри\n * Вуглеводні співвідношення\n * Цільові показники глюкози\n * Чутливість до інсуліну\n\n у меню «Налаштування Trio» > «Конфігурація».\n\nПоганий або недійсний профіль налаштування можуть мати згубні наслідки."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n Bây giờ xin hãy xác minh lại tất cả các cài đặt của bạn kỹ lưỡng:\n\n* Cài đặt liều nền\n * Tỷ lệ Carb\n * Mục tiêu đường huyết \n * Độ nhạy của Insulin\n * Thời gian hoạt động của insulin\n\n trong Trio Cài đặt > Cấu hình.\n\n Cấu hình không hợp lệ hoặc tồi có thể có tác động thảm họa."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n现在请彻底验证您所有的新设置： \n\n • DIA (Pump settings)\n • Basal Profile\n • Insulin Sensitivies\n • Carb Ratios\n • Trio 设置 -> 配置中的 Glucose Targets\n\n\n\n错误或无效的配置文件设置可能会产生灾难性影响。"
          }
        }
      }
    },
    "\nSettings were imported but the Basals couldn't be saved to pump (No pump). Check your basal settings and tap ´Save on Pump´ to sync the new basal settings" : {
      "comment" : "Import ErrorImport Error",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nتم استيراد الإعدادات ولكن لا يمكن حفظ قاعدة البيانات الأساسية للمضخات (بدون مضخة). تحقق من الإعدادات الأساسية الخاصة بك وانقر على الحفظ على مضخة <unk> لمزامنة الإعدادات الأساسية الجديدة"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nIndstillinger blev importeret, men Basalinsulin indstillinger kunne ikke gemmes til pumpe (Ingen pumpe). Tjek dine basal indstillinger og tryk på 'Gem på Pumpe' for at synkronisere de nye basal indstillinger"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nEinstellungen wurden importiert, aber die Basalen konnten nicht in Pumpe gespeichert werden (keine Pump). Überprüfen Sie Ihre Basiseinstellungen und tippen Sie auf <unk> Speichern auf Pump, um die neuen Basiseinstellungen zu synchronisieren"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nSettings were imported but the Basals couldn't be saved to pump (No pump). Check your basal settings and tap ´Save on Pump´ to sync the new basal settings"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nConfiguración importada pero las Basales no se pudieron guardar en la bomba (Sin bomba). Revisa la configuración basal y pulsa sobre la bomba para sincronizar la nueva configuración basal"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nLes réglages ont été importés mais les valeurs basales n'ont pas pu être enregistrées sur la pompe (pas de pompe). Vérifiez vos réglages de base et appuyez sur \"Enregistrer sur la pompe\" pour synchroniser les nouveaux réglages de base"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nLe impostazioni sono state importate ma non è stato possibile salvare le basali nel microinfusore (nessun microinfusore). Controlla le impostazioni basali e tocca \"Salva sul microinfusore\" per sincronizzare le nuove impostazioni basali"
          }
        },
        "nb-NO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nInnstillinger ble importert men basalprofilen kunne ikke lagres til pumpen (ingen pumpe). Sjekk din basalprofil og trykk ´Lagre på pumpen´ for å sende den nye basalprofilen til pumpen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\ninstellingen zijn geïmporteerd maar de basaalstanden konden niet worden opgeslagen in de pomp (geen pomp). Controleer je basaalstanden en tik op' Opslaan op pomp' om de nieuwe basaalstanden te synchroniseren"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nUstawienia zostały zaimportowane, ale Baza nie mogła zostać zapisana do pompy (brak pompy). Sprawdź ustawienia bazy i naciśnij przycisk Zapisz na Pompie, aby zsynchronizować nowe ustawienia bazy"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "U\nConfigurações foram importadas, mas os basais não puderam ser salvos na bomba (Sem bomba). Verifique as suas configurações de basal e toque em Salvar na Bomba para sincronizar as novas configurações de basal"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nНастройки были импортированы, но базальный профиль не удалось сохранить в помпе (нет помпы). Проверьте свои настройки базы и нажмите \"Сохранить на помпу\", чтобы синхронизировать новый базальный профиль"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nNastavenia boli importované, ale základné údaje nebolo možné uložiť do čerpadla (žiadne čerpadlo). Skontrolujte bazálne nastavenia a klepnutím na ´Uložiť na pumpe´ synchronizujte nové bazálne nastavenia"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nDina inställningar blev importerade men kunde inte sparas till pump (Ingen pump). Kontrollera dina pumpinstälningar och klicka därefter på ´Spara på pump´ för att programmera din pump med de nya basalinställningarna"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "\nSettings were imported but the Basals couldn't be saved to pump (No pump). Check your basal settings and tap ´Save on Pump´ to sync the new basal settings"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nНалаштування було імпортовано, але Базал не вдалося зберегти для помпи (немає помпи). Перевірте свої базальні налаштування та натисніть «Зберегти на помпі», щоб синхронізувати нові базальні налаштування"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n Các cấu hình đã được nhập nhưng liều nền không được lưu vào bơm (không có bơm). Kiểm tra cấu hình liều nền của bạn và nhấn 'Lưu vào bơm' để đồng hóa cấu hình liều nền mới"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n设置已被导入，但Basals无法保存到水泵(无水泵)。 检查您的基本设置，然后单击\"甲状腺上保存以同步新的基本设置"
          }
        }
      }
    },
