          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最少5分鐘碳水影響設定預期在吸收不明顯的情況下，碳水化合物在5分鐘內對葡萄糖的升高影響。"
          }
        }
      }
