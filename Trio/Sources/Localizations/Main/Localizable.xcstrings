          }
        },
        "nb-NO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deaktivering av denne innstillingen vil fortsatt tillate andre kommandoer, som temp-mål, legge til handlekurver, og Start/Slutt-overstyringer"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het uitschakelen van deze instelling zal andere commando's toestaan, zoals tijdelijke streefdoelen, toevoegen van koolhydraten en Start/Eind overschrijvingen"
