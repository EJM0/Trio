    "Careful tuning is essential to avoid overly aggressive insulin changes." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إن التحسين الدقيق أمر أساسي لتجنب التغييرات المفرطة في العدوانية في الأنسولين."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Omhyggelig tuning er vigtigt for at undgå alt for aggressive insulinændringer."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um übermäßig aggressive Insulinveränderungen zu vermeiden, ist eine sorgfältige Abstimmung unerlässlich."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El ajuste cuidadoso es esencial para evitar cambios de insulina demasiado agresivos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une mise au point prudente est essentielle pour éviter des changements d'insuline trop agressifs."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una attenta sintonizzazione è essenziale per evitare cambiamenti eccessivamente aggressivi di insulina."
          }
        },
        "nb-NO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nøye justering er nødvendig for å unngå for mye aggressive insulinendringer."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voorzichtig afstemmen is essentieel om te veel agressieve insuline-veranderingen te voorkomen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aby uniknąć nadmiernie agresywnych zmian insuliny, konieczne jest staranne dostrojenie."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma afinação cuidadosa é essencial para evitar mudanças de insulina excessivamente agressivas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Во избежание чрезмерной агрессивной инсулина важно тщательная настройка."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Careful tuning is essential to avoid overly aggressive insulin changes."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noggrann stämning är viktigt för att undvika alltför aggressiva insulinförändringar."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "new",
