    "Trio has successfully imported your default Nightscout profile and stored it as therapy settings. " : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "استورد تريو بنجاح ملف تعريف التجسس الليلي الافتراضي الخاص بك وتخزينه كإعدادات علاج. "
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trio har importeret din standard Nightscout profil og gemt den som terapi indstillinger. "
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trio hat erfolgreich Ihr Standard-Nightscout-Profil importiert und als Therapieeinstellungen gespeichert. "
          }
        },
