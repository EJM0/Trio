    "Live activity displays blood glucose live on the lock screen and on the dynamic island (if available)" : {
      "comment" : "Notification option",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يعرض النشاط المباشر جلوكوز الدم مباشرة على شاشة القفل وعلى الجزيرة الديناميكية (إذا كان متاحا)"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Live aktivitet viser blodglukose live på låseskærmen og på den dynamiske ø (hvis tilgængelig)"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Live-Aktivität zeigt die Blutzucker live auf dem Sperrbildschirm und auf der dynamischen Insel (falls verfügbar)"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Live activity displays blood glucose live on the lock screen and on the dynamic island (if available)"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La actividad en vivo muestra la glucosa en vivo en la pantalla de bloqueo y en la isla dinámica (si está disponible)"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'activité en direct affiche la glycémie en direct sur l'écran de verrouillage et sur l'île dynamique (si disponible)"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'attività dal vivo mostra il glucosio del sangue vivo sulla schermata di blocco e sull'isola dinamica (se disponibile)"
          }
        },
        "nb-NO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oppdateringer i sanntid viser blodsukker live på låseskjermen og på den dynamiske øya (hvis tilgjengelig)"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De 'Live activiteit' toont bloedglucose op het vergrendelscherm en op het Dynamische Island (indien beschikbaar).\n\nDynamic Island vervangt de traditionele statische 'notch' (inkeping) aan de bovenkant van de iPhone-schermen"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktywność na żywo wyświetla stężenie glukozy we krwi na ekranie blokady i na dynamicznej wyspie (jeśli jest dostępna)"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atividade ao vivo exibe glicemia ao vivo na tela de bloqueio e na ilha dinâmica (se disponível)"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Эфир активности - в реальном времени отображает уровень глюкозы в крови на экране блокировки и на динамическом островке Dynamic Island (если доступно)"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Live activity displays blood glucose live on the lock screen and on the dynamic island (if available)"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liveaktivitet visar senaste blodsockeravläsning på låsskärmen och på Dynamic Island, om sådan finns på din iPhone-modell"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "new",
