    "This feature ensures more accurate insulin adjustments when carb entries are missing or incorrect." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "وتكفل هذه الميزة إدخال تعديلات أكثر دقة على الأنسولين عندما تكون إدخالات السرقة مفقودة أو غير صحيحة."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne funktion sikrer mere nøjagtige insulinjusteringer, når carb poster mangler eller er forkerte."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Feature sorgt für genauere Insulinanpassungen, wenn Kohlenstoffeinträge fehlen oder nicht korrekt sind."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta característica asegura ajustes de insulina más precisos cuando las entradas de glúcido faltan o son incorrectas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette fonctionnalité garantit des ajustements plus précis de l'insuline lorsque les entrées de glucides sont manquantes ou incorrectes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa funzione assicura aggiustamenti più accurati dell’insulina quando le voci del carb sono mancanti o errate."
          }
        },
        "nb-NO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne funksjonen sikrer mer nøyaktige insulinjusteringer når karbo påføringene mangler eller er feil."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze functie zorgt voor nauwkeurigere insuline aanpassingen wanneer de invoer van koolhydraten ontbreekt of onjuist."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta funkcja zapewnia dokładniejsze dostosowanie insuliny w przypadku braku lub niepoprawnych wpisów węglowodanów."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
