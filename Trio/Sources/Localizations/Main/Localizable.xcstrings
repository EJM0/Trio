          }
        }
      }
    },
    "This is the amount of the maximum number of carbs we’ll assume will absorb over 4h if we don’t yet see carb absorption." : {
      "comment" : "\"Remaining Carbs Cap\"",
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "This is the amount of the maximum number of carbs we’ll assume will absorb over 4h if we don’t yet see carb absorption."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dette er mængden af det maksimale antal kulhydrater vi antager, vil absorbere over 4 timer, hvis vi endnu ikke ser carb absorption."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dies ist die maximale Anzahl der geschätzten abgebauten Kohlenhydrate in 4 Stunden, wenn keine Kohlenhydrat-Resorption ersichtlich ist."
