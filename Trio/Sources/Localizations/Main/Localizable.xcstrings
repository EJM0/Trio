            "value" : "Dette tillater Trio å lese fra og skrive til Apple Health."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dit staat Trio toe om te lezen en te schrijven naar Apple Health."
          }
        },
        "pl" : {
