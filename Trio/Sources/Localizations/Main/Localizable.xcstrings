    "Displays the total amount of insulin given as a bolus (manual or SMB) and through temporary basal rates above zero during the selected timeframe of the main chart." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يعرض إجمالي كمية الأنسولين المعطاة كبولي (يدوياً أو SMB) ومن خلال المعدلات الأساسية المؤقتة التي تزيد على الصفر خلال الإطار الزمني المحدد للرسم البياني الرئيسي."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viser den samlede mængde insulin givet som en bolus (manuel eller SMB) og gennem midlertidige basale hastigheder over nul i den valgte tidsramme for hoveddiagrammet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeigt die Gesamtmenge an Insulin als Bolzen (manuelle oder SMB) und durch temporäre Basalraten über Null während des gewählten Zeitraums des Hauptdiagramms."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muestra la cantidad total de insulina dada como un bolo (manual o SMB) y a través de tarifas basales temporales por encima de cero durante el período de tiempo seleccionado del gráfico principal."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Affiche la quantité totale d'insuline donnée sous la forme d'un bolus (manuel ou SMB) et à travers les débits de basal temporaires au-dessus de zéro pendant la période sélectionnée du graphique principal."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visualizza la quantità totale di insulina somministrata in bolo (manuale o SMB) e attraverso tassi basali temporanei superiori a zero durante il periodo di tempo selezionato del grafico principale."
          }
        },
        "nb-NO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viser total mengde insulin gitt som bolusdose (manuell eller SMB), og gjennom midlertidige basalrater over null under den utvalgte tidsrammen for hovedtegnet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geeft de totale hoeveelheid insuline als een bolus (handmatig of SMB) weer en door tijdelijke basaalstanden boven nul gedurende de geselecteerde periode van de hoofdgrafiek."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wyświetla całkowitą ilość insuliny podawanej jako bolus (ręczny lub SMB) oraz poprzez tymczasowe dawki bazowe powyżej zera podczas wybranych ram czasowych głównego wykresu."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exibe a quantidade total de insulina dada como um bolus (manual ou SMB) e por taxas basais temporárias acima de zero durante o período selecionado do gráfico principal."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отображает общее количество инсулина, заданного как болт (ручной или SMB) и по временным базальным ставкам выше нуля во время выбранного временного периода основного графика."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Displays the total amount of insulin given as a bolus (manual or SMB) and through temporary basal rates above zero during the selected timeframe of the main chart."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visar den totala mängden insulin som anges som en bolus (manuell eller SMB) och genom tillfälliga basala hastigheter över noll under den valda tidsramen för huvuddiagrammet."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Displays the total amount of insulin given as a bolus (manual or SMB) and through temporary basal rates above zero during the selected timeframe of the main chart."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Відображає загальну кількість інсуліну, яку дають як болт (ручний або СМ) та через тимчасові базові ставки, що вище нуля протягом вибраного часового проміжку від основного графіку."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Displays the total amount of insulin given as a bolus (manual or SMB) and through temporary basal rates above zero during the selected timeframe of the main chart."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在主图选定的时间范围内通过临时基本费率在零以上显示作为块状体（手动或块状）给定的绝缘总量。"
          }
        }
      }
    },
