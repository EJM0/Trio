    "Choose between Total Daily Dose (TDD) or Total Insulin in Scope (TINS) to be displayed above the main glucose graph. Descriptions for each option found below." : {
      "extractionState" : "stale",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Choose between Total Daily Dose (TDD) or Total Insulin in Scope (TINS) to be displayed above the main glucose graph. Descriptions for each option found below."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vælg mellem total daglig dosis (TDD) eller total insulin i Scope (TINS), der skal vises over den vigtigste glukosegraf. Beskrivelser for hver indstilling fundet nedenfor."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wählen Sie zwischen Total Daily Dose (TDD) oder Total Insulin im Scope (TINS), um über dem Glukosegraphen angezeigt zu werden. Beschreibungen für jede nachstehende Option."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elija entre la dosis diaria total (TDD) o la insulina total en el ámbito (TINS) que se mostrará sobre el gráfico principal de la glucosa. Descripciones para cada opción encontradas a continuación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez entre la dose quotidienne totale (DTD) ou l'Insuline totale dans le Scope (TINS) à afficher au-dessus du graphique de glucose principal. Descriptions pour chaque option trouvée ci-dessous."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Choose between Total Daily Dose (TDD) or Total Insulin in Scope (TINS) to be displayed above the main glucose graph. Descriptions for each option found below."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scegliere tra la dose giornaliera totale (TDD) o l'insulina totale in ambito (TINS) da visualizzare sopra il grafico del glucosio principale. Descrizioni per ogni opzione trovata qui sotto."
          }
        },
        "nb-NO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Velg mellom total daglig dose (TDD) eller total insulin i virkeområde (TINS) som skal vises på hjem-fanen. Beskrivelser for hvert alternativ finnes nedenfor."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kies tussen de Totaal Dagelijkse Dose (TDD) of de Totale Insuline in Scope (TINS) die wordt weergegeven boven de hoofdgrafiek van de glucose. Omschrijvingen voor elke optie hieronder gevonden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wybrać pomiędzy całkowitą dawką dobową (TDD) lub całkowitą dawką insuliny w zakresie (TINS), która ma być wyświetlana powyżej głównego wykresu glukozy. Opis dla każdej opcji znajdującej się poniżej."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolha entre os Dose Total Diária (TDD) ou Insulina Total no Escopo (TINS) a ser exibido acima do gráfico de glicose principal. Descrições para cada opção encontrada abaixo."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Välj mellan total daglig dos (TDD) eller totalt insulin i scope (TINS) som ska visas ovanför huvudglukosgrafen. Beskrivningar för varje alternativ som finns nedan."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Choose between Total Daily Dose (TDD) or Total Insulin in Scope (TINS) to be displayed above the main glucose graph. Descriptions for each option found below."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Оберіть Загалом щоденних доз (TD) або Всього Insulin спектру (TINS) для відображення над графіком глюкози. Описи для кожного із знайдених нижче."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Choose between Total Daily Dose (TDD) or Total Insulin in Scope (TINS) to be displayed above the main glucose graph. Descriptions for each option found below."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在主血糖圖上選擇顯示每日總劑量 (TDD) 或範圍內的總胰島素 (TINS)。每個選項的描述如下。"
          }
        }
      }
    },
