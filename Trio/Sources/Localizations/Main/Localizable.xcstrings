    "To configure your CGM, tap the button below. In the form that opens, enter your Nightscout credentials to connect to your instance." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "To configure your CGM, tap the button below. In the form that opens, enter your Nightscout credentials to connect to your instance."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvis du vil konfigurere din CGM, skal du trykke på knappen nedenfor. Indtast dine Nightscout-oplysninger for at oprette forbindelse til din instans."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zum Konfigurieren des CGM, tippen Sie auf den Button unten. Geben Sie in dem Formular, das sich öffnet, Ihre Nightscout-Anmeldeinformationen ein, um sich mit Ihrer Instanz zu verbinden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para configurar su CGM, pulse el botón de abajo. En el formulario que se abre, introduzca sus credenciales de Nightscout para conectarse a su instancia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour configurer votre CGM, appuyez sur le bouton ci-dessous. Dans le formulaire qui s'ouvre, entrez vos identifiants Nightscout pour vous connecter à votre instance."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "To configure your CGM, tap the button below. In the form that opens, enter your Nightscout credentials to connect to your instance."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per configurare il tuo CGM, tocca il pulsante qui sotto. Nel modulo che si apre, inserisci le credenziali di Nightscout per connetterti alla tua istanza."
          }
        },
        "nb-NO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For å konfigurere CGM, trykk på knappen nedenfor. I skjemaet som åpnes, skriv inn legitimasjonen Nightscout for å koble til forekomsten din."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Om je CGM te configureren, tik je op de knop hieronder. Voer je Nightscout inloggegevens in om verbinding te maken met je installatie."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aby skonfigurować CGM, naciśnij poniższy przycisk. W formularzu, który otworzy się, wprowadź swoje dane logowania Nightscout, aby połączyć się z wystąpieniem."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para configurar seu CGM, toque no botão abaixo. No formulário que abrir, insira suas credenciais do Nightscout para se conectar à sua instância."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "För att konfigurera din CGM, tryck på knappen nedan. I det formulär som öppnas, ange dina Nightscout-uppgifter för att ansluta till din instans."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "To configure your CGM, tap the button below. In the form that opens, enter your Nightscout credentials to connect to your instance."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для налаштування CGM натисніть кнопку нижче. У формі, що відкриється, введіть облікові дані Nightscout для підключення до вашого екземпляра."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "To configure your CGM, tap the button below. In the form that opens, enter your Nightscout credentials to connect to your instance."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要配置您的 CGM，請點擊下面的按鈕。在彈出的表單中，輸入您的 Nightscout 憑證以連接到您的實例。"
          }
        }
      }
    },
    "To confirm, dial crown." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "To confirm, dial crown."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For at bekræfte, ringe krone."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um zu bestätigen, wählen Sie Krone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para confirmar, marca la corona."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour confirmer, composez la couronne."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "To confirm, dial crown."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per confermare, comporre la corona."
          }
        },
        "nb-NO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Å bekrefte, dreie kronen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Om te bevestigen, bel de kroon."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aby potwierdzić, wybieraj koronę."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para confirmar, divulgue."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "För att bekräfta, ringa krona."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "To confirm, dial crown."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для підтвердження нумерації номера корона."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "To confirm, dial crown."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "為了確認，請旋轉錶冠。"
          }
        }
