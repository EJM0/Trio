        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se è abilitata anche \"Display IOB e COB\", \"IOB\" e \"COB\" saranno sostituiti con le seguenti emoji:"
          }
        },
        "nb-NO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvis \"Display IOB and COB\" også er aktivert vil \"IOB\" og \"COB\" bli erstattet med følgende emojis:"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als \"IOB en COB weergeven\" ook is ingeschakeld, worden \"IOB\" en \"COB\" vervangen door de volgende emojis:"
