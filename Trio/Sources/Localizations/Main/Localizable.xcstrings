          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notera: Den här inställningen används endast om inställningarna \"Låga tillfälliga mål sänker känsligheten\" ELLER \"Höga tillfälliga. mål ökar känsligheten\" är aktiverade."
