    "Add one or more contacts to your iOS Contacts to display real-time Trio metrics on your watch face. Be sure to grant Trio full access to your Contacts when prompted." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أضف جهة اتصال واحدة أو أكثر إلى جهات الاتصال الخاصة بك في نظام التشغيل iOS لعرض مقاييس ثلاثية في الوقت الحقيقي على وجه الساعة الخاص بك. تأكد من منح ثلاثي الوصول الكامل إلى جهات الاتصال الخاصة بك عند مطالبتك."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tilføj en eller flere kontakter til dine iOS-kontakter for at få vist Trio-målinger i realtid på dit overvågningsansigt. Sørg for at give Trio fuld adgang til dine kontakter når du bliver bedt om det."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fügen Sie einen oder mehrere Kontakte zu Ihren iOS-Kontakten hinzu, um die Echtzeit-Trio-Metriken auf Ihrer Beobachtungsseite anzuzeigen. Vergewissern Sie sich, dass Trio vollen Zugriff auf Ihre Kontakte gewährt, wenn Sie aufgefordert werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade uno o más contactos a tus contactos de iOS para mostrar las métricas Trio en tiempo real en tu cara de reloj. Asegúrate de conceder a Trio acceso completo a tus contactos cuando se te solicite."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoutez un ou plusieurs contacts à vos contacts iOS pour afficher des métriques Trio en temps réel sur votre cadran de montre. Assurez-vous d’accorder à Trio un accès complet à vos Contacts lorsque vous y êtes invité."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiungi uno o più contatti ai tuoi Contatti iOS per visualizzare le metriche Trio in tempo reale sul tuo viso. Assicurati di concedere a Trio l'accesso completo ai tuoi contatti quando richiesto."
          }
        },
        "nb-NO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Legg til en eller flere kontakter til iOS-kontaktene for å vise måltall fra Trio i sanntid på din Apple Watch. Sørg for å gi Trio full tilgang til kontaktene dine når du blir bedt om det."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voeg een of meer contacten toe aan uw iOS Contacten om real-time Trio statistieken op uw horloge te tonen. Zorg ervoor dat Trio volledige toegang tot uw contactpersonen wordt verleend wanneer er om wordt gevraagd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodaj jeden lub więcej kontaktów do kontaktów iOS aby wyświetlić trio w czasie rzeczywistym na twarzy zegarka. Upewnij się, że Trio uzyska pełny dostęp do Twoich kontaktów, gdy zostaniesz o to poproszony."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adicione um ou mais contatos aos seus Contatos do iOS para exibir métricas Trio em tempo real no seu rosto. Certifique-se de conceder a Trio acesso total aos seus Contatos quando solicitado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Добавьте один или несколько контактов в контакты iOS, чтобы отображать трио в реальном времени на вашем экране часа. Не забудьте предоставить Трио полный доступ к вашим Контактам при появлении запроса."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Add one or more contacts to your iOS Contacts to display real-time Trio metrics on your watch face. Be sure to grant Trio full access to your Contacts when prompted."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lägg till en eller flera kontakter till dina iOS-kontakter för att visa mätvärden i realtid på din klocka ansikte. Var noga med att ge Trio full tillgång till dina kontakter när du blir ombedd."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Add one or more contacts to your iOS Contacts to display real-time Trio metrics on your watch face. Be sure to grant Trio full access to your Contacts when prompted."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Додайте один або кілька контактів до ваших контактів на iOS для відображення метрик в реальному часі на ваших очах з годинником. Запевніться, що перед отриманням виклику повністю доступ до ваших Контактів."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Add one or more contacts to your iOS Contacts to display real-time Trio metrics on your watch face. Be sure to grant Trio full access to your Contacts when prompted."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在您的 iOS 联系人中添加一个或多个联系人，以便在您的手表面上实时显示三个计量表。 请务必允许三重访问您的联系人。"
          }
        }
      }
    },
