          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette SI ajustée est temporaire, changera avec le prochain cycle de boucle et ne devrait pas être directement utilisée comme valeur de votre profil ISF."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "This adjusted ISF is temporary, will change with the next loop cycle, and should not be directly used as your profile ISF value."
          }
        },
        "it" : {
