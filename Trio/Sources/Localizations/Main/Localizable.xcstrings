    "Note: You can still manually bolus above this limit, but the suggested bolus amount will never exceed this in the bolus calculator." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Note: You can still manually bolus above this limit, but the suggested bolus amount will never exceed this in the bolus calculator."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bemærk: Du kan stadig manuelt bolus over denne grænse, men den foreslåede bolus mængde vil aldrig overstige dette i bolus regnemaskinen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hinweis: Du kannst noch manuell bolus oberhalb dieses Limits halten, aber der vorgeschlagene bolus Betrag wird dies im bolus calculator nie überschreiten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nota: Usted puede aún manualmente bolo por encima de este límite, pero la cantidad sugerida de bolo nunca excederá esto en la calculadora de bolos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remarque : Vous pouvez toujours manuellement le bolus au-delà de cette limite, mais la quantité de bolus suggéré ne dépassera jamais cela dans la calculatrice de bolus."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Note: You can still manually bolus above this limit, but the suggested bolus amount will never exceed this in the bolus calculator."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nota: Puoi ancora andare in bolo manualmente al di sopra di questo limite, ma la quantità di bolo suggerita non supererà mai questo nella calcolatrice in bolo."
          }
        },
        "nb-NO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Merk: Du kan fremdeles bolusdose manuelt over denne grensen, men den foreslåtte bolusdosen vil aldri overstige dette i boluskalkulatoren."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Let op: je kunt nog steeds handmatig bolus boven deze limiet instellen, maar de voorgestelde bolus hoeveelheid zal dit nooit overschrijden in de boluscalculator."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uwaga: Nadal możesz ręcznie bolus powyżej tego limitu, ale sugerowana ilość bolusa nigdy nie przekroczy tego w kalkulatorze bolusa."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nota: Você ainda pode manualmente bolus acima deste limite, mas o valor do bolus sugerido nunca irá exceder isso na calculadora do bolus."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obs: Du kan fortfarande manuellt bolus över denna gräns, men det föreslagna bolusbeloppet kommer aldrig att överskrida detta i boluskalkylatorn."
