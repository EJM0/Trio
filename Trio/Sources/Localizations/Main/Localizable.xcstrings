          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Predvolené nastavenie je false. Keď je true, zníži cieľový krvný cukor, keď \"autosens\" zistí rezistenciu"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
