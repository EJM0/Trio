    "This might be an intermittent problem, but please check that your transmitter is tightly secured over your sensor" : {
      "comment" : "This might be an intermittent problem, but please check that your transmitter is tightly secured over your sensor",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قد تكون هذه مشكلة متقطعة، ولكن يرجى التحقق من أن جهاز الإرسال الخاص بك مؤمن بشكل صارم على مستشعر"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dette kan være et periodisk problem, men tjek venligst at senderen er tæt fastgjort over din sensor"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dies könnte ein vorübergehendes Problem sein, bitte überprüfen Sie, ob Ihr Sender fest über Ihren Sensor befestigt ist"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This might be an intermittent problem, but please check that your transmitter is tightly secured over your sensor"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto podría ser un problema intermitente, pero por favor compruebe que su transmisor está firmemente asegurado sobre su sensor"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ceci peut être un problème intermittent, mais veuillez vérifier que votre transmetteur est bien positionné sur votre capteur"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo potrebbe essere un problema intermittente, ma sei pregato di verificare che il tuo trasmettitore sia strettamente protetto sul tuo sensore"
          }
        },
        "nb-NO" : {
          "stringUnit" : {
            "state" : "translated",
