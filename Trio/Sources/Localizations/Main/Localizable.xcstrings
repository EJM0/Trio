        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disminuir este ajuste puede resultar en más entradas de FPU con valores de glúcido más pequeños."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diminuer ce paramètre peut entraîner plus d'entrées FPU avec des valeurs de glucides plus petites."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Decreasing this setting may result in more FPU entries with smaller carb values."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diminuendo questa impostazione si possono ottenere più FPU con valori di carb più piccoli."
          }
        },
        "nb-NO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Å redusere denne innstillingen kan føre til flere FPU-oppføringer med mindre karboverdier."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vermindering van deze instelling kan leiden tot meer FPU ingangen met kleinere koolhydraten waarden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zmniejszenie tego ustawienia może skutkować zwiększeniem liczby wpisów FPU z mniejszymi wartościami węglowodanów."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Engolir essa configuração pode resultar em mais entradas FPU com valores de carb menores."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minskning av denna inställning kan resultera i fler FPU-poster med mindre kolhydratvärden."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Decreasing this setting may result in more FPU entries with smaller carb values."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Зменшення цього параметра може призвести до збільшення FPU записів з меншими значеннями для інтернету."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Decreasing this setting may result in more FPU entries with smaller carb values."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
