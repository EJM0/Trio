    "Add Preset or Override by tapping 'Add Override +' in the top right-hand corner of the screen." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إضافة الإعداد المسبق أو تجاوز عن طريق النقر على 'إضافة تجاوز +' في الجزء العلوي الأيمن من الشاشة."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tilføj forudindstillede eller Tilsidesæt ved at trykke på 'Tilføj Tilsidesæt +' i øverste højre hjørne af skærmen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voreinstellung oder Überschreibung hinzufügen, indem Sie in der rechten oberen Ecke des Bildschirms oben auf 'Überschreibung+' tippen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añadir Preselección o Anulación pulsando 'Añadir Anulación +' en la esquina superior derecha de la pantalla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajouter un préréglage ou un remplacement en appuyant sur « Ajouter une surcharge +» dans le coin supérieur droit de l'écran."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiungi Preset o Sovrascrivi premendo 'Aggiungi Override +' nell'angolo in alto a destra dello schermo."
          }
        },
        "nb-NO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Legg til forhåndsinnstilling eller justering ved å trykke «Legg til justering +» øverst til høyre."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voorinstelling toevoegen of overschrijven door op 'Override +' te tikken in de rechterbovenhoek van het scherm."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodaj ustawienie wstępne lub nadpisanie poprzez dotknięcie 'Dodaj nadpisanie +' w prawym górnym rogu ekranu."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adicione predefinição ou substitua tocando em 'Adicionar Substituição +' no canto superior direito da tela."
