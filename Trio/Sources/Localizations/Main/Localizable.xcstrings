        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeśli aktualna dawka bazowa wynosi 0,8 j./godz., a \"Super wartość procentowa bolusa\" jest ustawiona na 200%: 0. × (200 ~100) = 1,6 jednostek zostanie dodanych do rekomendacji bolusa."
          }
