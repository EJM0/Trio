    "This sets the maximum length of time that Fat and Protein Carb Equivalents (FPUs) will be extended over from a single Fat and/or Protein bolus calcultor entry." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "This sets the maximum length of time that Fat and Protein Carb Equivalents (FPUs) will be extended over from a single Fat and/or Protein bolus calcultor entry."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dette sætter den maksimale længde af tid, fedt og protein kulhydrater (FPU'er) vil blive forlænget over fra en enkelt fedt og/eller protein bolus calcultor indgang."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dies legt die maximale Zeitspanne fest, in der Fett- und Proteinkarb-Äquivalente (FPUs) von einem einzigen Fett- und/oder Proteinbolusrechner übertragen werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto establece la duración máxima de tiempo que Equivalentes de Carbohidratos de Grasa y Proteína (FPUs) se extenderán desde una sola entrada de calculadora de Grasa y/o Proteína."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cela définit la durée maximale de la prolongation des équivalents de graisses et de protéines en glucides (FPUs) à partir d'une seule entrée de calcul de bolus de graisses et/ou de protéines."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "This sets the maximum length of time that Fat and Protein Carb Equivalents (FPUs) will be extended over from a single Fat and/or Protein bolus calcultor entry."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo imposta il tempo massimo in cui gli equivalenti di Carb di Grasso e Proteina (FPUs) saranno estesi da una singola voce di calcultore in bolo di Grasso e/o Proteine."
          }
        },
        "nb-NO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dette angir den maksimale lengden for tid som «Fett- og protein karbyte» (FPUer) vil bli forlenget over fra én enkelt Fat og/eller protein boltkultur."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hiermee wordt de maximale tijdsduur van Fat en Protein koolhydraat Equivalenten (FPU's) verlengd met een enkele vet- en/of Protein boluscalculator."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ustawia to maksymalną długość czasu, w którym równoważniki tłuszczu i węglowodanów białkowych (FPU) zostaną przedłużone z pojedynczego kalkulatora tłuszczów i/lub białka."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isto define o período máximo de tempo que o equivalente a Gorduras e proteínas Carb (EFP) será alargado a partir de uma única entrada de cultivo de bólus e/ou proteínas."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Detta anger den maximala tidslängden som kolhydratersekvivalenter från fett- och protein (FPU) kommer att fördelas över efter en enskild måltidsregistrering med fett och/eller protein."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "This sets the maximum length of time that Fat and Protein Carb Equivalents (FPUs) will be extended over from a single Fat and/or Protein bolus calcultor entry."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Це встановлює максимальну тривалість часу, коли Пат і Protein Carb Equivalent (ФPU) будуть продовжені з одного Fat та/або бронебійного акаунта."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "This sets the maximum length of time that Fat and Protein Carb Equivalents (FPUs) will be extended over from a single Fat and/or Protein bolus calcultor entry."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這設定了單一脂肪和蛋白質碳水化合物相當物(FPU)從單一脂肪和/或蛋白質注射計算器條目延長的最大時間長度。"
          }
        }
      }
    },
    "This setting adjusts how much weight is given to your recent total daily insulin dose when calculating Dynamic ISF and Dynamic CR." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "This setting adjusts how much weight is given to your recent total daily insulin dose when calculating Dynamic ISF and Dynamic CR."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne indstilling justerer, hvor meget vægt der er givet til din seneste totale daglige insulindosis ved beregning af Dynamic ISF og Dynamic CR."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Einstellung legt fest, wieviel Gewicht bei der Berechnung von Dynamic ISF und Dynamic CR an die aktuelle tägliche Insulindosis übergeben wird."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este ajuste ajusta el peso que se le da a su dosis diaria de insulina al calcular el ISF dinámico y el CR dinámico."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce paramètre ajuste la quantité de poids donnée à votre récente dose quotidienne d'insuline lors du calcul de la SI Dynamique et du CR."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "This setting adjusts how much weight is given to your recent total daily insulin dose when calculating Dynamic ISF and Dynamic CR."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa impostazione regola quanto peso viene dato alla dose totale di insulina recente al giorno quando calcola Dynamic ISF e Dynamic CR."
          }
        },
        "nb-NO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne innstillingen justerer hvor mye vekt den seneste totale daglige insulindosen når du beregner Dynamisk ISF og Dynamisk CR."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze instelling past hoeveel gewicht wordt gegeven aan uw recente totale dagelijkse insuline dosis bij het berekenen van de dynamische ISF en Dynamische CR."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To ustawienie dostosowuje masę ciała pacjenta do ostatniej całkowitej dobowej dawki insuliny przy obliczaniu dynamicznego ISF i dynamicznego CR."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
