    "Note to Medtronic Pump Users: You must also manually set the max basal rate on the pump to this value or higher." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ملاحظة إلى مستخدمي Medtronic Pump : يجب عليك أيضًا تعيين المعدل الأساسي الأقصى يدويًا على المضخة إلى هذه القيمة أو أعلى."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bemærk til Medtronic Pump brugere: Du skal også manuelt indstille den maksimale basal rate på pumpen til denne værdi eller højere."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hinweis an Benutzer der Medtronic Pumpen: Sie müssen die maximale Basalrate der Pumpe auch manuell auf diesen Wert oder höher setzen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Note to Medtronic Pump Users: You must also set the max basal rate on the pump to this value or higher ."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Note aux utilisateurs de la pompe Medtronic : Vous devez également définir manuellement le débit de base maximum sur la pompe à cette valeur ou plus."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nota agli utenti della pompa Medtronic: È necessario impostare manualmente la velocità basale massima sul microinfusore a questo valore o superiore."
          }
        },
        "nb-NO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Merk til Medtronic Pump Brukere: Du må også sette maks basal rate manuelt på pumpen til denne verdien eller høyere."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opmerking voor Medtronic Pomp Gebruikers: Je moet ook handmatig de maximale basaalstand van de pomp op deze waarde of hoger zetten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uwaga dla użytkowników pompy Medtronic: Musisz również ręcznie ustawić maksymalną dawkę bazową na pompie na tę wartość lub wyższą."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nota para os usuários da Bomba Medtronica: Você também deve definir manualmente o valor máximo da basal na bomba para este valor ou superior."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Примечание для пользователей Medtronic Pump Users: Вы также должны вручную установить максимальную базовую скорость насоса в это значение или выше."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Note to Medtronic Pump Users: You must also manually set the max basal rate on the pump to this value or higher."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obs till Medtronic Pump Användare: Du måste också manuellt ställa in den maximala basalhastigheten på pumpen till detta värde eller högre."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Note to Medtronic Pump Users: You must also manually set the max basal rate on the pump to this value or higher."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Зверніть увагу на користувачів Medtronic Pump: Ви також повинні вручну встановити макс. базову швидкість на насосі або вище значення."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Note to Medtronic Pump Users: You must also manually set the max basal rate on the pump to this value or higher."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "注意到Medelectronic Pump 用户：您也必须手动设置泵上的最大基本率到这个值或更高值。"
          }
        }
      }
    },
    "Note: A CGM is considered noisy when it provides inconsistent readings." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ملاحظة: تعتبر اللجنة المركزية المعنية بمركز المرأة ضوضاء عندما تقدم قراءات غير متسقة."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bemærk: Et CGM betragtes som støjende, når det giver inkonsekvente aflæsninger."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hinweis: Ein CGM wird als lärmig, wenn es inkonsistente Lesungen bereitstellt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nota: Un CGM se considera ruidoso cuando proporciona lecturas inconsistentes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Note : Une MGC est considérée comme bruyante lorsqu'elle fournit des lectures incohérentes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nota: Una CGM è considerata rumorosa quando fornisce letture incoerenti."
          }
        },
        "nb-NO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Merk: En CGM anses for å være støyende når den gir ukonsekvente avlesninger."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opmerking: een CGM wordt beschouwd als lawaaierig wanneer het inconsistente metingen bevat."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uwaga: CGM jest uważany za głośny, gdy zapewnia niespójne odczyty."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nota: Um CGM é considerado barulho quando fornece leituras inconsistentes."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Примечание: КГМ считается шумным, когда он обеспечивает непоследовательное чтение."
          }
