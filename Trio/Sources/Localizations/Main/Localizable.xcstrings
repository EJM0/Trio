    "At the default setting, 35% of the calculation is based on the last 24 hours of insulin use, with the remaining 65% considering the last 10 days of data." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "At the default setting, 35% of the calculation is based on the last 24 hours of insulin use, with the remaining 65% considering the last 10 days of data."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ved standardindstillingen er 35% af beregningen baseret på de sidste 24 timers insulinanvendelse. med de resterende 65 % i betragtning af de sidste 10 dage af data."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In der Standardeinstellung basiert die Berechnung zu 35 % auf den letzten 24 Stunden des Insulinverbrauchs, während die restlichen 65 % die Daten der letzten 10 Tage berücksichtigen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En la configuración predeterminada, el 35% del cálculo se basa en las últimas 24 horas de uso de insulina, con el 65% restante considerando los últimos 10 días de datos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lors du réglage par défaut, 35% du calcul est basé sur les dernières 24 heures d'utilisation d'insuline, avec les 65% restants en tenant compte des 10 derniers jours de données."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "At the default setting, 35% of the calculation is based on the last 24 hours of insulin use, with the remaining 65% considering the last 10 days of data."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nella impostazione predefinita, il 35% del calcolo si basa sulle ultime 24 ore di uso di insulina, con il restante 65% considerando gli ultimi 10 giorni di dati."
          }
        },
        "nb-NO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ved standard innstilling vil 35% av beregningen baseres på de siste 24 timene med insulin, mens de resterende 65% baserer seg på de siste 10 dagene med insulin."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bij de standaardinstelling is 35 procent van de berekening gebaseerd op de laatste 24 uur van het gebruik van insuline de resterende 65 procent overweegt de laatste 10 dagen van de gegevens."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przy domyślnym ustawieniu 35% kalkulacji opiera się na ostatnich 24 godzinach stosowania insuliny. pozostałe 65% z uwzględnieniem ostatnich 10 dni danych."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na configuração padrão, 35% do cálculo é baseado nas últimas 24 horas de uso de insulina, com os 65% restantes considerando os últimos 10 dias de dados."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vid standardinställningen baseras 35% av beräkningen på de senaste 24 timmarna av insulinanvändningen, med resterande 65% med tanke på de senaste 10 dagarna av data."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "At the default setting, 35% of the calculation is based on the last 24 hours of insulin use, with the remaining 65% considering the last 10 days of data."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "За замовчуванням, 35% обчислень базується на останніх 24 годин інсуліну з урахуванням останніх 10 днів даних, що залишилися на 65%."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "At the default setting, 35% of the calculation is based on the last 24 hours of insulin use, with the remaining 65% considering the last 10 days of data."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在預設設定下，計算的 35% 基於過去 24 小時的胰島素使用，剩餘 65% 考慮過去 10 天的資料。"
          }
        }
      }
    },
