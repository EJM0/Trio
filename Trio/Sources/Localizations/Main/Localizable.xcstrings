        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自動敏感度比率用於計算基礎胰島素率、胰島素敏感度因子 (ISF) 和碳水化合物比率 (CR) 所需的調整量。"
          }
        }
      }
    },
