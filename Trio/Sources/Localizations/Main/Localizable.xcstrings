        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dit aangepaste ISF is tijdelijk en zal veranderen met de volgende luscyclus, en zou niet direct als ISF-waarde moeten worden gebruikt."
