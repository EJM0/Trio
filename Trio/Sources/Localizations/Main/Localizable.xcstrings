        },
        "nb-NO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvis din nåværende basalrate er 0,8 E/time og \"Super Bolus percentage\" er satt til 200%: 0. × (200 ÷ 100) = 1,6 enheter legges til bolusanbefalingen din."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wanneer je basaalstand 0,8 E/uur is en \"Super Bolus Percentage\" is ingesteld op 200%: 0. × (200~100) = 1.6 eenheden worden toegevoegd aan je aanbeveling voor bolus."
          }
