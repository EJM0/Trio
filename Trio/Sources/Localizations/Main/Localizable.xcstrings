    "Insulin Sensitivities cover 24 hours. You cannot add more rates. Please remove or adjust existing rates to make space." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حساسيات الإنسولين تغطي 24 ساعة. لا يمكنك إضافة المزيد من الأسعار. يرجى إزالة أو تعديل الأسعار الحالية لجعل المساحة."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Insulin Følsomheder dækker 24 timer. Du kan ikke tilføje flere priser. Fjern eller juster de eksisterende priser for at gøre plads."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Insulinempfindlichkeiten decken 24 Stunden ab. Sie können nicht mehr Sätze hinzufügen. Bitte entferne oder ändere die bestehenden Sätze um Platz zu schaffen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las sensibilidades de insulina cubren 24 horas. No puedes añadir más tasas. Por favor, elimina o ajusta las tarifas existentes para crear espacio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les sensibilités à l'insuline couvrent 24 heures. Vous ne pouvez pas ajouter plus de taux. Veuillez supprimer ou ajuster les tarifs existants pour faire de l'espace."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le Sensibilità di Insulina coprono 24 ore. Non è possibile aggiungere più tassi. Si prega di rimuovere o modificare le tariffe esistenti per creare spazio."
          }
        },
        "nb-NO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Insulin Aktiviteter dekker 24 timer. Du kan ikke legge til flere priser. Fjern eller juster eksisterende priser for å lage plass."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De insuline gevoeligheden bestrijken 24 uur. U kunt niet meer tarieven toevoegen. Verwijder of pas de huidige tarieven aan om ruimte te maken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wrażliwość na insulinę obejmuje 24 godziny. Nie można dodać więcej szybkości. Proszę usunąć lub dostosować istniejące szybkości, aby zrobić miejsce."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As Sensibilidade da insulina cobrem 24 horas. Você não pode adicionar mais taxas. Por favor, remova ou ajuste as taxas existentes para liberar espaço."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Инсультирование охватывает 24 часа. Вы не можете добавить дополнительные тарифы. Пожалуйста, удалите или измените существующие тарифы, чтобы освободить место."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Insulin Sensitivities cover 24 hours. You cannot add more rates. Please remove or adjust existing rates to make space."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Insulinkänslighet täcker 24 timmar. Du kan inte lägga till fler priser. Ta bort eller justera befintliga priser för att göra utrymme."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Insulin Sensitivities cover 24 hours. You cannot add more rates. Please remove or adjust existing rates to make space."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чутливість враховує 24 години. Ви не можете додати більше курсів. Будь ласка, видаліть або налаштуйте наявні ставки, щоб створити місце."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Insulin Sensitivities cover 24 hours. You cannot add more rates. Please remove or adjust existing rates to make space."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "防硫敏感度覆盖24小时。您不能添加更多的费率。请删除或调整现有费率以腾出空间。"
          }
        }
      }
    },
