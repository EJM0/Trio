    "Min 5m Carb Impact sets the expected glucose rise from carbs over 5 minutes when absorption isn't obvious from glucose data." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Min 5m Carb Impact sets the expected glucose rise from carbs over 5 minutes when absorption isn't obvious from glucose data."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Min 5m Carb Impact indstiller den forventede stigning i glukose fra kulhydrater over 5 minutter, når absorptionen ikke er indlysende fra glukosedata."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Min. 5 m Carb Impact setzt den erwarteten Glukoseanstieg von Kohlenhydraten über 5 Minuten, wenn die Absorption aus den Glukosedaten nicht ersichtlich ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impacto mínimo de 5 m del Carbo establece el aumento esperado de la glucosa de los carbohidratos en 5 minutos cuando la absorción no es obvia de los datos de la glucosa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'impact minimal de 5 m sur les glucides définit la hausse prévue du glucose à partir des glucides sur 5 minutes lorsque l'absorption n'est pas évidente à partir des données du glucose."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Min 5m Carb Impact sets the expected glucose rise from carbs over 5 minutes when absorption isn't obvious from glucose data."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Min 5m Carb Impact imposta l'aumento atteso di glucosio dai carboidrati in 5 minuti quando l'assorbimento non è evidente dai dati relativi al glucosio."
          }
        },
        "nb-NO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Min 5m karbo støt setter den forventede glukosen opp fra karbohydrater over 5 minutter når absorpsjonen ikke er tydelig fra glukosedata."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Min 5 m koolhydraten Impact stelt de verwachte glucosestijging in vanaf koolhydraten ouder dan 5 minuten wanneer absorptie niet zichtbaar is uit glucosegegevens."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Min 5m Wpływ węglowodanów ustawia oczekiwany wzrost glukozy z węglowodanów w ciągu 5 minut, gdy wchłanianie nie jest oczywiste na podstawie danych dotyczących glukozy."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mínimo de 5 metros de impacto Carb define o aumento de glicose esperado dos carbs em 5 minutos quando a absorção não é óbvia a partir dos dados de glicose."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'Minsta kolhydratpåverkan på 5 m' sätter den förväntade glukosökningen från kolhydrater över 5 minuter när absorption inte är uppenbart från glukosdata."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Min 5m Carb Impact sets the expected glucose rise from carbs over 5 minutes when absorption isn't obvious from glucose data."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Мін. 5м Карб впливає на очікуване підвищення глюкози з карб більше 5 хвилин, коли поглинання не очевидні з даних глюкози."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "new",
