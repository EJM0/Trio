    "To disable smoothing, go to Settings > Devices > Continuous Glucose Monitor > Smooth Glucose Value and toggle off the setting." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لتعطيل السلسلة، انتقل إلى الإعدادات > الأجهزة > مراقب الجلوكوز المستمر > قيمة جلوكوز السلس وتبديل الإعداد."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For at deaktivere udjævning, gå til Indstillinger > Enheder > Kontinuerlig glukose skærm > Glat glukose værdi og slå indstillingen fra."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um Glätten zu deaktivieren, gehen Sie auf Einstellungen > Geräte > Kontinuierlicher Glukose-Monitor > Glättungswert und schalten die Einstellung aus."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para desactivar el alisado, vaya a Ajustes > Dispositivos > Glucosa Continua Monitor> Suavizado Valor de Glucosa y desactive la configuración."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour désactiver le lissage, allez dans Réglages > Périphériques > Moniteur de glycémie continu > Valeur de glycémie lisse et désactivez le paramètre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per disabilitare la levigatura, vai in Impostazioni > Dispositivi > Monitor Glicemia Continuo > Liscia il Valore Glicemia e disattiva l'impostazione."
          }
        },
        "nb-NO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For å deaktivere jevn, gå til Innstillinger > Enheter > Kontinuerlig Glukosemåte > Røyk Glukoseverdi og slå av innstillingen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Om vloeiend uit te schakelen, ga naar Instellingen > Apparaten > Continue Glucose Monitor > Smooth Glucose Waarde en schakel de instelling uit."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aby wyłączyć wygładzanie, przejdź do Ustawienia > Urządzenia > Monitor glukozy ciągłej> Wartość glukozy gładkiej i wyłącz ustawienie."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para desativar a suavidade, vá para Configurações > Dispositivos > Monitoramento de Glucose Contínuo > Valor de Glucose Suave e desative a configuração."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чтобы отключить сглаживание, перейдите в Настройки > Устройства > Непрерывный Glucose Monitor > Smooth Value и переключите настройки."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "To disable smoothing, go to Settings > Devices > Continuous Glucose Monitor > Smooth Glucose Value and toggle off the setting."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "För att inaktivera utjämning, gå till Inställningar > Enheter > Kontinuerlig Glukos-bildskärm > Mjuk glukosvärde och växla bort inställningen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "To disable smoothing, go to Settings > Devices > Continuous Glucose Monitor > Smooth Glucose Value and toggle off the setting."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Щоб відключити плавно, перейдіть до Налаштувань > пристроїв > Безперервний монітор Glucose > Smooth Glucose Значення і вимкніть налаштування."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "To disable smoothing, go to Settings > Devices > Continuous Glucose Monitor > Smooth Glucose Value and toggle off the setting."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "若要禁用平滑，请前往设置 > 设备 > 连续血糖监视器 > 平滑血糖值，并切换设置。"
          }
        }
      }
    },
