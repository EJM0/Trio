    "• Default: Single 'primary' value with up to two smaller values ('Top', 'Bottom') above and below it." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• По подразбиране: Единична „основна“ стойност с до две по-малки стойности („Нагоре“, „Надолу“) над и под нея."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Standard: Enkelt 'primær' værdi med op til to mindre værdier ('Top', 'Bottom') over og under det."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Standard: Einfacher 'Primär'-Wert mit bis zu zwei kleineren Werten ('Oben', 'Unten') oberhalb und unterhalb von diesem."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Predeterminado: Valor único 'primario' con hasta dos valores más pequeños ('Top', 'Bottom') por encima y por debajo de él."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Par défaut: Seule valeur 'primaire' avec jusqu'à deux valeurs plus petites ('Haut', 'Bas') au-dessus et au-dessous."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• ברירת מחדל: ערך ‘ראשי’ יחיד עם עד שני ערכים קטנים יותר (‘עליון’ ו’תחתון’) מעליו ומתחתיו."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Predefinito: singolo valore 'primario' con un massimo di due valori più piccoli ('Alto', 'Basso') sopra e sotto di esso."
          }
        },
        "nb-NO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Standard: Enkel 'primær' verdi med opptil to mindre verdier ('Topp', 'Bunn') over og under den."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Standaard: Enkele 'primaire' waarde met maximaal twee kleinere waarden ('Boven', 'Bottom') boven en onder."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Domyślnie: Pojedyncza 'podstawowa' wartość z maksymalnie dwiema mniejszymi wartościami ('Góra, 'Dół') powyżej i poniżej niego."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Padrão: um único valor 'primário' com até dois valores menores ('Topo', 'Bottom') acima e abaixo dele."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Standard: Enkelt primärvärde med upp till två mindre värden ('Övre', 'Nedre') ovanför och under det."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "• Default: Single 'primary' value with up to two smaller values ('Top', 'Bottom') above and below it."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• За замовчуванням: єдине \"primary\" значення з двома меншими значеннями ('Зверху', 'Нижня межа') вище та нижче його."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "• Default: Single 'primary' value with up to two smaller values ('Top', 'Bottom') above and below it."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• 預設: 單一「主要」值，並可有兩個較小的值（「上」、「下」）在其上方和下方。"
          }
        }
      }
    },
