            "state" : "translated",
            "value" : "Passen Sie die Breite und Gap des Rings genau nach Ihren Designvorlieben an."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajusta el anillo y el hueco para adaptarse a tus preferencias de diseño."
          }
        },
        "fr" : {
