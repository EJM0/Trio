    "Change Pod now. Insulin delivery will stop in %1$@ or when no more insulin remains." : {
      "comment" : "Format string for the action string on pod status page when pod expired. (1: service time remaining)",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تغيير بود الآن. سيتم إيقاف توصيل الإنسولين في %1$@ أو عندما لا يبقى الأنسولين بعد الآن."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skift Pod nu. Levering af insulin vil stoppe i %1$@ eller når der ikke er mere insulin tilbage."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wechsle jetzt den Pod! Die Insulinabgabe wird in %1$@ unterbrochen, spätestens wenn kein Insulin mehr vorhanden ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Change Pod now. Insulin delivery will stop in %1$@ or when no more insulin remains."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cambia el Pod ahora. La entrega de insulina se detendrá en %1$@ o cuando no quede más insulina."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Changez de Pod maintenant. La distribution d'insuline s'arrêtera dans %1$@ ou quand il n'y aura plus d'insuline."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cambiare Pod adesso. L' erogazione d'insulina si interromperà tra %1$@ o quando non ci sarà più insulina nel serbatoio."
          }
        },
        "nb-NO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bytt pod nå. Insulintilførselen stopper om %1$@, eller når det er tomt for insulin."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verander Pod nu. Insuline levering stopt over %1$@ of wanneer er geen insuline meer over is."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zmień teraz Pod. Podawanie insuliny zatrzyma się w %1$@ lub gdy nie będzie więcej insuliny."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alterar Pod agora. A entrega de insulina irá parar em %1$@ ou quando não houver mais insulina permanecer."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Замените Под сейчас. Подача инсулина будет остановлена спустя %1$@ или когда резервуар будет пуст."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihneď vymeniť pod. Podávanie inzulínu sa zastaví o %1$@ alebo keď sa minie inzulín."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Byt podd nu. Insulintillförsel kommer att stoppas om %1$@ eller när insulinet är slut."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Change Pod now. Insulin delivery will stop in %1$@ or when no more insulin remains."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Змініть Pod зараз. Введення інсуліну припиниться через %1$@ або коли інсулін закінчиться."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thay pod ngay. Insulin sẽ ngưng tiêm trong %1$@ hoặc khi không còn insulin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "现在更改Pod 。硫化物将在 %1$@ 中停止传送，或在没有更多的隔绝状态时停止传送。"
          }
        }
      }
    },
