    "Most set this to their largest meal bolus. Then, adjust if needed." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Most set this to their largest meal bolus. Then, adjust if needed."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De fleste sæt dette til deres største måltid bolus. Juster derefter, hvis det er nødvendigt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die meisten setzen dies auf ihren größten Mahlzeitenbolus. Dann passen Sie bei Bedarf an."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La mayoría establece esto en su bolo de comida más grande. Luego, ajuste si es necesario."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La plupart ont défini ceci à leur plus grand bolus de repas. Ensuite, ajustez si nécessaire."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Most set this to their largest meal bolus. Then, adjust if needed."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La maggior parte impostare questo al loro bolo pasto più grande. Quindi, regolare, se necessario."
          }
        },
        "nb-NO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mest sett dette til de største måltidene sine. Deretter må du justere ved behov."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stel dit meestal in op hun grootste maaltijd bolus. Pas vervolgens aan indien nodig."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Większość z nich ustawia to na największy bolus. Następnie, w razie potrzeby dostosować."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A maioria definiu isso como seu maior bolus de refeição. Então, ajuste se necessário."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De flesta ställa in detta att motsvara sin största måltidsbolus. Justera därefter efter behov."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Most set this to their largest meal bolus. Then, adjust if needed."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Більшість це поставили під свій найбільший набір болтів для їжі."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Most set this to their largest meal bolus. Then, adjust if needed."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "大多數人會將此設置為他們最大的餐前注射。然後根據需要進行調整。"
          }
        }
      }
    },
