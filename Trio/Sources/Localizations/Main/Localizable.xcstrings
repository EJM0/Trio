    },
    "This setting helps the system estimate how much glucose your body is absorbing, even when it's not immediately visible in your glucose data, ensuring more accurate insulin dosing during carb absorption." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هذا الإعداد يساعد النظام على تقدير كمية الجلوكوز التي تمتص جسمك، حتى عندما لا تكون مرئية على الفور في بيانات الجلوكوز الخاصة بك، ضمان جرعة أنسولين أكثر دقة أثناء امتصاص السيارة."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne indstilling hjælper systemet med at vurdere, hvor meget glukose din krop absorberer, selv når det ikke umiddelbart er synligt i dine glukosedata, sikrer en mere præcis insulindosering under absorptionen af kulhydraterne."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Einstellung hilft dem System zu beurteilen, wie viel Glukose Ihr Körper absorbiert, auch wenn es in Ihren Glukose-Daten nicht sofort sichtbar ist, um eine genauere Insulindosierung während der Kohlendioxidabsorption zu gewährleisten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este ajuste ayuda al sistema a estimar cuánta glucosa está absorbiendo, incluso cuando no es visible inmediatamente en sus datos de glucosa, garantizando una dosis de insulina más precisa durante la absorción de glúcidos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce paramètre aide le système à estimer la quantité de glucose absorbée par votre corps, même s'il n'est pas immédiatement visible dans vos données de glucose, ce qui garantit une dose d'insuline plus précise pendant l'absorption des glucides."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa impostazione aiuta il sistema a stimare quanto glucosio il vostro corpo sta assorbendo, anche quando non è immediatamente visibile nei dati relativi al glucosio, garantendo una dose di insulina più accurata durante l’assorbimento del carboidrato."
          }
        },
        "nb-NO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne innstillingen hjelper systemet med å anslå hvor mye glukose kroppen din absorberer, selv om det ikke er synlig i glukosedataene dine, pass på en mer nøyaktig insulindosering under karbohydratabsorpsjonen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze instelling helpt bij het inschatten van de hoeveelheid glucose die je lichaam absorbeert, Zelfs wanneer de insulinedosis niet direct zichtbaar is in jouw glucosegegevens, wat zorgt voor nauwkeurigere insulinedozing tijdens het opnemen van koolhydraten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To ustawienie pomaga systemowi oszacować, ile glukozy wchłania organizm, nawet jeśli nie jest on bezpośrednio widoczny w danych dotyczących glukozy, zapewniając dokładniejsze dawkowanie insuliny podczas wchłaniania węglowodanów."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta configuração ajuda o sistema a estimar quanta glicose seu corpo está absorvendo, Mesmo quando não estiver imediatamente visível em seus dados de glicose, garantindo uma dosagem de insulina mais precisa durante a absorção de carbos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Эта настройка помогает системе оценить, сколько глюкозы поглощает ваше тело, даже если это не сразу видно в данных о глюкозах, обеспечивая более точное дозирование инсулина при абсорбции углеводов."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "This setting helps the system estimate how much glucose your body is absorbing, even when it's not immediately visible in your glucose data, ensuring more accurate insulin dosing during carb absorption."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denna inställning hjälper systemet uppskatta hur mycket glukos din kropp absorberar, även när det inte omedelbart syns i dina glukosdata, vilket säkerställer mer exakt insulindosering under kolhydratabsorption."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "This setting helps the system estimate how much glucose your body is absorbing, even when it's not immediately visible in your glucose data, ensuring more accurate insulin dosing during carb absorption."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Цей параметр допомагає системі оцінити, скільки глюкози вашого тіла поглинає, навіть коли його не видно у вашій інформації про глюкозу, забезпечення точнішого досингу інсуліну під час поглинання тесла."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "This setting helps the system estimate how much glucose your body is absorbing, even when it's not immediately visible in your glucose data, ensuring more accurate insulin dosing during carb absorption."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这个设置帮助系统估计您身体吸收的血糖量， 即使在您的血糖数据中无法立即看到它，也会确保在吸附过程中更准确的绝缘剂量。"
          }
        }
      }
    },
    "This setting is limited to values between %@ - %@ %@" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
