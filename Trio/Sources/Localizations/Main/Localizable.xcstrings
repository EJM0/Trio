    "Gradient Purple = As readings approach and exceed above target, they become more purple." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Gradient Purple = As readings approach and exceed above target, they become more purple."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gradient Purple = Som aflæsninger nærmer sig og overstiger over målet, bliver de mere lilla."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gradient Purple = Als Messwerte nähern und überschreiten sie oberhalb des Ziels, werden sie violetter."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gradient Morado = A medida que las lecturas se acercan y superan el objetivo, se vuelven más moradas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dégradé violet = Au fur et à mesure que les lectures approchent et dépassent la cible, elles deviennent plus violeuses."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Gradient Purple = As readings approach and exceed above target, they become more purple."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viola gradiente = Come le letture si avvicinano e superano il bersaglio, diventano più viola."
          }
        },
        "nb-NO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gradient lilla = Når blodsukkeret nærmer seg og overstiger målet, blir fargen mer lilla."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kleurovergang Paars = Als lezingen benaderen en hoger zijn dan het streefdoel, worden ze paars."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gradient Fiolet = Gdy odczyty zbliżają się i przekraczają cel, stają się bardziej fioletowe."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gradiente Roxo = À medida que as leituras se aproximam e excedem o alvo acima, elas se tornam mais roxas."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lila gradient = När mätningarna är över mål blir de mer lila."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Gradient Purple = As readings approach and exceed above target, they become more purple."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Градієнт фіолетовий = Коли читання наближається і перевищує ціль, вони стають більш фіолетовими."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Gradient Purple = As readings approach and exceed above target, they become more purple."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "漸變紫色 = 隨著讀取值接近並超過目標時，顏色變得越來越紫色。"
          }
        }
      }
    },
    "Gradient Red = As readings approach and exceed below target, they gradually become more red." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Gradient Red = As readings approach and exceed below target, they gradually become more red."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gradient Red = Som aflæsninger nærmer sig og overstiger under målet, bliver de gradvist mere røde."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gradient Rot = Als Messwerte nähern und unter dem Ziel übertreffen, werden sie nach und nach rot."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gradiente Rojo = A medida que las lecturas se acercan y superan el objetivo, gradualmente se vuelven más rojas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gradient rouge = Au fur et à mesure que les lectures approchent et dépassent sous la cible, elles deviennent progressivement plus rouges."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Gradient Red = As readings approach and exceed below target, they gradually become more red."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gradiente Rosso = Con l'avvicinarsi delle letture e superare il bersaglio, diventano gradualmente più rossi."
          }
        },
        "nb-NO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gradient rød = Når blodsukkeret nærmer seg og overstiger målet, blir fargen mer rød."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kleurovergang Red = Als lezingen in de buurt komen en onder het streefdoel overvallen, worden ze langzamerhand rood."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Czerwień gradientowa = Gdy odczyty zbliżają się i przekraczają poniżej celu, stopniowo stają się coraz bardziej czerwone."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gradiente Vermelho = Como as leituras se aproximam e excedem o alvo abaixo, eles gradualmente se tornam mais vermelhos."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Röd gradient = När mätningarna är under mål blir de rödare."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Gradient Red = As readings approach and exceed below target, they gradually become more red."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Градієнт червоний = Коли читачі підходять і перевищують ціль, вони поступово стають червонішими."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Gradient Red = As readings approach and exceed below target, they gradually become more red."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "漸變紅色 = 隨著讀取值接近並低於目標時，顏色逐漸變得越來越紅色。"
          }
        }
      }
    },
