    "Limits temporary basal rates to this percentage of the current basal rate." : {
      "comment" : "Mini Hint for Current Basal Safety Multiplier",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Limits temporary basal rates to this percentage of the current basal rate."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Begræns midlertidige basale satser til denne procentdel af den nuværende basale sats."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Begrenzt vorübergehende Basissteuersätze auf diesen Prozentsatz des aktuellen Basiskurses."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Limita las tasas basales temporales a este porcentaje de la tasa basal actual."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Limite les taux de basal temporaires à ce pourcentage du taux de basal actuel."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Limits temporary basal rates to this percentage of the current basal rate."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
