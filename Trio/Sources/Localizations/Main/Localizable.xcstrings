    },
    "The Fat and Protein Delay setting defines the time between when you log fat and protein and when the system starts delivering insulin for the Fat-Protein Unit Carb Equivalents (FPUs)." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The Fat and Protein Delay setting defines the time between when you log fat and protein and when the system starts delivering insulin for the Fat-Protein Unit Carb Equivalents (FPUs)."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indstillingen af fedt- og proteinforsinkelse definerer tiden mellem når du logger fedt og protein, og når systemet begynder at levere insulin til fedt- proteinenheden Carb Equivalents (FPU'er)."
          }
        },
        "de" : {
          "stringUnit" : {
