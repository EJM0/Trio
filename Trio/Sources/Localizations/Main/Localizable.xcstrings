    "There are also options to override your Max SMB Minutes and Max UAM SMB Minutes, as well as to disable SMBs." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "There are also options to override your Max SMB Minutes and Max UAM SMB Minutes, as well as to disable SMBs."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der er også muligheder for at tilsidesætte din Max SMB Minutter og Max UAM SMB Minutes, samt at deaktivere SMB'er."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es gibt auch Optionen, Ihre Max-SMB Minuten und Max UAM SMB Minuten zu überschreiben sowie die SMB zu deaktivieren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "También hay opciones para anular los minutos máximos de SMB y UAM SMB, así como para desactivar SMBs."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il y a également des options pour remplacer vos Max SMB Minutes et Max UAM SMB Minutes, ainsi que pour désactiver les SMB."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "There are also options to override your Max SMB Minutes and Max UAM SMB Minutes, as well as to disable SMBs."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ci sono anche opzioni per sovrascrivere il massimo SMB minuti e massimo UAM SMB minuti, così come per disabilitare le SMB."
          }
        },
        "nb-NO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det er også alternativer for å overstyre din Maks SMB Minutter og Max UAM SMB Minutter, samt for å deaktivere SMBer."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er zijn ook opties om uw Max SMB minuten en Max UAM SMB minuten te overschrijven, evenals om SMB uit te schakelen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Istnieją również opcje nadpisywania twoich minut Max SMB i Max UAM SMB, a także wyłączenie SMB."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Há também opções para substituir as suas Minutos Max SMB e Minutos Max UAM SMB, bem como desativar SMBs."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det finns också alternativ för att ersätta dina Max SMB Minuter och Max UAM SMB Minuter, samt att inaktivera SMBs."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "There are also options to override your Max SMB Minutes and Max UAM SMB Minutes, as well as to disable SMBs."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Також є варіанти перевизначення вашого максимального SMB хвилин і Max UAM Minutes, а також вимкнення SMB."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "There are also options to override your Max SMB Minutes and Max UAM SMB Minutes, as well as to disable SMBs."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "還可以選擇覆蓋您的最大SMB分鐘和最大UAM SMB分鐘，並且可以停用SMBs。"
          }
        }
      }
    },
    "There has been no empirical data analysis to support the use of the Sigmoid Formula for dynamic sensitivity determination." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "There has been no empirical data analysis to support the use of the Sigmoid Formula for dynamic sensitivity determination."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der har ikke været nogen empirisk dataanalyse til støtte for brugen af Sigmoid Formula til dynamisk sensitivitetsbestemmelse."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es gibt keine empirische Datenanalyse, um den Einsatz der Sigmoid-Formel zur dynamischen Empfindlichkeitsbestimmung zu unterstützen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No ha habido ningún análisis empírico de datos para apoyar el uso de la Fórmula Sigmoide para la determinación de la sensibilidad dinámica."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il n'y a pas eu d'analyse empirique de données pour supporter l'utilisation de la formule Sigmoid pour la détermination de la sensibilité dynamique."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "There has been no empirical data analysis to support the use of the Sigmoid Formula for dynamic sensitivity determination."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non vi è stata alcuna analisi empirica dei dati a supporto dell'uso della formula Sigmoid per la determinazione della sensibilità dinamica."
          }
        },
        "nb-NO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det har ikke vært noen empirisk dataanalyse som støtter bruk av Sigmoidformel for dynamisk følsomhetsbestemmelse."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er is geen empirische gegevensanalyse geweest ter ondersteuning van het gebruik van de Sigmoid Formule voor een dynamische gevoeligheid."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie przeprowadzono analizy danych empirycznych na poparcie stosowania preparatu Sigmoid Formuła do oznaczania wrażliwości dynamicznej."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não houve nenhuma análise empírica de dados para apoiar o uso da Fórmula de Sigmoid para uma determinação dinâmica de sensibilidade."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det har inte gjorts någon empirisk dataanalys för att stödja användningen av Sigmoidformeln för dynamisk känslighetsbestämning."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "There has been no empirical data analysis to support the use of the Sigmoid Formula for dynamic sensitivity determination."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не було емпіричного аналізу даних для підтримки використання формули сигмоїду для визначення динамічної чутливості."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "There has been no empirical data analysis to support the use of the Sigmoid Formula for dynamic sensitivity determination."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "尚未進行實證數據分析以支持使用S型公式來確定動態敏感度。"
          }
        }
      }
    },
