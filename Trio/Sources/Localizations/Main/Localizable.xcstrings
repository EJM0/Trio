    "See a live preview of your contact image design at the top of the screen. Changes made to styles, layouts, or settings are instantly reflected." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "شاهد معاينة حية لتصميم صورة جهة الاتصال الخاصة بك في الجزء العلوي من الشاشة. التغييرات المدخلة على الأنماط، أو التخطيطات أو الإعدادات تظهر على الفور."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se en live forhåndsvisning af dit kontaktbillede design øverst på skærmen. Ændringer i stilarter, layout eller indstillinger afspejles med det samme."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sehen Sie sich eine Live-Vorschau Ihres Kontaktbild-Designs am oberen Bildschirmrand an. Änderungen an Stil, Layout oder Einstellungen werden sofort reflektiert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vea una vista previa en vivo de su diseño de imagen de contacto en la parte superior de la pantalla. Los cambios realizados a estilos, diseños o ajustes se reflejan al instante."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voyez un aperçu en direct du design de votre image de contact en haut de l'écran. Les modifications apportées aux styles, aux mises en page ou aux paramètres sont instantanément reflétées."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vedi un'anteprima in tempo reale del disegno dell'immagine dei contatti nella parte superiore dello schermo. Le modifiche apportate agli stili, ai layout o alle impostazioni sono immediatamente riflesse."
          }
        },
        "nb-NO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se en direkte forhåndsvisning av ditt kontaktbilde øverst på skjermen. Endringer gjort på stiler, visninger eller innstillinger er umiddelbart reflektert."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zie een live voorbeeld van het ontwerp van uw contactafbeelding bovenaan het scherm. Wijzigingen in stijlen, lay-outs of instellingen worden direct weergeven."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zobacz podgląd Twojego zdjęcia kontaktu na żywo w górnej części ekranu. Zmiany wprowadzone do stylów, układów lub ustawień są natychmiast odbijane."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veja uma prévia ao vivo do design da sua imagem de contato no topo da tela. Alterações feitas em estilos, layouts ou configurações são refletidas instantaneamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Смотрите в прямом эфире дизайн изображения контакта в верхней части экрана. Изменения в стилях, макетах или настройках мгновенно отражаются."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "See a live preview of your contact image design at the top of the screen. Changes made to styles, layouts, or settings are instantly reflected."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se en förhandsvisning av din kontaktbild högst upp på skärmen. Ändringar gjorda för stilar, layouter eller inställningar reflekteras omedelbart."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "See a live preview of your contact image design at the top of the screen. Changes made to styles, layouts, or settings are instantly reflected."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перегляд живого зображення зображення контакта у верхній частині екрана. Зміни, внесені до стилів, макетів або параметрів, миттєво відбиваються."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "See a live preview of your contact image design at the top of the screen. Changes made to styles, layouts, or settings are instantly reflected."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在屏幕顶部查看联系人图像设计的实时预览。对样式、布局或设置的更改即时反映。"
          }
        }
      }
    },
    "Select \"Start Override\" to immediately start using the Override, or select \"Save as Preset\" to be able to easily start the Override at a later time." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حدد \"ابدأ التجاوز\" للبدء فورا باستخدام التجاوز، أو حدد \"حفظ كإعداد مسبق\" لتكون قادرة على بدء التجاوز بسهولة في وقت لاحق."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vælg \"Start Tilsidesættelse\" for straks at begynde at bruge Tilsidesættelsen, eller vælg \"Gem som forudindstilling\" for nemt at starte Tilsidesæt på et senere tidspunkt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle \"Override\" um sofort mit der Überschreibung zu beginnen, oder wählen Sie \"Speichern als Preset\", um die Überschreibung zu einem späteren Zeitpunkt zu starten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selecciona \"Start override\" para comenzar a usar inmediatamente el Override, o seleccione \"Guardar como Preset\" para poder iniciar fácilmente el Anulación en un momento posterior."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sélectionnez \"Start Override\" pour commencer immédiatement à utiliser l'Ecrasement, ou sélectionnez \"Enregistrer en tant que préréglage\" pour pouvoir facilement démarrer la surcharge à un moment ultérieur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selezionare \"Start Override\" per iniziare immediatamente a utilizzare l'Override, o seleziona \"Salva come preimposta\" per poter avviare facilmente l'Override in un momento successivo."
          }
        },
        "nb-NO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Velg «Start justering» for å starte justeringen nå, eller velg «Lagre som forvalg» for å starte denne justeringen senere."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selecteer \"Start Override\" om direct te beginnen met de Override, of selecteer \"Opslaan als voorinstelling\" om het overschrijven op een later tijdstip eenvoudig te kunnen starten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wybierz \"Start Override\" aby natychmiast zacząć używać Nadpisania, lub wybierz \"Zapisz jako ustawienie wstępne\", aby z łatwością rozpocząć nadpisanie w późniejszym czasie."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selecione \"Start Override\" para começar imediatamente a usar a substituição, ou selecione \"Salvar como Predefinição\" para ser capaz de facilmente iniciar a Sobrescrever em um momento posterior."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выберите \"Start Override\" для немедленного начала использования переопределения, или выберите \"Сохранить как пресет\", чтобы легко запустить Переопределение на более поздний срок."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Select \"Start Override\" to immediately start using the Override, or select \"Save as Preset\" to be able to easily start the Override at a later time."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Välj \"Starta åsidosätt\" för att omedelbart börja använda Override, eller välj \"Spara som förinställd\" för att enkelt kunna starta åsidosättningen vid ett senare tillfälle."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Select \"Start Override\" to immediately start using the Override, or select \"Save as Preset\" to be able to easily start the Override at a later time."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Оберіть \"Почати перевизначити\", щоб відразу почати використовувати Перекриття, або виберіть \"Зберегти як шаблон\", щоб легко запустити перезапис у подальший час."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Select \"Start Override\" to immediately start using the Override, or select \"Save as Preset\" to be able to easily start the Override at a later time."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选择 \"Start Override\" 立即开始使用 Override， 或选择\"保存为预设\"以便能够轻松地在稍后时间开始覆盖。"
          }
        }
      }
    },
