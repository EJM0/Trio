    "Remaining Carbs Percentage estimates carbs still absorbing over 4 hours if glucose data doesn't show clear absorption." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "وتقدر النسب المئوية المتبقية للكربونات أنها لا تزال تستوعب أكثر من 4 ساعات إذا لم تظهر بيانات الجلوكوز امتصاصاً واضحاً."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Resterende kulhydrater Procentdel skønner kulhydrater stadig absorberer over 4 timer, hvis glukosedata ikke viser klar absorption."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verbleibende Kohlenhydrate in Prozent schätzt Kohlenhydrate noch über 4 Stunden, wenn die Glukosedaten keine klare Absorption aufweisen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El porcentaje restante de carbohidratos calcula que los glúcidos siguen absorbiendo durante 4 horas si los datos de glucosa no muestran una absorción clara."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le pourcentage de glucides restant estime que les glucides absorbent encore plus de 4 heures si les données sur le glucose ne montrent pas une absorption claire."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Carboidrati rimanenti La percentuale stima i carboidrati che ancora assorbono più di 4 ore se i dati sul glucosio non mostrano un assorbimento chiaro."
          }
        },
        "nb-NO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gjenværende karbohydrater Prosentvise estimater absorberer fortsatt i løpet av 4 timer hvis glukosedata ikke viser klar absorpsjon."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Resterende koolhydraten Percentage schat koolhydraten nog steeds meer dan 4 uur als glucose gegevens niet duidelijk geabsorbeerd worden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pozostałe szacunki procentowe węglowodanów nadal wchłaniają się w ciągu 4 godzin, jeśli dane dotyczące glukozy nie wykazują wyraźnego wchłaniania."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estimativa de porcentagem de carbs restantes de hidratos que ainda absorvem mais de 4 horas se os dados de glicose não mostrarem uma absorção clara."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Оставшиеся углеводы прогнозируют количество углеводов в течение 4 часов, если данные о глюкозе не показывают четкого поглощения."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Remaining Carbs Percentage estimates carbs still absorbing over 4 hours if glucose data doesn't show clear absorption."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Återstående kolhydrater Procent uppskattar kolhydrater som fortfarande absorberar över 4 timmar om glukosdata inte visar tydlig absorption."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Remaining Carbs Percentage estimates carbs still absorbing over 4 hours if glucose data doesn't show clear absorption."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Процентні оцінки трупів також поглинаються понад 4 години, якщо дані глюкози не показують чіткого поглинання."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Remaining Carbs Percentage estimates carbs still absorbing over 4 hours if glucose data doesn't show clear absorption."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果血糖数据不显示明确的吸纳率，仍吸收超过4个小时的含量百分比估计值。"
          }
        }
      }
    },
