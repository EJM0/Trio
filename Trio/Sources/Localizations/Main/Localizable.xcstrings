    "Fine-tune the ring’s Width and Gap to suit your design preferences." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "صقل عرض الخاتم والثغرة ليتناسب مع تفضيلاتك في التصميم."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finjusterer ringens bredde og kant, så den passer til dine designpræferencer."
          }
        },
        "de" : {
