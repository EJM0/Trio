    "\n\nTap 'Add' to continue with selected amount." : {
      "comment" : "Alert to confirm bolus amount to add",
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n\nНатисни 'Добави' за да продължиш със избраното количество."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n\nTryk 'Tilføj' for at fortsætte med den valgte mængde."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n\nTippen Sie auf 'Hinzufügen', um mit dem ausgewählten Betrag fortzufahren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n\nTap 'Add' to continue with selected amount."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "\n\nTap 'Add' to continue with selected amount."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n\nAppuyez sur 'Ajouter' pour utiliser la quantité sélectionnée."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n\nהקש על “הוסף” כדי להמשיך עם הכמות שנבחרה."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n\nTocca 'Aggiungi' per continuare con la quantità selezionata."
          }
        },
        "nb-NO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n\nTrykk 'Legg til' for å fortsette med den anbefalte mengden."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n\nTik op 'Toevoegen' om door te gaan met het geselecteerde aantal."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n\nNaciśnij przycisk 'Dodaj', aby kontynuować z wybraną kwotą."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "\n\nTap 'Add' to continue with selected amount."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n\nTryck 'Lägg till' för att fylla i bolusmängd."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "\n\nTap 'Add' to continue with selected amount."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n\nНатисніть «Додати», щоб продовжити з вибраним значенням."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n\nNhấn 'Thêm' để tiếp tục với số lượng đã chọn."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n\n點擊「新增」以繼續選擇的數量。"
          }
        }
      }
    },
    "\nAmount is more than your Max Bolus setting! \nAre you sure you want to add " : {
      "comment" : "Alert when adding large amount without bolusing",
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nКоличеството е по-голямо от максимално разрешеният болус!\nСигурни ли сте че желаете да продължите? "
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nDette er mere insulin end din \"Max Bolus\" indstilling!\nEr du sikker på at du vil tilføje "
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nEingegebener Bolus ist größer als Max Bolus aus den Einstellungen! Sind Sie sicher, dass er hinzugefügt werden soll "
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nAmount is more than your Max Bolus setting! \nAre you sure you want to add "
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "\nAmount is more than your Max Bolus setting! \nAre you sure you want to add "
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nLa quantité dépasse votre réglage de Bolus maximal ! \nÊtes-vous sûr de vouloir l'ajouter "
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nהכמות גבוהה מהגדרת הבולוס המרבי שלך!\nהאם אתה בטוח שברצונך להוסיף? "
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nLa quantità è superiore all'impostazione del Bolo Massimo! \nSei sicuro di voler aggiungere "
          }
        },
        "nb-NO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nMengden er høyere enn din Maks bolus-innstilling! \nEr du sikker på at du vil legge til "
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nDeze hoeveelheid is meer dan je instelling van je maximale bolus! \nWeet je zeker dat je deze hoeveelheid wilt toedienen? \nDeze hoeveelheid is meer dan je instelling van je maximale bolus! \nWaarschuw bij toedienen van een hoge hoeveelheid zonder te bolussen "
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nKwota jest większa niż Twoje ustawienie Max bolus! \nCzy na pewno chcesz dodać "
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nValor é maior do que a configuração de seu Bólus Máximo! \nTem certeza que deseja adicionar "
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nDetta är mer insulin än din maxdos-inställning! \nÄr du säker på att du vill lägga till "
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "\nAmount is more than your Max Bolus setting! \nAre you sure you want to add "
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nКількість перевищує ваш максимальний болюс! \nВи впевнені, що хочете додати"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nLiều tiêm nhiều hơn liều Max Bolus! \nBạn có chắc chắn muốn thêm "
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n數量超過您的最大注射設定！ \n您確定要新增"
          }
        }
      }
    },
    "\nInvalid Nightcsout Basal Settings. \n\nImport aborted. Please check your Nightscout Profile Basal Settings!" : {
      "comment" : "Import ErrorImport Error",
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nНевалидни Nightscout базални настройки.\nИмпорта е прекъснат! Моля проверете настройките на вашият базален профил в Nightscout!"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nUgyldig Nightcsout Basal Indstillinger. \n\nImport afbrudt. Tjek venligst dine Nightscout Profil Basal Indstillinger!"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nUngültige Nightcsout Basal-Einstellungen. \n\nImport abgebrochen. Bitte überprüfen Sie Ihre Nightscout Profil Basal-Einstellungen!"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nInvalid Nightcsout Basal Settings. \n\nImport aborted. Please check your Nightscout Profile Basal Settings!"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nConfiguración basal de Nightcsout no válida. \n\nImportación cancelada. Por favor comprueba tu configuración basal de perfil de Nightscout!"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nLe profil basal configuré dans Nightscout n'est pas valide.\n\nL'importation a été annulée. Veuillez vérifier les débits de base dans votre profil Nightscout !"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nהכמות גבוהה מהגדרת הבולוס המרבי שלך!\nהאם אתה בטוח שברצונך להוסיף"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nImpostazioni Basali Nightscout non valide. \n\nImportazione annullata. Si prega di controllare le impostazioni basali del profilo Nightscout!"
          }
        },
        "nb-NO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nUgyldig basalprofil fra Nightscout. \n\nImport avbrutt. Sjekk basalprofil i Nightscout!"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nOngeldige Nightscout basaal instellingen. \n\nImport afgebroken. Controleer je Nightscout Profiel basaal instellingen!"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nNieprawidłowe ustawienia bazy Nightcsout. \n\nImportowanie przerwane. Sprawdź ustawienia bazy profilu Nightscout!"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nConfigurações de Basal do Nightcsout inválidas. \n\nImportação abortada. Por favor, verifique suas configurações do perfil do Nightscout!"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nDu har ogiltiga basalinställningar i Nightscouts profilinställningar. \n\nImport avbröts. Du behöver kontrollera dina Nightscoutinställningar!"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "\nInvalid Nightcsout Basal Settings. \n\nImport aborted. Please check your Nightscout Profile Basal Settings!"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nНедійсні базальні налаштування Nightcsout. \n\nІмпорт перервано. Будь ласка, перевірте базальні налаштування свого профілю Nightscout!"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nCác cấu hình liều nền trên Nightscout không hợp lệ.\n\n Việc cập nhật bị bỏ. Đề nghị bạn kiểm tra cấu hình liều nền trên Nightscout!"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n無效的 Nightscout 基礎設定。 \n\n匯入中止。請檢查您的 Nightscout 個人設置基礎設定！"
          }
        }
      }
    },
    "\nMismatching glucose units in Nightscout and Pump Settings. Import settings aborted." : {
      "comment" : "Import ErrorImport Error",
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nИмпортирането на настройките е прекъснато поради различни мерни единици в настройките на помпата и Nightscout."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nUoverensstemmende glukose enheder i Nightscout og Pumpe Indstillinger. Import af indstillinger afbrudt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nNicht übereinstimmende Glukoseeinheiten in Nightscout und Pumpen-Einstellungen. Import abgebrochen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nMismatching glucose units in Nightscout and Pump Settings. Import settings aborted."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unidades de glucosa no coincidentes \nen Nightscout y Configuración de la Bomba. Ajustes de importación cancelados."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nLes unités de glucose dans Nightscout ne correspondent pas à ceux des réglages de la pompe. L'importation des paramètres a été annulée."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nיחידות הגלוקוז ב-Nightscout ובהגדרות המשאבה אינן תואמות. ייבוא ההגדרות בוטל."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nUnità di glucosio non corrispondenti tra impostazioni di Nightscout e microinfusore. Import delle impostazioni interrotto."
          }
        },
        "nb-NO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nBlodsukkerenhet i Nightscout samsvarer ikke med blodsukkerenhet i pumpeinnstillinger. Import av innstillinger er avbrutt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nMismatch van glucose-eenheden in Nightscout en pomp instellingen. Importeer instellingen is afgebroken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nNiepasujące jednostki glukozy w Ustawieniach Nightscout i Pompy. Importowanie ustawień przerwane."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nUnidades de glicose não coincidem nas configurações do Nightscout e da bomba. Importar configurações foi interrompido."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nDu har olika inställningar för blodsockerenheter i Nightscout och Trio. Import avbröts."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "\nMismatching glucose units in Nightscout and Pump Settings. Import settings aborted."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nНевідповідність одиниць глюкози в налаштуваннях Nightscout та Помпи. Імпорт налаштувань скасовано."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n Sai khác đơn vị Glucose giữa Nightscout và Bơm. Cập nhật cấu hình bị bỏ."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nNightscout 和幫浦設定中的血糖單位不匹配。匯入設定中止。"
          }
        }
      }
    },
    "\nNow please verify all of your new settings thoroughly: \n\n • DIA (Pump settings)\n • Basal Profile\n • Insulin Sensitivities\n • Carb Ratios\n • Glucose Targets\n\n in Trio Settings -> Configuration.\n\nBad or invalid profile settings could have disastrous effects." : {
      "comment" : "Imported Profiles Alert",
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nПроверете всички нови настройки внимателно: \n\n • DIA (настройки на помпата)\n • Базален профил\n • Инсулинова чувствителност\n • Въглехидратно число\n • Желани нива на глюкоза\n\n В Trio Настройки -> Конфигурация.\n\nЛошите или невалидни настройки на профилите могат да имат тежки последици."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nKontroller nu alle dine nye indstillinger grundigt:\n\n* Basal Indstillinger\n * Kulhydratratios\n * Glukose Mål\n * Insulin Følsomhed\n * VIA\n\n i Trio Indstillinger > Konfiguration.\n\nDårlige eller ugyldige profilindstillinger kan have katastrofale effekter."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nBitte überprüfen Sie jetzt alle Ihre neuen Einstellungen gründlich: \n\n * Basalprofil\n * Kohlenhydrat:Insulin-Verhältnis (carb ratio)\n * Zielglukose\n * Insulinempfindlichkeiten\n * DIA (Pumpen Einstellungen)\n\n in Trio-Einstellungen > Therapie.\n\nSchlechte oder ungültige Profileinstellungen können folgenschwere Effekte haben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nNow please verify all of your new settings thoroughly: \n\n • DIA (Pump settings)\n • Basal Profile\n • Insulin Sensitivities\n • Carb Ratios\n • Glucose Targets\n\n in Trio Settings -> Configuration.\n\nBad or invalid profile settings could have disastrous effects."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "\nNow please verify all of your new settings thoroughly: \n\n • DIA (Pump settings)\n • Basal Profile\n • Insulin Sensitivities\n • Carb Ratios\n • Glucose Targets\n\n in Trio Settings -> Configuration.\n\nBad or invalid profile settings could have disastrous effects."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nVeuillez maintenant vérifier attentivement tous vos nouveaux paramètres:\n\n - Durée d'action de l'insuline (DIA) (dans Paramètres -> Algorithme -> Supplémentaires)\n - Profil basal\n - Sensibilité à l'insuline (ISF)\n - Ratios glucidiques (CR)\n - Objectifs glycémiques\n\n dans Paramètres -> Configuration de Trio -> Traitement\n\nDes paramètres de profil incorrects ou invalides pourraient avoir des conséquences graves."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nאנא אמת את כל ההגדרות החדשות שלך באופן יסודי:\n\n• זמן פעילות האינסולין (הגדרות משאבה)\n• פרופיל בזאלי\n• רגישויות לאינסולין \n• יחסי פחמימות \n• יעדי ערכך הסוכר בדם \n\nב- הגדרות -> תצורה \n\nהגדרות פרופיל שגויות או לא תקינות עלולות לגרום להשפעות הרסניות."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nOra verifica attentamente tutte le tue nuove impostazioni:\n\n * DIA (Impostazioni microinfusore)\n * Profilo basale\n * Sensibilità all'insulina\n * Rapporti insulina/carboidrati\n * Obiettivi glicemici\n\n in Impostazioni Trio > Configurazione.\n\nImpostazioni del profilo errate o non valide potrebbero avere effetti molto gravi."
          }
        },
        "nb-NO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nGå nøye gjennom de nye innstillingene:\n\n • DIA (pumpeinnstillinger)\n • Basalprofil\n • Insulinfølsomhet\n • Karbohydratforhold\n • Blodsukkermål\n\n i Trio-innstillinger.\n\nFeil eller ugyldige profilinnstillinger kan få katastrofale konsekvenser."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nCheck nu al je nieuwe instellingen:\n\n* Basaal instellingen\n * Koolhydraat ratio's\n * Doel glucose waarde\n * Insuline sensitiviteit\n * DIA\n\n in Trio instellingen > Configuratie.\n\nSlechte of ongeldige profielinstellingen kunnen  desastreuze effecten hebben!"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nTeraz sprawdź dokładnie wszystkie swoje nowe ustawienia: \n\n • DIA (ustawienia pompy)\n • Profil Basal\n • Wrażliwość na insulinę\n • Współczynnik węglowodanów\n • Cele glikemii\n\n w Ustawieniach Trio -> Konfiguracja.\n\nBłędne lub nieprawidłowe ustawienia profilu mogą mieć katastrofalne skutki."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "\nNow please verify all of your new settings thoroughly: \n\n • DIA (Pump settings)\n • Basal Profile\n • Insulin Sensitivities\n • Carb Ratios\n • Glucose Targets\n\n in Trio Settings -> Configuration.\n\nBad or invalid profile settings could have disastrous effects."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nKontrollera nu alla dina nya inställningar noga:\n\n • DIA (Pumpinställningar) \n • Basalprofil\n • Insulinkänslighet\n • Insulinkvoter\n • Målglukos\n\n i Inställningar > Behandlingsinställningar.\n\nFelaktiga profilinställningar kan ge katastrofala följder."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "\nNow please verify all of your new settings thoroughly: \n\n • DIA (Pump settings)\n • Basal Profile\n • Insulin Sensitivities\n • Carb Ratios\n • Glucose Targets\n\n in Trio Settings -> Configuration.\n\nBad or invalid profile settings could have disastrous effects."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nТепер уважно перевірте всі ваші нові налаштування:\n\n* Базальні параметри\n * Вуглеводні співвідношення\n * Цільові показники глюкози\n * Чутливість до інсуліну\n\n у меню «Налаштування Trio» > «Конфігурація».\n\nПоганий або недійсний профіль налаштування можуть мати згубні наслідки."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n Bây giờ xin hãy xác minh lại tất cả các cài đặt của bạn kỹ lưỡng:\n\n* Cài đặt liều nền\n * Tỷ lệ Carb\n * Mục tiêu đường huyết \n * Độ nhạy của Insulin\n * Thời gian hoạt động của insulin\n\n trong Trio Cài đặt > Cấu hình.\n\n Cấu hình không hợp lệ hoặc tồi có thể có tác động thảm họa."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n現在請仔細驗證您的所有新設定： \n\n • DIA（幫浦設定）\n • 基礎設定\n • 胰島素敏感度\n • 碳水化合物比率\n • 血糖目標\n\n 在 Trio 設定 -> 配置中.\n\n不良或無效的個人設定可能會造成災難性的影響。"
          }
        }
      }
    },
    "\nSettings were imported but the Basals couldn't be saved to pump (No pump). Check your basal settings and tap ´Save on Pump´ to sync the new basal settings" : {
      "comment" : "Import ErrorImport Error",
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nНастройките са импортирани но Базалният профил не може да бъде запазен в помпата (Няма помпа). Проверете базалният профил и изберете 'Запиши на помпата' за да синхронизирате новите настройки"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nIndstillinger blev importeret, men Basalinsulin indstillinger kunne ikke gemmes til pumpe (Ingen pumpe). Tjek dine basal indstillinger og tryk på 'Gem på Pumpe' for at synkronisere de nye basal indstillinger"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nEinstellungen wurden importiert, aber die Basalraten konnten nicht auf der Pumpe gespeichert werden (keine Pumpe). Überprüfen Sie Ihre Basalprofil-Einstellungen und tippen Sie auf \"Speichern auf Pumpe\", um die neuen Basalraten zu synchronisieren"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nSettings were imported but the Basals couldn't be saved to pump (No pump). Check your basal settings and tap ´Save on Pump´ to sync the new basal settings"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nConfiguración importada pero las Basales no se pudieron guardar en la bomba (Sin bomba). Revisa la configuración basal y pulsa sobre la bomba para sincronizar la nueva configuración basal"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nLes paramètres ont été importés, mais le profil basal n'a pas pu être enregistré sur la pompe (Aucune pompe détectée). Vérifiez la configuration de votre profil basal et appuyez sur \"Enregistrer sur la pompe\" pour le synchroniser à nouveau"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nההגדרות יובאו, אך הפרופיל הבזאלי לא נשמר במשאבה (אין משאבה).\nבדוק את הגדרות הפרופיל הבזאלי שלך והקש על ‘שמור במשאבה’ כדי לסנכרן את הגדרות החדשות"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nLe impostazioni sono state importate ma non è stato possibile salvare le basali nel microinfusore (Nessun microinfusore). Controlla le impostazioni basali e tocca \"Salva sul microinfusore\" per sincronizzare le nuove impostazioni basali"
          }
        },
        "nb-NO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nInnstillinger ble importert men basalprofilen kunne ikke lagres til pumpen (ingen pumpe). Sjekk din basalprofil og trykk ´Lagre på pumpen´ for å sende den nye basalprofilen til pumpen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\ninstellingen zijn geïmporteerd maar de basaalstanden konden niet worden opgeslagen in de pomp (geen pomp). Controleer je basaalstanden en tik op' Opslaan op pomp' om de nieuwe basaalstanden te synchroniseren"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nUstawienia zostały zaimportowane, ale Baza nie mogła zostać zapisana do pompy (brak pompy). Sprawdź ustawienia bazy i naciśnij przycisk Zapisz na Pompie, aby zsynchronizować nowe ustawienia bazy"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "U\nConfigurações foram importadas, mas os basais não puderam ser salvos na bomba (Sem bomba). Verifique as suas configurações de basal e toque em Salvar na Bomba para sincronizar as novas configurações de basal"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nDina inställningar blev importerade men kunde inte sparas till pump (Ingen pump). Kontrollera dina pumpinställningar och klicka därefter på ´Spara till pump´ för att programmera din pump med de nya basalinställningarna"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "\nSettings were imported but the Basals couldn't be saved to pump (No pump). Check your basal settings and tap ´Save on Pump´ to sync the new basal settings"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nНалаштування було імпортовано, але Базал не вдалося зберегти для помпи (немає помпи). Перевірте свої базальні налаштування та натисніть «Зберегти на помпі», щоб синхронізувати нові базальні налаштування"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n Các cấu hình đã được nhập nhưng liều nền không được lưu vào bơm (không có bơm). Kiểm tra cấu hình liều nền của bạn và nhấn 'Lưu vào bơm' để đồng hóa cấu hình liều nền mới"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n設定已匯入，但基礎無法儲存到幫浦（未連接幫浦）。請檢查您的基礎設定並點擊「在幫浦上儲存」以同步新的基礎設定。"
          }
        }
      }
    },
