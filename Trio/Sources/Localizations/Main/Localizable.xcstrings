    "The maximum deviation from the center value. Higher values create wider swings." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The maximum deviation from the center value. Higher values create wider swings."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den maksimale afvigelse fra centerværdien. Højere værdier skaber bredere gynger."
