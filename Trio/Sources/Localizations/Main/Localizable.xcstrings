    "Forecasts future glucose levels and insulin dosing needs for unexpected meals or other causes of glucose reading increases without prior notice." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ويتوقع ارتفاع مستويات الجلوكوز في المستقبل والاحتياجات من جرعات الأنسولين بالنسبة للوجبات غير المتوقعة أو غير ذلك من أسباب قراءة الجلوكوز دون إشعار مسبق."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prognoser fremtidige glukoseniveauer og insulindosis behøver uventede måltider eller andre årsager til glukoselæsning uden forudgående varsel."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prognosen für zukünftige Glukosewerte und Insulindosierungsbedarf für unerwartete Mahlzeiten oder andere Ursachen für GlukoseLeseanstiege ohne vorherige Ankündigung."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Predicción de futuros niveles de glucosa y necesidades de dosis de insulina para comidas inesperadas u otras causas de lectura de glucosa aumenta sin previo aviso."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prévision de futurs niveaux de glucose et des besoins en dosage d'insuline pour des repas inattendus ou d'autres causes de lecture du glucose augmentent sans préavis."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Previsioni future dei livelli di glucosio e del dosaggio di insulina per pasti imprevisti o altre cause di aumento della lettura di glucosio senza preavviso."
          }
        },
        "nb-NO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varsler fremtidige glukosenivåer og insulindosering trenger for uventede måltider eller andre årsaker til glukoseavlesning øker uten at det forhåndsvars."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het voorspellen van toekomstige glucosewaardes en de behoefte aan insulinedoseringen voor onverwachte maaltijden of andere oorzaken van glucosewaarde stijgt zonder voorafgaande kennisgeving."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prognozy dotyczące przyszłych poziomów glukozy i dawkowania insuliny w przypadku nieoczekiwanych posiłków lub innych przyczyn zwiększenia stężenia glukozy bez wcześniejszego powiadomienia."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prevê níveis de glicose futuros e a dosagem insulina para refeições inesperadas ou outras causas de aumento da leitura de glicose sem aviso prévio."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Прогнозирует будущие уровни глюкозы и потребности инсулина для дозирования непредвиденных блюд или других причин увеличения количества глюкозы без предварительного уведомления."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Forecasts future glucose levels and insulin dosing needs for unexpected meals or other causes of glucose reading increases without prior notice."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prognoser framtida glukosnivåer och insulindoseringsbehov för oväntade måltider eller andra orsaker till glukosavläsning ökar utan förvarning."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Forecasts future glucose levels and insulin dosing needs for unexpected meals or other causes of glucose reading increases without prior notice."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Прогнози майбутніх рівнів глюкози та потреби в дозі інсуліну для несподіваних страв або інших причин підвищення глюкози без попереднього повідомлення."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Forecasts future glucose levels and insulin dosing needs for unexpected meals or other causes of glucose reading increases without prior notice."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "预报未来的葡萄糖水平和绝缘剂量需求量，以用于意外的膳食或未事先通知而增加对葡萄糖的阅读量。"
          }
        }
      }
    },
    "Forecasts future glucose reading changes by considering the amount of carbohydrates still being absorbed in the body." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ويتنبأ بالتغييرات المستقبلية في قراءة الجلوكوز عن طريق النظر في كمية الكربوهيدرات التي لا تزال تستوعب في الجسم."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prognoser fremtidige glukose aflæsning ændringer ved at overveje mængden af kulhydrater stadig absorberes i kroppen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prognostiziert zukünftige Glukose-Lesungen unter Berücksichtigung der Menge an Kohlenhydraten, die noch im Körper absorbiert werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Predicción de futuros cambios en la lectura de la glucosa teniendo en cuenta la cantidad de hidratos de carbono que siguen absorbiéndose en el cuerpo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prévoit les changements futurs de lecture du glucose en tenant compte de la quantité d'hydrates de carbone encore absorbés dans le corps."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prevede future variazioni di lettura del glucosio considerando la quantità di carboidrati ancora assorbiti nel corpo."
          }
        },
        "nb-NO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prognoser fremtidige glukoselesningsendringer ved å vurdere mengden karbohydrater som fremdeles absorberes i kroppen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwacht dat er in de toekomst wijzigingen in glucosewaarde zullen worden doorgevoerd door te kijken naar de hoeveelheid koolhydraten die nog steeds in het lichaam worden opgenomen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prognoza przyszłych zmian w odczycie glukozy poprzez uwzględnienie ilości węglowodanów nadal wchłanianych w organizmie."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prevê futuras mudanças na leitura da glicose, considerando a quantidade de carboidratos ainda a ser absorvida no corpo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Прогнозирует будущие изменения в чтении глюкозы, принимая во внимание количество углеводов, которые по-прежнему поглощаются в организме."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Forecasts future glucose reading changes by considering the amount of carbohydrates still being absorbed in the body."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prognoser framtida glukos läsning förändringar genom att överväga mängden kolhydrater fortfarande absorberas i kroppen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Forecasts future glucose reading changes by considering the amount of carbohydrates still being absorbed in the body."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Прогнози майбутньої глюкози читають зміни, враховуючи кількість вуглеводів, які все ще поглинаються в тілі."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Forecasts future glucose reading changes by considering the amount of carbohydrates still being absorbed in the body."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "考虑到体内吸收的碳水化合物数量，预测今后的葡萄糖阅读变化。"
          }
        }
      }
    },
    "Forecasts future glucose readings based on the amount of insulin still active in the body." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ويتوقع قراءات الجلوكوز في المستقبل استناداً إلى كمية الأنسولين التي لا تزال نشطة في الجسم."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prognoser fremtidige glucosemålinger baseret på den mængde insulin, der stadig er aktiv i kroppen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prognostiziert zukünftige Glukose-Messungen basierend auf der Menge an Insulin, die noch im Körper aktiv ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Predicción de futuras lecturas de glucosa basadas en la cantidad de insulina todavía activa en el cuerpo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prévoit les futures lectures de glucose basées sur la quantité d'insuline encore active dans le corps."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prevede i futuri valori del glucosio in base alla quantità di insulina ancora attiva nell’organismo."
          }
        },
        "nb-NO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prognoser fremtidige glukosemålinger basert på insulinmengden som fortsatt er aktivt i kroppen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwacht toekomstige glucosewaardes op basis van de hoeveelheid insuline die nog actief is in het lichaam."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prognoza przyszłych odczytów stężenia glukozy w oparciu o ilość insuliny nadal działającej w organizmie."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prevê leituras de glicose futuras com base na quantidade de insulina ainda ativa no corpo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Прогнозирует будущие показатели глюкозы, основанные на количестве инсулина, который еще активно в организме."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Forecasts future glucose readings based on the amount of insulin still active in the body."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prognoser framtida glukosvärden baserat på mängden insulin som fortfarande är aktiv i kroppen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Forecasts future glucose readings based on the amount of insulin still active in the body."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Прогнози майбутніх показників глюкози, заснованих на кількості інсуліну, які досі працюють в тілі."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Forecasts future glucose readings based on the amount of insulin still active in the body."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "根据身体中仍然活跃的绝缘量预测今后的葡萄糖读数。"
          }
        }
      }
    },
    "Forecasts the worst-case future glucose reading scenario if no carbs are absorbed and insulin delivery is stopped until glucose starts rising." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ويتوقع سيناريو قراءة الجلوكوز في المستقبل أسوأ الحالات إذا لم يتم امتصاص كربونات وتوقف تسليم الأنسولين إلى أن يبدأ الجلوكوز في الارتفاع."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prognoser det værst tænkelige fremtidige glukosescenarie, hvis ingen kulhydrater absorberes, og insulindosis stoppes, indtil glukosen begynder at stige."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prognosen des Worst-case zukünftigen Glukose-Leseszenarios, wenn keine Kohlenhydrate absorbiert werden und die Insulinlieferung eingestellt wird, bis die Glukose ansteigt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Presenta el peor escenario de lectura de glucosa en el futuro si no se absorbe ningún glúcido y se detiene el parto de insulina hasta que la glucosa empiece a aumentar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prévoit le pire scénario de lecture du glucose si aucun glucide n'est absorbé et si la distribution d'insuline est arrêtée jusqu'à ce que le glucose commence à augmenter."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prevede lo scenario peggiore di lettura futura del glucosio se non vengono assorbiti carboidrati e la somministrazione di insulina viene interrotta fino a quando il glucosio inizia ad aumentare."
          }
        },
        "nb-NO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varsler det verste tilfellet fremtidige glukoseavlesningsscenarioet hvis ingen karbohydrater absorberes og insulintilførselen stoppes inntil glukose begynner å stige."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voorraadt het ergste geval in het toekomstige glucoseleesscenario als er geen koolhydraten worden opgenomen en de toediening van insuline wordt gestopt totdat glucose begint te stijgen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prognoza najgorszego scenariusza w przyszłości odczytu glukozy, jeśli nie zostaną wchłonięte węglowodany i podawanie insuliny zostanie wstrzymane do czasu rozpoczęcia wzrostu glukozy."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prevê o cenário de leitura da glicose futura pior se não forem absorvidos e se a entrega da insulina for interrompida até que a glicose comece a subir."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Прогнозирует худший случай будущего сценария чтения глюкозы, если нет углеводов и инсулин поставки прекращается до начала роста глюкозы."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Forecasts the worst-case future glucose reading scenario if no carbs are absorbed and insulin delivery is stopped until glucose starts rising."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prognoser det värsta fallet framtida glukosläsning scenario om inga kolhydrater absorberas och insulinleverans stoppas tills glukos börjar stiga."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Forecasts the worst-case future glucose reading scenario if no carbs are absorbed and insulin delivery is stopped until glucose starts rising."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Прогноз найгіршого сценарію читання глюкози, якщо жодні труби не поглинаються та доставка інсуліну припиняться, поки глюкоза не почне зростати."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Forecasts the worst-case future glucose reading scenario if no carbs are absorbed and insulin delivery is stopped until glucose starts rising."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果不吸收卡车，就预报今后血糖读取情景最坏的情况，并在葡萄糖开始升高之前停止绝缘交货。"
          }
        }
      }
    },
