          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dette gør det muligt at uploade statistics.json til Nightscout, som kan bruges af Fællesskabets statistikker og demografiske projekt.\n\nDeltagelse i EF-statistikker er fravalgt, og kræver særskilt registrering på:\n"
