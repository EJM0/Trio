    "Warning: This must be greater than 0 for any automatic temporary basal rates or SMBs to be given." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Warning: This must be greater than 0 for any automatic temporary basal rates or SMBs to be given."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Advarsel: Dette skal være større end 0 for enhver automatisk midlertidig basal sats eller SMB'er, der skal gives."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Warnung: Dies muss größer als 0 sein, um automatische Temporärkurse oder SMB zu geben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aviso: Esto debe ser mayor que 0 para cualquier tarifa basal temporal o SMB automática."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Attention : ceci doit être supérieur à 0 pour que tous les débits de basal temporaire ou SMB automatiques soient donnés."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Warning: This must be greater than 0 for any automatic temporary basal rates or SMBs to be given."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Attenzione: Questo deve essere maggiore di 0 per le tariffe basali temporanee automatiche o le PMI da fornire."
          }
        },
        "nb-NO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Advarsel: Denne må være større enn 0 for automatisk midlertidig basal sats eller SMB som skal gis."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Waarschuwing: Dit moet groter zijn dan 0 om eventuele automatische tijdelijke basaalstanden of SMB toe te kennen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ostrzeżenie: To musi być większe niż 0 dla automatycznych tymczasowych dawek bazowych lub SMB, które mają być podane."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aviso: Isto deve ser superior a 0 para que quaisquer taxas basais temporárias automáticas ou SMBs sejam dadas."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varning: Detta värde måste vara större än 0 för att temporärt ökad basal och/eller SMBs ska kunna ges."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Warning: This must be greater than 0 for any automatic temporary basal rates or SMBs to be given."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Попередження: це має бути більше 0 для будь-яких автоматичних тимчасових базових ставок або SMS для використання."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Warning: This must be greater than 0 for any automatic temporary basal rates or SMBs to be given."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "警告：這必須大於0，任何自動臨時基礎速率或SMBs才能生效。"
