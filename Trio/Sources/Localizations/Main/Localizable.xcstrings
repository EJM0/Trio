    " SMBs are disabled either by schedule or during the entire duration." : {
      "comment" : "Alert string. Keep spaces.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " يتم تعطيل SMBs إما عن طريق الجدول الزمني أو خلال كامل المدة."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " SMB'er deaktiveres enten efter tidsplan eller i hele perioden."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " SMBs werden entweder nach Zeitplan oder während der gesamten Dauer deaktiviert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " SMBs are disabled either by schedule or during the entire duration."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " Las SMB están desactivadas ya sea por horario o durante toda la duración."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " Les SMB sont désactivés soit par horaire, soit pendant toute la durée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " Le SMS sono disabilitate sia per il programma che per tutta la durata."
          }
        },
        "nb-NO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " SMB er deaktivert enten ved tidsplan eller gjennom hele varigheten."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " SMB's worden per schema of gedurende de gehele looptijd uitgeschakeld."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " SMB są wyłączone według harmonogramu lub przez cały czas."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " SMBs são desativados por horário ou durante toda a duração."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " SMB отключаются либо по расписанию, либо в течение всего срока действия."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " SMB sú vypnuté buď podľa plánu, alebo počas celého trvania."
          }
        },
