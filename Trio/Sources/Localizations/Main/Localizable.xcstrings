        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если ваш текущий базовый курс 0.8 U/hr и \"Супер болус процента\" установлен в 200%: 0. × (200 ÷ 100) = 1.6 единицы будут добавлены к Вашей рекомендации по приобретению болта."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "new",
