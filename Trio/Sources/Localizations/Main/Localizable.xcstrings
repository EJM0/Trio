    "Of the total insulin delivered in the past 24 hours, this indicates what percentage was administered through basals and what was given through bolus." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ومن مجموع الأنسولين الذين سلموا خلال الـ 24 ساعة الماضية، يشير هذا إلى النسبة المئوية التي كانت تدار عن طريق القواعد الأساسية وما أعطيت عن طريق الأنابيب."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Af den totale mængde insulin, der er givet inden for de sidste 24 timer, indikerer dette, hvilken procentdel der blev administreret gennem basalerne, og hvad der blev givet gennem bolus."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Von dem gesamten Insulin, das in den letzten 24 Stunden geliefert wurde, zeigt dies an, welcher Prozentsatz durch Basale verabreicht wurde und was durch Bolus gegeben wurde."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De la insulina total entregada en las últimas 24 horas, esto indica qué porcentaje fue administrado a través de basales y lo que se dio a través del bolo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De l'insuline totale distribuée au cours des dernières 24 heures, cela indique quel pourcentage a été administré par le basal et ce qui a été donné par le bolus."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dell'insulina totale erogata nelle ultime 24 ore, questo indica quale percentuale è stata somministrata attraverso i basali e cosa è stato somministrato attraverso il bolo."
          }
        },
        "nb-NO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Av det totale insulinet som gis de siste 24 timene, angir det hva prosentvis er administrert gjennom basaler og hva som er gitt gjennom bolus."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Van de totale hoeveelheid insuline die de afgelopen 24 uur is afgeleverd, geeft dit aan welk percentage is toegediend via basaalstanden en wat er via bolus is gegeven."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Z całkowitej ilości insuliny dostarczanej w ciągu ostatnich 24 godzin, oznacza to, jaki procent był podawany przez dawkę bazową i jaki był podawany w bolusie."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Da insulina total entregue nas últimas 24 horas, isto indica que percentagem foi administrada através de basais e o que foi dado através do bolus."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Из общего числа инсулинов, доставленных за последние 24 часа, это указывает на то, какой процент управлялся через базары и что было отдано за счет обмена."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Of the total insulin delivered in the past 24 hours, this indicates what percentage was administered through basals and what was given through bolus."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Av det totala insulin som levererats under de senaste 24 timmarna indikerar detta vilken procentandel som administrerades genom basaler och vad som gavs genom bolus."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Of the total insulin delivered in the past 24 hours, this indicates what percentage was administered through basals and what was given through bolus."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Загальний інсулін, що був доставлений за останні 24 години, це показує, який відсоток отримувався через основ і що було подано через болтів."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Of the total insulin delivered in the past 24 hours, this indicates what percentage was administered through basals and what was given through bolus."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在过去24小时内交付的绝缘材料中，这表明通过基本材料进行管理的百分比和通过螺旋体进行管理的百分比。"
          }
        }
      }
    },
