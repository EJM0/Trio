        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nota: Esta opción sólo se utiliza si la configuración \"Bajo Objetivo Temp Bajar Sensitividad\" o \"Alto Objetivo Temp Aumenta la Sensibilidad\"."
