        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nota: Questa impostazione viene utilizzata solo se le impostazioni \"Bassa Sensibilità Bassa Bersaglio Tempa\" O \"Bersaglio ad Alta Temperatura Aumenta Sensibilità\" sono abilitate."
          }
        },
        "nb-NO" : {
          "stringUnit" : {
