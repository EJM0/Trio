    "Disabling this setting will still allow other commands, like Temp Targets, Add Carbs, and Start/End Overrides" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيؤدي تعطيل هذا الإعداد إلى السماح بأوامر أخرى، مثل أهداف Temp Targets، وإضافة كاربس، وتجاوز البداية/النهاية"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
