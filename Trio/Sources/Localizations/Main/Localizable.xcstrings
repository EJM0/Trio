        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Met Trio kun je automatiseringen maken met behulp van iOS Snelkoppelingen. Ga naar de app Snelkoppelingen om nieuwe automaties te maken."
