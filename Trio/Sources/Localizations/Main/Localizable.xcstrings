    "This will replace some or all of your current pump settings. Are you sure you want to import profile settings from Nightscout?" : {
      "comment" : "Profile Import AlertProfile Import Alert",
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "This will replace some or all of your current pump settings. Are you sure you want to import profile settings from Nightscout?"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dette vil erstatte nogle eller alle dine aktuelle pumpeindstillinger. Er du sikker på, at du vil importere profilindstillinger fra Nightscout?"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dies wird einige oder alle deine aktuellen Pumpeneinstellungen ersetzen. Bist du sicher, dass du die Profileinstellungen von Nightscout importieren möchtest?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This will replace some or all of your current pump settings. Are you sure you want to import profile settings from Nightscout?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto reemplazará algunos o todos los ajustes de la bomba actual. ¿Está seguro de que desea importar la configuración del perfil de Nightscout?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette opération remplacera tout ou partie des paramètres actuels de la pompe. Êtes-vous sûr de vouloir importer les paramètres de profil de Nightscout ?"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "This will replace some or all of your current pump settings. Are you sure you want to import profile settings from Nightscout?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo sostituirà alcune o tutte le impostazioni attuali del microinfusore. Sei sicuro di voler importare le impostazioni del profilo da Nightscout?"
          }
        },
        "nb-NO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dette vil erstatte alle eller deler av dine nåværende pumpeinnstillinger. Er du sikker på at du vil importere profilinnstillinger fra Nightscout?"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dit zal enkele of al je huidige pomp instellingen vervangen. Weet je zeker dat je de profielinstellingen uit Nightscout wilt importeren?"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To zastąpi niektóre lub wszystkie obecne ustawienia pompy. Czy na pewno chcesz zaimportować ustawienia profilu z Nightscout?"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isto irá substituir algumas ou todas as configurações da sua bomba atual. Tem certeza de que deseja importar as configurações de perfil do Nightscout?"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Detta kommer att ersätta alla eller vissa av dina pumpinställningar. Är du säker att du vill fortsätta med import av inställningar?"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "This will replace some or all of your current pump settings. Are you sure you want to import profile settings from Nightscout?"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Це замінить деякі або всі поточні налаштування Помпи. Ви впевнені, що бажаєте імпортувати налаштування профілю з Nightscout?"
