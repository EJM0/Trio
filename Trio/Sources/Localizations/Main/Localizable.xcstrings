    "Show your current glucose on Trio app icon." : {

    },
    "Shows an insulin dose, which can be a small automated dose (super-micro-bolus), a manually entered dose, or one given externally (e.g., a pen shot)." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يعرض جرعة من الأنسولين يمكن أن تكون جرعة آلية صغيرة (فوق ميكرو-بولوس)، أو جرعة مدخلة يدويا، أو جرعة معطاة خارجيا (مثل قلم رصاص)."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viser en insulindosis som kan være en lille automatiseret dosis (super- mikro- bolus), en manuelt indtastet dosis eller en dosis der gives eksternt (f.eks. en pen- skud)."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeigt eine Insulindosis an, die eine kleine automatisierte Dosis (Super-Mikro-Bolus), eine manuell eingegebene Dosis oder eine extern (z.B. ein Stift Schuss) sein kann."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Demuestra una dosis de insulina, que puede ser una pequeña dosis automatizada (super-micro-bolus), una dosis introducida manualmente o una dada externamente (por ejemplo, un bolígrafo)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Montre une dose d'insuline, qui peut être une petite dose automatisée (super-microbolus), une dose entrée manuelle, ou une dose donnée à l'extérieur (par exemple, un tir au stylo)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra una dose di insulina, che può essere una piccola dose automatica (super-micro-bolo), una dose inserita manualmente o una somministrata esternamente (ad es. una penna per iniezione)."
          }
        },
        "nb-NO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viser en insulindose, som kan være en liten automatisert dose (supermikrobolus), en manuelt angitt dose eller en dose gitt eksternt (f.eks. med insulinpenn)."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toont een insuline dosis, die een kleine geautomatiseerde dosis kan zijn (super-microbolus), een handmatig ingevoerde dosis of een externe dosis (bijvoorbeeld een penschot)."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokazuje dawkę insuliny, która może być małą automatyczną dawką (super-mikrobolus), wprowadzoną ręcznie dawką lub dawką podawaną zewnętrznie (np. strzałką wstrzykiwacza)."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra uma dose de insulina, que pode ser uma pequena dose automatizada (supermicro-bolus), uma dose inserida manualmente, ou uma fornecida externamente, por exemplo, uma tira de caneta)."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Показывает инсулин дозы, которая может быть небольшой автоматизированной дозой (супермикроболом), введенной вручную дозировкой или той, которая указана внешне (например, пероральный выстрел)."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Shows an insulin dose, which can be a small automated dose (super-micro-bolus), a manually entered dose, or one given externally (e.g., a pen shot)."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visar en insulin dos, som kan vara en liten automatiserad dos (super-micro-bolus), en manuellt inmatad dos, eller en angiven externt (t.ex. en penna skott)."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Shows an insulin dose, which can be a small automated dose (super-micro-bolus), a manually entered dose, or one given externally (e.g., a pen shot)."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Показує дозу інсуліну, яку може бути невеликою автоматизованою дозою (супер-мікроболус), введеною вручну чи такою, ззовні (наприклад, постріл з руч)."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Shows an insulin dose, which can be a small automated dose (super-micro-bolus), a manually entered dose, or one given externally (e.g., a pen shot)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "显示一种绝缘剂量，这种剂量可以是小自动化剂量(超级微波)、手工输入的剂量或外部给定的剂量(例如钢笔)。"
          }
        }
      }
    },
    "Shows current or past TBRs, which can be set by the oref algorithm or manually." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يعرض الحالي أو الماضي TBR، الذي يمكن تعيينه بواسطة خوارزمية الـ oref أو يدويا."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viser aktuelle eller tidligere TBR'er, som kan indstilles ved oref algoritme eller manuelt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeigt aktuelle oder vergangene TBRs, die durch den Oref-Algorithmus oder manuell eingestellt werden können."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muestra los TBR actuales o pasados, que pueden ser definidos por el algoritmo de oref o manualmente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Montre les TBRs actuels ou passés, qui peuvent être définis par l'algorithme du oreille ou manuellement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra TBR attuali o passati, che possono essere impostati dall'algoritmo dell'oref o manualmente."
          }
        },
        "nb-NO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viser gjeldende eller tidligere midlertidig basal, som kan settes av Oref-algoritmen eller manuelt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toont huidige of voorbij TBRs, welke kunnen worden ingesteld door het oef-algoritme of handmatig."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokazuje bieżące lub przeszłe TBR, które mogą być ustawione przez algorytm oref lub ręcznie."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra as TBs atuais ou passadas, que podem ser definidas pelo algoritmo do oref ou manualmente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Показывает текущие или прошлые TBR, которые могут быть установлены алгоритмом ручной работы или вручную."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Shows current or past TBRs, which can be set by the oref algorithm or manually."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visar aktuella eller tidigare TBRs som kan ställas in av oref algoritmen eller manuellt."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Shows current or past TBRs, which can be set by the oref algorithm or manually."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Показує поточний або минулий TBR, який може бути встановлений алгоритмом руди або вручну."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Shows current or past TBRs, which can be set by the oref algorithm or manually."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "显示当前或过去的 TBR，可以由矿石算法或手动设定。"
          }
        }
      }
    },
    "Shows the COB value calculated by the algorithm at a specific time in the past. These values are snapshots and won’t change if carbs are added or removed after the fact." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يعرض قيمة COB محسوبة بواسطة الخوارزمية في وقت محدد في الماضي. هذه القيم هي لقطات و لن تتغير إذا تمت إضافة أو إزالة السحر بعد الحقيقة."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viser COB værdien beregnet af algoritmen på et bestemt tidspunkt i fortiden. Disse værdier er snapshots og vil ikke ændres, hvis kulhydrater tilføjes eller fjernes efter faktum."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeigt den COB-Wert, der vom Algorithmus zu einem bestimmten Zeitpunkt in der Vergangenheit berechnet wird. Diese Werte sind Snapshots und werden sich nicht ändern, wenn Kohlenhydrate hinzugefügt oder entfernt werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muestra el valor COB calculado por el algoritmo en un momento específico en el pasado. Estos valores son instantáneas y no cambiarán si los glúcidos se añaden o eliminan después del hecho."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Affiche la valeur COB calculée par l'algorithme à une heure spécifique dans le passé. Ces valeurs sont des instantanés et ne changeront pas si des glucides sont ajoutés ou retirés après le fait."
          }
        },
        "it" : {
