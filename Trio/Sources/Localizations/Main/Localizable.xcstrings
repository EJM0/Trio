          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Цей параметр визначає, скільки ваги надає вашому останньому щоденному інсуліну під час обчислення Dynamic ISF і Динамічного CR."
          }
        },
        "vi" : {
