          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varning: Att öka detta värde över 90 minuter kan påverka Trios förmåga att effektivt stänga av basalen i tid och förhindra låga glukosvärden."
          }
        },
        "tr" : {
          "stringUnit" : {
