        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vermindering van deze instelling kan leiden tot meer FPU ingangen met kleinere koolhydraten waarden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zmniejszenie tego ustawienia może skutkować zwiększeniem liczby wpisów FPU z mniejszymi wartościami węglowodanów."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Engolir essa configuração pode resultar em mais entradas FPU com valores de carb menores."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Уменьшение этого параметра может привести к большему количеству FPU записей с меньшими значениями карбов."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Decreasing this setting may result in more FPU entries with smaller carb values."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minskning av denna inställning kan resultera i fler FPU-poster med mindre kolhydratvärden."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Decreasing this setting may result in more FPU entries with smaller carb values."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Зменшення цього параметра може призвести до збільшення FPU записів з меншими значеннями для інтернету."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Decreasing this setting may result in more FPU entries with smaller carb values."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "减小此设置可能会导致更多具有较小卡车值的FPU条目。"
          }
        }
      }
    },
