    "Basal profile covers 24 hours. You cannot add more rates. Please remove or adjust existing rates to make space." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الملف الشخصي الأساسي يغطي 24 ساعة. لا يمكنك إضافة المزيد من المعدلات. الرجاء إزالة أو ضبط المعدلات الحالية لإنشاء المساحة."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Basal profil dækker 24 timer. Du kan ikke tilføje flere priser. Fjern eller juster eksisterende priser for at gøre plads."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Basalprofil umfasst 24 Stunden. Sie können nicht mehr Tarife hinzufügen. Bitte entferne oder ändere die bestehenden Tarife, um Platz zu schaffen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El perfil basal cubre 24 horas. No puede añadir más tasas. Por favor, elimine o ajuste las tarifas existentes para hacer espacio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le profil Basal couvre 24 heures. Vous ne pouvez pas ajouter plus de taux. Veuillez supprimer ou ajuster les tarifs existants pour faire de l'espace."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il profilo basale copre 24 ore. Non è possibile aggiungere più tasse. Si prega di rimuovere o modificare le tariffe esistenti per fare spazio."
          }
        },
        "nb-NO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Basalprofilen dekker allerede 24 timer. Du kan ikke legge til flere rater. Vennligst fjern eller juster eksisterende rater for å lage plass."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Basaal profiel heeft 24 uur. Je kunt niet meer tarieven toevoegen. Verwijder of pas bestaande tarieven aan om ruimte te maken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Profil bazy obejmuje 24 godziny. Nie można dodać więcej stawek. Proszę usunąć lub dostosować istniejące stawki, aby zrobić miejsce."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O perfil Basal abrange 24 horas. Você não pode adicionar mais taxas. Remova ou ajuste as taxas existentes para liberar espaço."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Базальный профиль охватывает 24 часа. Вы не можете добавить дополнительные тарифы. Пожалуйста, удалите или измените существующие тарифы, чтобы освободить место."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Basal profile covers 24 hours. You cannot add more rates. Please remove or adjust existing rates to make space."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Basal profil täcker 24 timmar. Du kan inte lägga till fler priser. Ta bort eller justera befintliga priser för att göra utrymme."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Basal profile covers 24 hours. You cannot add more rates. Please remove or adjust existing rates to make space."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Основний профіль охоплює 24 години. Ви не можете додати більше ставок. Будь ласка, видаліть або відрегулюйте тарифи, щоб створити місце."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Basal profile covers 24 hours. You cannot add more rates. Please remove or adjust existing rates to make space."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "基本配置文件覆盖24小时。您不能添加更多的费率。请删除或调整现有费率以腾出空间。"
          }
        }
      }
    },
