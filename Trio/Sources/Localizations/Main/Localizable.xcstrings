    "The Adjustment Factor (AF) allows you to control how quickly and effectively Dynamic ISF responds to changes in glucose levels." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عامل التعديل (AF) يسمح لك بالتحكم في مدى سرعة وفعالية استجابة قوى الأمن الداخلي الديناميكية للتغيرات في مستويات الجلوكوز."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Justeringsfaktoren (AF) giver dig mulighed for at kontrollere, hvor hurtigt og effektivt Dynamic ISF reagerer på ændringer i glukoseniveauet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit dem Anpassungsfaktor (AF) können Sie steuern, wie schnell und effektiv Dynamic ISF auf Veränderungen des Glukosespiegels reagiert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El factor de ajuste (AF) te permite controlar con qué rapidez y eficacia responde el ISF dinámico a los cambios en los niveles de glucosa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le Facteur d'ajustement (AF) vous permet de contrôler la rapidité et l'efficacité avec lesquelles la FI Dynamique répond aux changements des niveaux de glucose."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il fattore di regolazione (AF) consente di controllare quanto velocemente ed efficacemente Dynamic ISF risponde alle variazioni dei livelli di glucosio."
          }
        },
        "nb-NO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Med justeringsfaktor (AF) kan du kontrollere hvor raskt og effektivt dynamisk ISF svarer på endringer i glukosenivåer."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Met de aanpassingsfactor (AF) kunt u bepalen hoe snel en effectief het dynamische ISF reageert op veranderingen in glucosewaarden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Współczynnik korygujący (AF) umożliwia kontrolowanie, jak szybko i skutecznie dynamiczne ISF reaguje na zmiany poziomu glukozy."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Fator de Ajuste (F) permite controlar com que rapidez e eficácia o ISF dinâmico responde às mudanças nos níveis de glicose."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Коэффициент корректировки (AF) позволяет контролировать то, насколько быстро и эффективно Динамический ISF реагирует на изменения уровней глюкозы."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The Adjustment Factor (AF) allows you to control how quickly and effectively Dynamic ISF responds to changes in glucose levels."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Justeringsfaktorn (AF) gör att du kan styra hur snabbt och effektivt Dynamisk ISF reagerar på förändringar i glukosnivåer."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The Adjustment Factor (AF) allows you to control how quickly and effectively Dynamic ISF responds to changes in glucose levels."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Коефіцієнт регулювання (AF) дозволяє вам контролювати, як швидко і ефективно Динамічний ISF реагує на зміни рівня глюкози."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The Adjustment Factor (AF) allows you to control how quickly and effectively Dynamic ISF responds to changes in glucose levels."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "调整因子 (AF) 允许您控制动态ISF 对葡萄糖水平的变化作出多快和有效的反应。"
          }
        }
      }
    },
