          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果您拥有80%的“推荐数量百分比”和70%的“神奇数量百分比”， 您推荐的体积将乘以(80 × 70) , 100 = 56%。"
