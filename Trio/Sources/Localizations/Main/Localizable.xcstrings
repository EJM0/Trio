            "value" : "This allows Trio to read from and write to Apple Health."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo permette al Trio di leggere e scrivere su Apple Health."
          }
        },
        "nb-NO" : {
          "stringUnit" : {
