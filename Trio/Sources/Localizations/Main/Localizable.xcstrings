            "value" : "This allows Trio to read from and write to Apple Health."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dette gør det muligt Trio at læse fra og skrive til Apple Health."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dies erlaubt Trio von Apple Health zu lesen und zu schreiben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto permite a Trio leer y escribir en Apple Health."
          }
        },
        "fr" : {
