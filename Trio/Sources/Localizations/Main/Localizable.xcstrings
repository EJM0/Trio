      }
    },
    "This setting allows for a more responsive system, but the effects are restricted by the Autosens Min/Max settings." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "This setting allows for a more responsive system, but the effects are restricted by the Autosens Min/Max settings."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne indstilling giver mulighed for et mere responsivt system, men effekterne er begrænset af Autosens Min/Max indstillinger."
