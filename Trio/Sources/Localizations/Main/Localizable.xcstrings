    "Live Activities must be enabled under iOS Settings to allow Trio to display live data." : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Live Activities must be enabled under iOS Settings to allow Trio to display live data."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Live Aktiviteter skal være aktiveret under iOS-indstillinger for at tillade Trio at vise live-data."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Live-Aktivitäten müssen in den iOS-Einstellungen aktiviert sein, damit Trio Live-Daten anzeigen kann."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las actividades en vivo deben estar habilitadas bajo los ajustes de iOS para permitir a Trio mostrar datos en vivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les activités en direct doivent être activées dans les paramètres iOS pour permettre à Trio d'afficher les données en direct."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Live Activities must be enabled under iOS Settings to allow Trio to display live data."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le attività dal vivo devono essere abilitate in Impostazioni iOS per consentire al Trio di visualizzare i dati dal vivo."
          }
        },
        "nb-NO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Direkte aktiviteter må være aktivert under iOS innstillinger for at Trio skal kunne vise live data."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Live activiteiten moeten worden ingeschakeld onder iOS instellingen om de Trio in staat te stellen live data weer te geven."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktywności na żywo muszą być włączone w ustawieniach iOS, aby umożliwić Trio wyświetlanie danych na żywo."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atividades ao vivo devem ser ativadas nas Configurações do iOS para permitir que Trio exiba dados ao vivo."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Live aktiviteter måste aktiveras under iOS-inställningar för att Trio ska kunna visa realtidsdata."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Live Activities must be enabled under iOS Settings to allow Trio to display live data."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Жива діяльність повинна бути включена в параметрах iOS, щоб дозволити племені відображати дані в реальному часі."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "new",
