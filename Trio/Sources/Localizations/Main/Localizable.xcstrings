        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilizza le linee di previsione IOB, COB, UAM, e ZT da OpenAPS. Questa opzione fornisce una visione più dettagliata delle previsioni dell'algoritmo, ma può essere più confusa per alcuni utenti."
          }
        },
        "nb-NO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bruker IOB, COB, UAM, og ZT prognoselinjer fra OpenAPS. Dette alternativet gir en mer detaljert visning av algoritmens prognose, men kan være mer forvirret for enkelte brukere."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gebruikt de IOB, COB, UAM en ZT voorspellingen van OpenAPS. Deze optie biedt een meer gedetailleerde weergave van de algoritme voorspelling, maar kan voor sommige gebruikers verwarrend zijn."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Używa linii prognoz IOB, COB, UAM, i ZT z OpenAPS. Ta opcja zapewnia bardziej szczegółowy widok prognozy algorytmu, ale może być bardziej myląca dla niektórych użytkowników."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa as linhas de previsão IOB, COB, UAM e ZT da OpenAPS. Esta opção fornece uma visão mais detalhada das previsões do algoritmo, mas pode ser mais confusa para alguns usuários."
