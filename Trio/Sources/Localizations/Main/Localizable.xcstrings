        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se a sua taxa basal atual é de 0.8 U/h e \"Porcentagem de Super Bolus\" está definida para 200%: 0. × (200 + 100) = 1,6 unidades serão adicionadas à sua recomendação de bolus."
          }
